# x442 layer — DRAFT, not yet applied by the skill. Everything between the x442 prefix and this
# line is the upstream template, kept verbatim so a re-sync is a plain diff. Everything below is the
# lines setup-project-tooling needs that upstream lacks. Apply the prefix and the block below to a
# repo that already carries its own Unity .gitattributes; never replace that file.
#
# Git LFS is opt-in. Unless the user accepts it, the one upstream line the skill edits is the
# `[attr]lfs` macro above, which becomes `[attr]lfs -diff -merge -text` (see SKILL.md).
# ---------------------------------------------------------------------------------------------

# Shell payloads and git hooks: a CRLF checkout turns `#!/usr/bin/env bash` into `bash\r`.
# Explicit, so relaxing the prefix default cannot break a hook; upstream pins nothing for these.
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
commit-msg text eol=lf
pre-commit text eol=lf
post-commit text eol=lf

# Lockfiles: collapsed in GitHub PR diffs and skipped by `git diff`. Upstream already marks
# Packages/packages-lock.json.
package-lock.json linguist-generated=true -diff
pnpm-lock.yaml linguist-generated=true -diff
yarn.lock linguist-generated=true -diff
bun.lockb binary linguist-generated=true
