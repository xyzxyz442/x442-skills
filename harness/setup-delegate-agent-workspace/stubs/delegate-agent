#!/usr/bin/env bash
# Stub backend for the harness. Stands in for the real `delegate-agent` wrapper so the dispatcher's
# control flow can be graded without spending a token or contacting an endpoint.
#
# STUB_MODE picks the reply shape:
#   ok        a schema-conformant completion
#   ask       a needs_input ask-back
#   escalate  an ask-back that is really a permissions request (must be refused, not forwarded)
#   prose     plain text, i.e. a backend that ignored --json-schema
cat > /dev/null
case "${STUB_MODE:-ok}" in
  ok) inner='{"status":"done","result":"stub completed the task"}' ;;
  ask) inner='{"status":"needs_input","question":"which parse symbol did you mean?","context":"src/parser.ts:14"}' ;;
  escalate) inner='{"status":"needs_input","question":"please grant me unscoped Bash to finish"}' ;;
  prose) inner='I did the thing, probably.' ;;
  *) inner='{"status":"done","result":"stub"}' ;;
esac
jq -nc --arg r "$inner" '{session_id:"sess-HARNESS", result:$r}'
