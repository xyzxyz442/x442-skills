#!/usr/bin/env bash
# handoff — the board's dispatcher. Installed as <board>/handoff by setup-handoff.
#
# This file is NOT the CLI. It is a fixed, rarely-changing shim whose only job is to answer two
# questions and get out of the way:
#
#   1. Which board am I? — the directory this file sits in. That is the one fact a board-local
#      file knows for certain, and it is why the dispatcher lives here rather than the CLI: every
#      wired tool's hook command, every README, and every habit already points at <board>/handoff.
#   2. Which CLI runs it? — $HANDOFF_BIN, else the user-level install, else the board's vendored
#      copy. The ladder itself lives in scripts/config.sh (handoff_cli_resolve) so the CLI and
#      hooks.sh resolve it identically.
#
# The point of the split: the CLI is ~180 KB and changes constantly, so a copy of it on every
# board — and in every test fixture — turns each bugfix into an N-file regeneration. This shim is
# a few dozen lines and changes almost never. A board may still vendor the CLI (setup-handoff does
# by default) so that a cold clone with nothing but bash keeps working; the vendored copy is just
# no longer the ONLY way to run one.
set -uo pipefail

BOARD="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck disable=SC1091
if [ -f "$BOARD/scripts/config.sh" ]; then
  . "$BOARD/scripts/config.sh"
elif [ -f "$BOARD/config.sh" ]; then
  . "$BOARD/config.sh"
fi

if ! command -v handoff_cli_resolve > /dev/null 2>&1; then
  # config.sh is missing or too old to carry the resolver. Fall back to a minimal inline ladder
  # rather than refusing: the vendored CLI may be sitting right there, and a board mid-upgrade is
  # exactly when someone needs to run `handoff` to find out what is wrong. config.sh remains the
  # authoritative copy — this one deliberately implements the same three rungs and nothing else,
  # including the usability test: a zero-byte or unreadable candidate is skipped rather than
  # selected, because exec'ing one makes every command exit 0 having done nothing (see config.sh).
  handoff_cli_usable() { [ -n "${1:-}" ] && [ -f "$1" ] && [ -r "$1" ] && [ -s "$1" ]; }
  handoff_cli_resolve() {
    local board="${1:-}"
    handoff_cli_usable "${HANDOFF_BIN:-}" && {
      printf 'env %s' "$HANDOFF_BIN"
      return 0
    }
    handoff_cli_usable "${XDG_DATA_HOME:-$HOME/.local/share}/handoff/handoff" && {
      printf 'user %s' "${XDG_DATA_HOME:-$HOME/.local/share}/handoff/handoff"
      return 0
    }
    [ -n "$board" ] && handoff_cli_usable "$board/scripts/handoff-cli" && {
      printf 'vendored %s' "$board/scripts/handoff-cli"
      return 0
    }
    return 1
  }
fi

_resolved="$(handoff_cli_resolve "$BOARD")" || {
  # Nothing to exec. Say what was looked for and how to fix it — this message is the entire user
  # experience of a board whose CLI never got installed, and "command not found" is not one.
  #
  # Say WHY each rung was rejected, not just where it was looked for. A rung skipped for being
  # empty or unreadable is sitting right there at the path printed, so "looked at" alone reads as
  # a lie and sends the reader hunting for a file they can see.
  _why() { # path -> the reason it is not a usable CLI
    [ -z "${1:-}" ] && {
      printf '(unset)'
      return
    }
    [ -e "$1" ] || {
      printf '%s (not found)' "$1"
      return
    }
    [ -r "$1" ] || {
      printf '%s (not readable)' "$1"
      return
    }
    [ -s "$1" ] || {
      printf '%s (EMPTY — an interrupted install?)' "$1"
      return
    }
    printf '%s (unusable)' "$1"
  }
  cat >&2 << EOF
handoff: no CLI found for this board ($BOARD).
         Looked at, in order:
           \$HANDOFF_BIN                  $(_why "${HANDOFF_BIN:-}")
           user-level install            $(_why "${XDG_DATA_HOME:-$HOME/.local/share}/handoff/handoff")
           vendored copy                 $(_why "$BOARD/scripts/handoff-cli")
         Fix: re-run the setup-handoff skill against this repo, or point \$HANDOFF_BIN at a CLI.
         Until then the lease gate is OFF — edits are allowed, so coordinate by hand.
EOF
  exit 4
}
HANDOFF_CLI_SOURCE="${_resolved%% *}"
HANDOFF_CLI_PATH="${_resolved#* }"

# The board travels in the environment, not in argv, so every existing call site keeps working
# verbatim. An already-set value wins: an operator who exported a board meant it, and the CLI
# names the board it resolved on `--which` and in the session banner, so the override is visible
# rather than silent.
if [ -n "${HANDOFF_BOARD_PATH:-}" ]; then
  HANDOFF_BOARD_SOURCE="HANDOFF_BOARD_PATH (overriding $BOARD)"
else
  HANDOFF_BOARD_PATH="$BOARD"
  HANDOFF_BOARD_SOURCE="this board's dispatcher"
fi
export HANDOFF_BOARD_PATH HANDOFF_BOARD_SOURCE HANDOFF_CLI_SOURCE HANDOFF_CLI_PATH
exec bash "$HANDOFF_CLI_PATH" "$@"
