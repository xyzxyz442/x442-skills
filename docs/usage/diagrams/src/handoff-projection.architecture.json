  "cards": [
    {
      "dot": "cyan",
      "title": "Levels are cumulative",
      "items": [
        "summary is the default: the title, labels and ## Current state",
        "full adds ## Context and ## Verify; complete adds Decisions, Ruled out and Evidence",
        "Set per tracker entry or per group tracker rule (ADR 0017, ADR 0020)"
      ]
    },
    {
      "dot": "amber",
      "title": "What never leaves",
      "items": [
        "Activity: every checkpoint would rewrite the issue and notify every watcher",
        "The note field, at every level",
        "A sensitivity: restricted doc, or a bundle with a restricted child, is skipped"
      ]
    },
    {
      "dot": "rose",
      "title": "Where each level may go",
      "items": [
        "A private tracker takes any level; complete goes nowhere else",
        "summary or full reach a public tracker only with allowPublic plus share: public (ADR 0013)",
        "complete is refused on a public or unconfirmed tracker, even with allowPublic (ADR 0020)"
      ]
    }
  ]
