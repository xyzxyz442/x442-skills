    },
    {
      "id": "sec-platform",
      "type": "database",
      "label": "Section platform",
      "sublabel": "group acme-infra",
      "pos": [360, 560],
      "size": [190, 64],
      "tag": "sub-index"
    },
    {
      "id": "issues-app",
      "type": "cloud",
      "label": "acme-api, acme-web",
      "sublabel": "issues, by home",
      "pos": [700, 250],
