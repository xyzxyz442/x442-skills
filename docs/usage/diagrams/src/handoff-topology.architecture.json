      "size": [170, 64]
    },
    {
      "id": "bob",
      "type": "frontend",
      "label": "Bob",
      "sublabel": "junior, executes",
      "pos": [40, 400],
      "size": [170, 64]
    },
    {
      "id": "carol",
      "type": "frontend",
      "label": "Carol",
      "sublabel": "platform maintainer",
      "pos": [40, 560],
      "size": [170, 64]
    },
    {
      "id": "sec-app",
      "type": "database",
      "label": "Section app",
