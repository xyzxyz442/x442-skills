      "size": [180, 64]
    },
    {
      "id": "lib-board",
      "type": "database",
      "label": "Library board",
      "sublabel": "shared lib, other owner",
      "pos": [1010, 90],
      "size": [180, 64]
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "acme, one owner, one trust boundary",
      "wraps": [
        "draft",
        "alice",
        "bob",
        "carol",
        "sec-app",
        "sec-platform",
        "issues-app",
        "issues-platform"
      ]
    },
    {
      "kind": "security-group",
      "label": "Dedicated board, private remote",
      "wraps": ["sec-app", "sec-platform"]
    },
    {
      "kind": "region",
      "label": "Other owner, separate trust boundary",
      "wraps": ["lib-board"]
    }
  ],
  "connections": [
    {
      "id": "alice-app",
      "from": "alice",
      "to": "sec-app",
      "label": "claim, review"
    },
    {
      "id": "bob-app",
      "from": "bob",
      "to": "sec-app",
      "label": "for-review",
      "fromSide": "right",
      "toSide": "bottom"
    },
    {
      "id": "carol-platform",
      "from": "carol",
      "to": "sec-platform",
      "label": "claim / release"
    },
    {
      "id": "draft-move",
      "from": "draft",
      "to": "sec-app",
      "label": "handoff move",
      "variant": "dashed",
      "fromSide": "right",
      "toSide": "top"
    },
    {
      "id": "mirror-app",
      "from": "sec-app",
      "to": "issues-app",
      "label": "mirror (tracker rule)"
    },
    {
      "id": "mirror-platform",
      "from": "sec-platform",
      "to": "issues-platform",
      "label": "mirror (tracker rule)"
    },
    {
      "id": "cross-owner",
      "from": "sec-app",
      "to": "lib-board",
      "label": "external blocker, brief",
      "variant": "security",
      "fromSide": "top",
      "toSide": "left"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "A team on one board",
      "items": [
        "Leases keep Alice and Bob apart; the board's remote makes that hold across machines",
        "Bob hands back with --for-review --reviewer alice",
        "Alice's personal board moves work in free, out only by naming the target (ADR 0018)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Groups are sections",
      "items": [
        "Each group has its own section and sub-index; members see only theirs",
        "One tracker rule mirrors every registered member into its own repo",
        "Sections organise work; everyone who can clone the board reads all of it"
      ]
    },
    {
      "dot": "rose",
      "title": "Another trust boundary",
      "items": [
        "A library owned elsewhere keeps its own board and tracker",
        "depends_on cannot cross boards; wait with blocked-on external",
        "move --to-remote only on confirmation; restricted work never crosses"
      ]
    }
  ]
}
