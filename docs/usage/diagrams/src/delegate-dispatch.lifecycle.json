  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "assess four axes first, and recommend, including against delegating",
        "approval records agent, class and allowlist; the dispatch must match",
        "the sub-agent reporting success is a claim; run the done command yourself"
      ]
    },
    {
      "dot": "amber",
      "title": "Ask-backs",
      "items": [
        "status question means it asked instead of guessing",
        "answer from the brief and the code; escalate only if you do not know",
        "a question asking for wider scope is refused, never relayed"
      ]
    },
    {
      "dot": "rose",
      "title": "Refusals",
      "items": [
        "never-delegate path, restricted brief, or a secret going out or coming back",
        "a kind the agent does not serve, or files over 70% of its window",
        "a refusal is a stop; re-brief once within scope, or do the work here"
      ]
    }
  ]
}
