      "from": "refused",
      "to": "assessed",
      "label": "re-brief within scope",
      "variant": "dashed",
      "route": "bottom-channel",
      "fromSide": "bottom",
      "toSide": "bottom"
    },
    {
      "id": "give-up",
      "from": "refused",
      "to": "kept",
