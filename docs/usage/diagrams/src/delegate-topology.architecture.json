  "cards": [
    {
      "dot": "cyan",
      "title": "The roster is a cascade",
      "items": [
        "Agents are defined only in layers no clone can carry",
        "A repo layer narrows; allow intersects, neverDelegate unions",
        "No ancestor file can widen what the machine permits"
      ]
    },
    {
      "dot": "emerald",
      "title": "One dispatch",
      "items": [
        "The hook refuses a raw call that skipped consent",
        "The brief is scanned before it leaves; credentials are stripped from the child env",
        "The result is scanned before it reaches your transcript"
      ]
    },
    {
      "dot": "rose",
      "title": "Party, not distance",
      "items": [
        "Local never leaves; same-party adds no observer; third-party does",
        "Anything unrecognised resolves to third-party",
        "Failover walks the rank on reachability, and re-asks, since approval names the agent"
      ]
    }
  ]
