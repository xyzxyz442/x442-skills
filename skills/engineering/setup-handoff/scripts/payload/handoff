#!/usr/bin/env bash
# Handoff lease manager. See README.md for the protocol.
#
# Ownership lives ONLY in .locks/<id>/ (never mirrored into the docs, so the two
# cannot desync). Durable state lives ONLY in each doc's YAML frontmatter.
# INDEX.md is generated from both and must not be hand-edited.
#
# Portable across macOS (BSD) and Linux (GNU): no `sed -i`, no `date -r`-only,
# frontmatter edits go through awk. Enforcement lives in hooks.sh.
set -uo pipefail

# --- which board? ----------------------------------------------------------------------
# The CLI used to BE the board: `DIR` was `dirname $0`, so wherever the file sat was the board it
# acted on. That made the 180 KB CLI a mandatory per-board artifact — vendored into every install
# and every test fixture, so every bugfix became an N-file regeneration. Board and binary are now
# separate, and this ladder is how they find each other.
#
#   1. $HANDOFF_BOARD_PATH   — explicit. The board's dispatcher sets it to its own directory, so
#                              `<board>/handoff` still means exactly that board. An operator may
#                              also export it to point a repo at another board WITHOUT editing any
#                              committed file, which is the whole reason it exists.
#   2. this file's directory — only when the file itself sits in a board. This is the vendored
#                              install and every board that predates the split: invoking the CLI
#                              inside a board has always meant that board, and it still does.
#   3. the repo's own config — .agents/handoff.local.json, then .agents/handoff.json, each by its
#                              `board`/`boardPath`. The local file is one developer's choice and is
#                              never committed; the other is the team's and is what a cross-repo
#                              install records. This is how a user-level CLI finds a shared board.
#   4. an in-repo board      — <repo>/.agents/handoff/, or ./.agents/handoff/ outside any repo.
#
# RUNG 4 NEVER WALKS UPWARD (ADR 0010). It used to climb to `/`, so a repo with no board config
# that sat anywhere under a workspace holding a board resolved to THAT board — a different trust
# boundary, reached silently. A board outside the repo is found once, at setup (which scans two
# parent levels and asks), and written into config; runtime only reads what setup wrote.
#
# CONFIGURED-BUT-ABSENT IS A HARD ERROR, never a fallback. Rungs 1 and 3 are someone stating where
# the board is; if it is not there, the honest answer is to say so. Silently sliding down to rung 4
# would write leases into a DIFFERENT board than the one the operator named, and nothing about the
# resulting state would look wrong. Nothing here ever creates a board.
_board_looks_real() { [ -f "$1/scripts/config.sh" ] || [ -f "$1/config.sh" ]; }

# `board`/`boardPath` out of the repo scope, read WITHOUT config.sh — config.sh lives on the board,
# and this is the lookup that finds the board. Deliberately the narrowest possible reader: one key,
# no precedence, no legacy shell format (a machine with a KEY=value config predates board/binary
# separation and resolves by rung 2 anyway).
#
# Prints "file<TAB>board" for the first file, highest precedence first, that names a board.
# A bootstrap twin of config.sh's handoff_config_board: this runs before any board — and so any
# config.sh — has been found, so it cannot source the shared reader. Keep the two in step. A file
# that exists but names none falls through: a handoff.local.json holding only a `group` is a
# per-user section choice, not a claim about where the board is.
_board_from_repo_config() { # repo-dir -> prints "config-file<TAB>board path", or nothing
  local repo="$1" f v
  [ -n "$repo" ] || return 0
  for f in "$repo/.agents/handoff.local.json" "$repo/.agents/handoff.json" "$repo/.agents/handoff.config.json"; do
    [ -f "$f" ] || continue
    if command -v python3 > /dev/null 2>&1; then
      v="$(python3 -c 'import json,sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
if isinstance(d, dict):
    v = d.get("board") or d.get("boardPath") or ""
    if isinstance(v, str) and v:
        sys.stdout.write(v)' "$f")"
    else
      v="$(sed -n 's/.*"board\(Path\)\{0,1\}"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\2/p' "$f" | head -1)"
    fi
    [ -n "$v" ] && {
      printf '%s\t%s' "$f" "$v"
      return 0
    }
  done
}

_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_repo_top="$(git rev-parse --show-toplevel 2> /dev/null || true)"
BOARD_SOURCE=""
DIR=""
if [ -n "${HANDOFF_BOARD_PATH:-}" ]; then
  # The dispatcher sets this to its own directory and says so, which is the common case; a value
  # from anywhere else is an operator override and prints as HANDOFF_BOARD_PATH.
  BOARD_SOURCE="${HANDOFF_BOARD_SOURCE:-HANDOFF_BOARD_PATH}"
  DIR="$HANDOFF_BOARD_PATH"
  case "$DIR" in /*) ;; *) DIR="$(cd "${_repo_top:-$PWD}/$DIR" 2> /dev/null && pwd || printf '%s' "$DIR")" ;; esac
  [ -d "$DIR" ] || {
    echo "handoff: HANDOFF_BOARD_PATH points at $DIR, which does not exist." >&2
    echo "         Refusing to fall back to another board — unset it, or create that one with setup-handoff." >&2
    exit 3
  }
elif _board_looks_real "$_self_dir"; then
  BOARD_SOURCE="this CLI's own directory"
  DIR="$_self_dir"
else
  _cfg_board="$(_board_from_repo_config "$_repo_top")"
  if [ -n "$_cfg_board" ]; then
    BOARD_SOURCE="${_cfg_board%%$'\t'*}"
    DIR="${_cfg_board#*$'\t'}"
    case "$DIR" in /*) ;; *) DIR="$(cd "$_repo_top/$DIR" 2> /dev/null && pwd || printf '%s' "$DIR")" ;; esac
    [ -d "$DIR" ] || {
      echo "handoff: this repo's $(basename "$BOARD_SOURCE") points at $DIR, which does not exist." >&2
      echo "         Refusing to fall back to another board — fix $BOARD_SOURCE, or re-run setup-handoff." >&2
      exit 3
    }
  elif _board_looks_real "${_repo_top:-$PWD}/.agents/handoff"; then
    BOARD_SOURCE="in-repo .agents/handoff"
    DIR="$(cd "${_repo_top:-$PWD}/.agents/handoff" && pwd)"
  fi
fi
# ADR 0010 puts handoff.local.json above everything but an explicit override. Rungs 1 and 2 are
# usually NOT explicit: a board's dispatcher exports its own directory as HANDOFF_BOARD_PATH on every
# call, and a vendored CLI answers from where it sits. Both only say "the board this file belongs
# to", which is the team's board — so without this, a developer's local choice was never read on the
# path every hook and every habit uses. An operator's own export (any other source) still wins.
case "$BOARD_SOURCE" in
  "this board's dispatcher" | "this CLI's own directory")
    _local_cfg="$(_board_from_repo_config "$_repo_top")"
    if [ "${_local_cfg%%$'\t'*}" = "$_repo_top/.agents/handoff.local.json" ]; then
      _implied="$BOARD_SOURCE"
      BOARD_SOURCE="$_repo_top/.agents/handoff.local.json (over $_implied)"
      DIR="${_local_cfg#*$'\t'}"
      case "$DIR" in /*) ;; *) DIR="$(cd "$_repo_top/$DIR" 2> /dev/null && pwd || printf '%s' "$DIR")" ;; esac
      [ -d "$DIR" ] || {
        echo "handoff: this repo's handoff.local.json points at $DIR, which does not exist." >&2
        echo "         Refusing to fall back to $_implied — fix $_repo_top/.agents/handoff.local.json." >&2
        exit 3
      }
    fi
    ;;
esac
[ -n "$DIR" ] || {
  echo "handoff: no board found for ${_repo_top:-$PWD}." >&2
  echo "         Looked for: \$HANDOFF_BOARD_PATH, a board around this CLI, .agents/handoff.local.json and .agents/handoff.json here, then .agents/handoff/ here. Nothing above this folder is searched." >&2
  echo "         Fix: run the setup-handoff skill in this repo, or export HANDOFF_BOARD_PATH=<board>." >&2
  exit 3
}
LOCKS="$DIR/.locks"

# Configuration comes from config.sh, the one place precedence is decided:
#   env > repo config.json > board config.json > legacy config > default
# TTL_HOURS used to be read HERE, above the config load, which meant a value set in the board's
# own config file was captured too late to ever apply. Every knob is now read AFTER the load.
#
# Two places this file used to trust a chained `||` to fail closed, and both were wrong for the
# same underlying reason: command substitution swallows the exit status of what ran INSIDE it, so
# whatever wraps the substitution (a bare `.`, or `eval`) reports its OWN status, never the
# callee's.
#   1. Sourcing config.sh: `A 2>/dev/null || B` -- if BOTH are missing, the `.` fails with 127,
#      but there is no `||` comparison that can catch it (there's no B to try in that shape). An
#      explicit if/elif/else checks each candidate on its own instead.
#   2. Loading config: `eval "$(handoff_config_load ...)" || exit 3` -- when the function ITSELF
#      fails (malformed board or repo config.json, or python3 missing while a config.json exists)
#      it prints nothing and returns 3, but `eval` reports the status of evaluating that (empty)
#      string, which is 0 -- so `|| exit 3` never fires and every HC_* stays unset, dying under
#      `set -u`. Fixed by capturing the function's own output into a plain variable first (a plain
#      assignment DOES propagate the command substitution's exit status), branching on THAT, and
#      only then evaluating the captured text.
# shellcheck disable=SC1091
if [ -f "$DIR/scripts/config.sh" ]; then
  . "$DIR/scripts/config.sh"
elif [ -f "$DIR/config.sh" ]; then
  . "$DIR/config.sh"
else
  echo "handoff: config.sh missing from this board — re-run setup-handoff to update it" >&2
  exit 3
fi
REPO_DIR="$(git rev-parse --show-toplevel 2> /dev/null || true)"
_hc_out=""
if _hc_out="$(handoff_config_load "$DIR" "$REPO_DIR")"; then
  eval "$_hc_out"
else
  # handoff_config_load already wrote the reason to stderr -- don't print a second, vaguer one.
  exit 3
fi

TOPOLOGY="$HC_TOPOLOGY"
HANDOFF_GROUPS="${HANDOFF_GROUPS:-$HC_GROUPS}"
HANDOFF_GROUP_LAYOUT="${HANDOFF_GROUP_LAYOUT:-$HC_GROUP_LAYOUT}"
TTL_HOURS="${HANDOFF_TTL_HOURS:-$HC_TTL_HOURS}"
HANDOFF_ENVIRONMENTS="${HANDOFF_ENVIRONMENTS:-$HC_ENVIRONMENTS}"
# Identity: env wins (a one-off override), then the repo's own config, then the board's. A SHARED
# board's config carries no repoName — identity is per-consumer, which is why the repo scope exists.
REPO_NAME="${HANDOFF_REPO:-$HC_REPO_NAME}"
# The host account (ADR 0018): which login this developer must be active as before mirror or
# export --to-issue send anything. Per-developer, from handoff.local.json only (config.sh already
# drops it from every committed layer) — env wins for the same one-off-override reason as HANDLE.
# Empty is the normal state and means the guard asks nothing (host_account_guard, below).
HOST_ACCOUNT="${HANDOFF_HOST_ACCOUNT:-$HC_HOST_ACCOUNT}"
# The developer's own map of OTHER boards on this machine (ADR 0018): a JSON object, from
# handoff.local.json only — config.sh already drops `boards` from every committed layer, same as
# HOST_ACCOUNT above. Read by `external_ref_status` (below) to resolve a recognised cross-board
# wait in `list`. No env override: unlike HOST_ACCOUNT this names no one-off, so there is nothing
# an operator would ever need to override for a single run.
BOARDS_MAP="${HC_BOARDS:-}"
[ -n "$BOARDS_MAP" ] || BOARDS_MAP='{}'

# --- group sections (multi-group / multi-workspace boards) -----------------------------
# LAYOUT is board-global (every consumer of a shared board must agree); GROUP is the calling repo's
# own section, wired per-repo into its hook command as $HANDOFF_GROUP by the cross-repo sync. A
# handoff invocation only ever acts within its own GROUP; only cmd_index's roll-up reads across all
# sections. Both empty => flat board, and every helper returns exactly today's paths.
LAYOUT="${HANDOFF_GROUP_LAYOUT:-}"
BOARD_GROUPS="${HANDOFF_GROUPS:-}"
# --- board git substrate (ADR 0002) ----------------------------------------------------
# The predicates themselves live in config.sh, which `hooks.sh` also sources: the CLI and the edit
# gate must never disagree about whether a board is shared or when a lease lapses. What lives here
# is only the $DIR-bound convenience wrapper and the per-invocation cache — `list` and `index` walk
# every doc on the board and must not pay for a git process each time they ask.
#
# A board with no remote is not a broken shared board. It is the local-only board every existing
# install already is, and it must keep behaving exactly as it did: leases ignored, no network on
# any path, no git process on the read paths.
board_git() { handoff_board_git "$DIR" "$@"; }
board_remote() { handoff_board_remote "$DIR"; }

_LEASES_SHARED=""
leases_shared() {
  if [ -z "$_LEASES_SHARED" ]; then
    if handoff_leases_shared "$DIR"; then _LEASES_SHARED=1; else _LEASES_SHARED=0; fi
  fi
  [ "$_LEASES_SHARED" = 1 ]
}

# `.locks/` is gitignored on a local-only board (ephemeral machine state) and must NOT be on a
# remote-backed one (shared state of record). A stale ignore rule does not fail loudly: it turns
# push-CAS into a no-op, which is mutual exclusion that excludes nobody. Repair it on the claim
# path rather than refusing — a board that just gained a remote would otherwise block every claim
# until someone hand-edited a file, and the correct edit is not in question. Never silently.
ensure_lease_visibility() {
  leases_shared || return 0
  local gi="$DIR/.gitignore" t
  [ -f "$gi" ] || return 0
  grep -qxF '.locks/' "$gi" 2> /dev/null || return 0
  t="$(mktemp)" || return 0
  grep -vxF '.locks/' "$gi" > "$t"
  cat "$t" > "$gi"
  rm -f "$t"
  echo "This board has a remote, so leases are shared state — removed '.locks/' from its .gitignore."
}

slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//'; }

# Guard for every value-taking flag in the subcommand arg loops below. A value that is missing (the
# flag was the last argument) or that itself looks like a flag is never accepted silently: without
# this, `export ID --to --no-claim` sets to="--no-claim" and silently skips the claim. Mirrors
# setup-handoff.sh's guard of the same name and fails hard for the same reason. $2 is the caller's
# "$#" from before this flag's own shift; $3 is the candidate value.
require_value() {
  local flag="$1" argcount="$2" val="$3"
  [ "$argcount" -lt 2 ] && die "$flag needs a value (got nothing — it was the last argument)"
  case "$val" in
    --*) die "$flag needs a value (got the flag \"$val\")" ;;
  esac
}

# The counterpart to require_value: an argument the command does not recognize.
#
# Four commands used to absorb one. `new` and `import` discarded it, so a typo'd `--severity`
# created a doc with defaults and printed the ordinary success line — the misrouting was only
# discoverable by reading the frontmatter back. `release` and `claim` folded it into the trailing
# note, so the literal flag landed in the Activity log. In both shapes a mistyped flag was not an
# error but data loss that exited 0.
#
# It keys on the leading `--`, NOT on "unrecognized", because `claim <id> [note]` and
# `release <id> ... [note]` document a trailing bare-word note that must keep working. The optional
# hint exists for exactly those two: `new` HAS a --note flag, so the same habit typed at release
# behaves differently, and the message is the only place that can say so.
reject_unknown_flag() { # arg [hint]
  case "$1" in
    --*) die "unknown flag: $1${2:+ ($2)}" ;;
  esac
}

# An EXISTING file or directory's absolute path, via `cd && pwd` (portable — no `realpath` on
# stock macOS). A relative path is only ever meaningful next to the cwd it was typed in; stamping
# one into a doc's frontmatter records a pointer that resolves differently — or not at all — once
# the reader's cwd is different, which is exactly what happened to `export`'s `--out`.
abs_path() { # path -> absolute path
  local p="$1"
  if [ -d "$p" ]; then
    (cd "$p" && pwd)
  else
    printf '%s/%s' "$(cd "$(dirname "$p")" && pwd)" "$(basename "$p")"
  fi
}

# --- repo identity ----------------------------------------------------------------------
# A brief names file:line locations, and those paths plausibly exist in a DIFFERENT repo where they
# mean something else. Identity therefore travels inside the brief and is checked on both sides.
#
# The root commit is the key rather than the remote URL: it survives renames, remote moves, and
# mirror pushes, and a fork matching it is the correct answer because a fork is the same lineage.
repo_root_commit() { # [dir] -> sha of the first commit, or "" outside a git repo
  git -C "${1:-${REPO_DIR:-.}}" rev-list --max-parents=0 HEAD 2> /dev/null | tail -1
}

# Normalize a remote URL to bare host/owner/repo. This is a CORRECTNESS requirement, not cosmetics:
# the SSH form "git@github.com:acme/acme-api.git" carries a ":" that would break the brief's
# frontmatter under the board's no-colon rule. Strips scheme, embedded credentials, the ":" that
# separates host from path in the SSH form, the ".git" suffix, and any trailing slash.
# Known limitation: an https URL carrying an explicit port renders as host/port/owner/repo. Ports
# on git remotes are rare enough that special-casing them would cost more than it buys.
repo_origin_norm() { # url -> host/owner/repo
  printf '%s' "$1" | sed \
    -e 's#^[a-zA-Z+][a-zA-Z0-9+.-]*://##' \
    -e 's#^[^/@]*@##' \
    -e 's#:#/#' \
    -e 's#\.git$##' \
    -e 's#/*$##'
}

# Classify a normalized origin by its git host. The brief shows a PROVIDER rather than a host
# because the host is a deployment detail — a repo that moves from github.com to an enterprise
# install is still the same repo, and `repo_root_commit` is what actually proves identity.
# "other" covers self-hosted git and any provider not listed here.
repo_provider_of() { # host/owner/repo -> github|gitlab|bitbucket|other|unknown
  case "${1%%/*}" in
    "") printf 'unknown' ;;
    github.com) printf 'github' ;;
    gitlab.com) printf 'gitlab' ;;
    bitbucket.org) printf 'bitbucket' ;;
    *) printf 'other' ;;
  esac
}

# The repo path shown beside the provider. A recognized public host is implied by the provider, so
# it is dropped. An unrecognized host is KEPT: "acme/api on other" would not let a reader confirm
# which repo they are standing in, and confirming exactly that is the whole job of the line.
repo_path_of() { # host/owner/repo -> owner/repo, or the full string when the provider is "other"
  case "$(repo_provider_of "$1")" in
    other) printf '%s' "$1" ;;
    *) printf '%s' "${1#*/}" ;;
  esac
}

# Briefs live beside the section's archive, so a grouped board keeps each section's briefs separate.
# briefs_dir forwards "$@" (rather than re-expanding "${1:-...}") because sec_dir deliberately uses
# `${1-$GROUP}` (bare -, not :-): an explicit empty string means the flat board, while omission means
# the caller's own section. Re-expanding here would pass an explicit "" and collapse that distinction.
briefs_dir() { printf '%s/briefs' "$(sec_dir "$@")"; }

GROUP="${HANDOFF_GROUP:-$HC_GROUP}"
[ -n "$GROUP" ] && GROUP="$(slug "$GROUP")"
grouped() { [ -n "$LAYOUT" ] && [ -n "$GROUP" ]; } # is this invocation acting inside a group section?

# All section-relative paths derive from (LAYOUT, group). Pass an explicit group for the roll-up;
# omit it and they use the caller's own GROUP. `${1-$GROUP}` (bare -, not :-) so an explicit "" means
# the flat board, while omission means "the caller's section".
sec_dir() { # [group] -> dir holding that section's locks/archive/sub-index (subfolder only nests)
  local g="${1-$GROUP}"
  if [ "$LAYOUT" = "subfolder" ] && [ -n "$g" ]; then printf '%s' "$DIR/$g"; else printf '%s' "$DIR"; fi
}
doc_file() { # id [group] -> active doc path
  local id="$1" g="${2-$GROUP}"
  case "$LAYOUT" in
    subfolder) [ -n "$g" ] && {
      printf '%s' "$DIR/$g/$id.md"
      return
    } ;;
    prefix) [ -n "$g" ] && {
      printf '%s' "$DIR/$g--$id.md"
      return
    } ;;
  esac
  printf '%s' "$DIR/$id.md"
}
arch_file() { # id [group] -> archived doc path
  local id="$1" g="${2-$GROUP}"
  case "$LAYOUT" in
    subfolder) [ -n "$g" ] && {
      printf '%s' "$DIR/$g/archive/$id.md"
      return
    } ;;
    prefix) [ -n "$g" ] && {
      printf '%s' "$DIR/archive/$g--$id.md"
      return
    } ;;
  esac
  printf '%s' "$DIR/archive/$id.md"
}
sec_index() { # [group] -> sub-index path (roll-up lives at $DIR/INDEX.md when grouped)
  local g="${1-$GROUP}"
  case "$LAYOUT" in
    subfolder) [ -n "$g" ] && {
      printf '%s' "$DIR/$g/INDEX.md"
      return
    } ;;
    prefix) [ -n "$g" ] && {
      printf '%s' "$DIR/INDEX-$g.md"
      return
    } ;;
  esac
  printf '%s' "$DIR/INDEX.md"
}
# Where a section records its tracker drift (ADR 0014). Same shape as the sub-index, and it lives
# beside it for the same reason: a section's generated state belongs with that section's documents.
# `*-handoff.md` is what each_doc globs, so this name can never be read back as a document.
drift_file() { # [group] -> TRACKER-DRIFT.md path for that section
  local g="${1-$GROUP}"
  case "$LAYOUT" in
    subfolder) [ -n "$g" ] && {
      printf '%s' "$DIR/$g/TRACKER-DRIFT.md"
      return
    } ;;
    prefix) [ -n "$g" ] && {
      printf '%s' "$DIR/TRACKER-DRIFT-$g.md"
      return
    } ;;
  esac
  printf '%s' "$DIR/TRACKER-DRIFT.md"
}
# Emit the active (or archived) doc paths for a section, one per line, so callers iterate with
# `while read … done < <(each_doc)` — process substitution keeps the loop body in the current shell
# (accumulators persist) and stays safe with spaces in $DIR, unlike a command-substituted glob.
each_doc() { # [group] -> active doc paths
  local g="${1-$GROUP}" f
  case "$LAYOUT" in
    subfolder) if [ -n "$g" ]; then
      for f in "$DIR/$g"/*-handoff.md; do [ -f "$f" ] && printf '%s\n' "$f"; done
      return
    fi ;;
    prefix) if [ -n "$g" ]; then
      for f in "$DIR/$g"--*-handoff.md; do [ -f "$f" ] && printf '%s\n' "$f"; done
      return
    fi ;;
  esac
  for f in "$DIR"/*-handoff.md; do [ -f "$f" ] && printf '%s\n' "$f"; done
}
each_archive() { # [group] -> archived doc paths
  local g="${1-$GROUP}" f
  case "$LAYOUT" in
    subfolder) if [ -n "$g" ]; then
      for f in "$DIR/$g"/archive/*-handoff.md; do [ -f "$f" ] && printf '%s\n' "$f"; done
      return
    fi ;;
    prefix) if [ -n "$g" ]; then
      for f in "$DIR"/archive/"$g"--*-handoff.md; do [ -f "$f" ] && printf '%s\n' "$f"; done
      return
    fi ;;
  esac
  for f in "$DIR"/archive/*-handoff.md; do [ -f "$f" ] && printf '%s\n' "$f"; done
}
# The groups a shared board hosts (config GROUPS), newline-separated; empty on a flat board.
each_group() {
  local g
  local IFS=','
  for g in $BOARD_GROUPS; do
    g="$(slug "$g")"
    [ -n "$g" ] && printf '%s\n' "$g"
  done
}
# The board hosts groups (config GROUPS + a layout) — distinct from grouped(), which asks whether
# THIS invocation is acting inside a section. Lives here beside the other section helpers because
# three call sites now need it (cmd_list's scope notice, no_such's cross-section lookup, cmd_index's
# roll-up branch), the earliest of them ~600 lines before where it used to be defined.
board_is_grouped() { [ -n "$LAYOUT" ] && [ -n "$BOARD_GROUPS" ]; }
# The lock key for an id = its doc's file stem, so it is unique board-wide: subfolder namespaces via
# the section's own .locks dir (plain stem), prefix bakes the group into the stem. Locks live in the
# section dir so a repo only reaps/nags its own section's leases.
LOCKS="$(sec_dir)/.locks"
lock_key() { basename "$(doc_file "$1")" .md; }

die() {
  echo "handoff: $*" >&2
  exit 1
}
now() { date +%s; }
# BSD `date -r <epoch>` vs GNU `date -d @<epoch>` — try both, fall back to the raw epoch.
human() { date -r "$1" '+%Y-%m-%d %H:%M' 2> /dev/null || date -d "@$1" '+%Y-%m-%d %H:%M' 2> /dev/null || echo "$1"; }
today() { date '+%Y-%m-%d'; }

# Raw session id — the SAME value the tool puts in its hook payload's session_id.
# hooks.sh matches session= against that payload, so this MUST be the raw id, not
# the human-readable owner string. Empty when no tool exposes one (advisory mode).
session_id() { printf '%s' "${HANDOFF_SESSION_ID:-${CLAUDE_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}"; }

# Human-readable claimant, for display and the Activity log.
whoami_id() {
  local user session
  user="$(git config user.name 2> /dev/null || echo "${USER:-agent}")"
  session="$(session_id)"
  session="${session:-$$}"
  echo "${user} (${session:0:8})"
}

# Board ids that CONTAIN the one asked for. The automatic `-handoff` suffix means a "short" id can
# fold to a phantom (`foo` -> `foo-handoff`) while the real doc is `foo-backend-handoff`, so naming
# the near misses turns a dead end into an obvious fix. Comma-separated; empty when nothing is near.
near_ids() { # id -> "a-handoff, b-handoff"
  local needle="${1%-handoff}" p stem out=""
  [ -n "$needle" ] || return 0
  while read -r p; do
    stem="$(basename "$p" .md)"
    case "$stem" in *"$needle"*) out="${out:+$out, }$stem" ;; esac
  done < <(
    each_doc
    each_archive
  )
  printf '%s' "$out"
}

doc_of() { # id -> path, searching the caller's section (active then archive)
  # Reports failure through the EXIT STATUS, never `die`. Every caller runs this inside $( ), where
  # `die`'s exit would leave only the subshell; with no `set -e` (see the top of this file) the
  # caller then sails on with an empty path. That is exactly how `claim <phantom-id>` used to mint a
  # real lock for a doc that does not exist and spray `sed: : No such file or directory`.
  # Callers MUST `|| no_such "$id"`.
  local id="$1" p
  for p in "$(doc_file "$id")" "$(arch_file "$id")"; do
    [ -f "$p" ] && {
      echo "$p"
      return 0
    }
  done
  return 1
}

# The board sections OTHER than the caller's whose section holds this id (active or archived), as a
# comma list. Empty on a flat board, and empty when nothing anywhere holds it. Every lookup in this
# script is confined to the caller's section, so this is the only thing that can tell "does not
# exist" apart from "exists, but you cannot see it".
sections_with_doc() { # id -> "auth, infra"
  local id="$1" g out=""
  board_is_grouped || return 0
  while read -r g; do
    [ -n "$g" ] || continue
    [ "$g" = "$GROUP" ] && continue
    { [ -f "$(doc_file "$id" "$g")" ] || [ -f "$(arch_file "$id" "$g")" ]; } && out="${out:+$out, }$g"
  done < <(each_group)
  printf '%s' "$out"
}

no_such() { # id -> never returns; the shared unresolvable-id error for claim/release
  local near other scope
  # On a grouped board the id may be perfectly real and simply live in a section this invocation
  # cannot see — HANDOFF_GROUP selects one section and nothing looks outside it. "no such handoff"
  # is then actively wrong (the doc exists), and its advice makes it worse: it sends the reader to
  # `list`, which is empty for the very same reason. Name the section that actually holds it.
  other="$(sections_with_doc "$1")"
  if [ -n "$other" ]; then
    if [ -n "$GROUP" ]; then scope="your section is $GROUP"; else scope="you have no HANDOFF_GROUP set"; fi
    die "$1 is on this board, in the $other section — but $scope. Re-run as: HANDOFF_GROUP=${other%%,*} handoff ..."
  fi
  near="$(near_ids "$1")"
  die "no such handoff: $1 (try: handoff list)${near:+ — did you mean: $near}"
}

# One SURROUNDING quote pair is stripped, because a value that must survive as YAML has to be
# quoted and every consumer here wants the bare text. `verify:` is the field that forces this: it
# holds a shell command, so it always contains a ':' and — unlike every other field — cannot be
# colon-folded without corrupting the command, leaving quoting as the only way to keep the doc
# parseable. Without the strip, an author quoting it correctly gets `eval "\"cmd\""` → "command not
# found", i.e. the two requirements (valid YAML / runnable command) were mutually exclusive.
# The `t` branches after a successful double-quote strip so `"'x'"` loses one pair, not both.
# Unquoted values pass through untouched, so docs written before this keep working.
meta() { # path key -> value from YAML frontmatter, minus one surrounding quote pair
  sed -n '2,/^---$/p' "$1" | sed -n "s/^$2:[[:space:]]*//p" | head -1 \
    | sed -e 's/^"\(.*\)"$/\1/;t' -e "s/^'\(.*\)'\$/\1/"
}

# Extract one "## Heading" section's body from a doc, heading excluded. Used to lift Context /
# Where / Verify / Decisions out of a board doc and into a brief. Blank leading and trailing lines
# are trimmed so the rendered brief has no ragged gaps between sections.
doc_section() { # path heading -> body lines
  awk -v h="## $2" '
    $0 == h { inside = 1; next }
    inside && /^## / { inside = 0 }
    inside { print }
  ' "$1" | awk '
    { line[NR] = $0 }
    END {
      first = 1; last = NR
      while (first <= NR && line[first] ~ /^[[:space:]]*$/) first++
      while (last >= first && line[last] ~ /^[[:space:]]*$/) last--
      for (i = first; i <= last; i++) print line[i]
    }
  '
}

# Extract the spliced Result block from a doc (or a brief), bounded by the same marker pair
# splice_result writes. Shared by import_result (reading the RETURNED brief's Result) and
# cmd_release's copied-evidence check (reading the DOC's spliced Result) so both scan exactly the
# text an executor actually reported — never frontmatter or the rest of the doc.
result_block() { # path -> lines between the handoff:result markers
  awk '
    /<!-- handoff:result:begin -->/ { inside = 1; next }
    /<!-- handoff:result:end -->/   { inside = 0 }
    inside { print }
  ' "$1"
}

# Update a frontmatter key in place, or insert it before the closing --- if absent.
# Portable (awk), unlike GNU-only `sed -i 's/a/&\nb/'`.
#
# VALUE IS ROUTED THROUGH A FILE, never through `awk -v`. POSIX awk interprets C-style backslash
# escapes (`\n`, `\072`, ...) in a -v-assigned value, so a value this CLI did not author itself —
# e.g. `result_by`/`result_at` from a returned brief, in `import_result` — could carry a literal
# `\n` and `\072` that `fold_colons` never sees (neither is a literal newline or colon in the
# input) and that awk then decodes into a REAL newline and colon, injecting an arbitrary extra
# frontmatter key. This is the chokepoint fix for that bug: every caller goes through here, so
# fixing it here (rather than at each untrusted call site) closes it for good, the same remediation
# `splice_result` already applies to the Result body. getline reads raw bytes and interprets
# nothing. `key` is never attacker-controlled (always a fixed literal from this file), so it can
# stay on `-v`.
set_field() {
  local f="$1" key="$2" val="$3" t vf rc=0
  t="$(mktemp)" || die "mktemp failed"
  vf="$(mktemp)" || die "mktemp failed"
  printf '%s' "$val" > "$vf"
  awk -v k="$key" -v vf="$vf" '
    BEGIN { infm = 0; seen = 0; v = ""; getline v < vf; close(vf) }
    NR == 1 && $0 == "---" { infm = 1; print; next }
    infm && $0 == "---" { if (!seen) print k": "v; infm = 0; print; next }
    infm && $0 ~ "^"k":" { print k": "v; seen = 1; next }
    { print }
  ' "$f" > "$t" && cat "$t" > "$f" || rc=1
  # Cleanup runs on BOTH paths. It used to sit after a `|| die`, so a genuine write failure
  # (read-only doc, full disk) exited straight past it and leaked both mktemp files. Reporting the
  # failure and cleaning up after it are not a trade — do both.
  rm -f "$t" "$vf"
  [ "$rc" -eq 0 ] || die "set_field: could not write $key into $f"
}

log_activity() { # path message -> append to the doc's Activity log
  local f="$1" msg="$2"
  # the blank line after the heading is required — without it markdownlint flags every doc
  # (MD022 blanks-around-headings / MD032 blanks-around-lists) the moment the first entry lands
  grep -q '^## Activity' "$f" || printf '\n## Activity\n\n' >> "$f"
  printf -- '- %s — %s\n' "$(today)" "$msg" >> "$f"
}

# `## Ruled out` (ADR 0012): what was tried and failed, one line each, append-only by convention.
# OPTIONAL and not a schema change — a doc written before the template gained the section reads it
# as empty, and this creates it on first use: before Suggested skills when the doc has one, else
# before Activity, else at the end. The line is collapsed to one physical line so the section stays
# one entry per approach.
append_ruled_out() { # path text
  local f="$1" line t
  line="- $(printf '%s' "$2" | tr '\n' ' ' | sed -e 's/^[[:space:]]*-[[:space:]]*//' -e 's/[[:space:]]*$//')"
  t="$(mktemp)"
  awk -v line="$line" '
    function emit_section() { print "## Ruled out"; print ""; print line; print ""; done = 1 }
    # Existing section: hold its blank lines, and place the entry after its last non-blank line.
    # A list directly under a heading or comment needs a blank line first (markdownlint MD032).
    function put() { if (last !~ /^- /) print ""; print line }
    $0 == "## Ruled out" { print; inside = 1; nb = 0; last = $0; next }
    inside && /^## / { put(); print ""; inside = 0; done = 1 }
    inside && /^[[:space:]]*$/ { nb++; next }
    inside { if (last !~ /^- / || $0 !~ /^- /) for (i = 0; i < nb; i++) print ""; nb = 0; print; last = $0; next }
    !done && !seen && ($0 == "## Suggested skills" || $0 == "## Activity") { emit_section(); seen = 1 }
    { print }
    END {
      if (inside) { put(); done = 1 }
      if (!done) { print ""; emit_section() }
    }
  ' "$f" > "$t" && cat "$t" > "$f"
  rm -f "$t"
}

# Bound to this board and this install's TTL default; the rule itself is in config.sh so the edit
# gate applies exactly the same one.
lease_expiry() { # owner-file fallback-expires -> epoch seconds
  handoff_lease_expiry "$DIR" "$1" "${2:-0}" "$TTL_HOURS"
}

lock_state() { # key [locksdir] -> "free" | "held|owner|exp" | "expired|owner|exp"
  local id="$1" d="${2:-$LOCKS}/$1"
  [ -d "$d" ] || {
    echo "free"
    return
  }
  local owner exp
  owner="$(sed -n 's/^owner=//p' "$d/owner" 2> /dev/null || echo unknown)"
  exp="$(sed -n 's/^expires=//p' "$d/owner" 2> /dev/null || echo 0)"
  exp="$(lease_expiry "$d/owner" "${exp:-0}")"
  if [ "$(now)" -ge "${exp:-0}" ]; then echo "expired|$owner|$exp"; else echo "held|$owner|$exp"; fi
}

# Does THIS session hold a LIVE lease on <id>? Ownership is proven by the raw session id the tool
# exposes, never by the display name: two concurrent sessions of one user share a user name, and
# treating those as the same session would walk a bundle export straight into the foreign lease its
# pre-flight exists to catch. When no session id is available at all (advisory mode, no tool)
# nothing can be proven and the answer is no — a false "yes" is the dangerous direction here.
#
# `expired` deliberately answers no as well: an expired lease of one's own is taken over by a normal
# claim, which is what refreshes it. Only a live self-held lease needs the carve-out.
lease_is_mine() { # id -> 0 when this session holds a live lease on it
  local key kind owner exp mine held
  mine="$(session_id)"
  [ -n "$mine" ] || return 1
  key="$(lock_key "$1")"
  IFS='|' read -r kind owner exp <<< "$(lock_state "$key")"
  [ "$kind" = "held" ] || return 1
  held="$(sed -n 's/^session=//p' "$LOCKS/$key/owner" 2> /dev/null)"
  [ -n "$held" ] && [ "$held" = "$mine" ]
}

# Appended to every refusal that `lease_is_mine` drives, and empty whenever a session id exists.
#
# With none exposed, `lease_is_mine` cannot answer yes for ANYONE — including the caller who claimed
# the lease one command ago — so the refusal is not about who holds it but about nothing here being
# able to prove a holder at all. The bare messages do not survive that state: `claim` records
# `session=` empty and `whoami_id` falls back to `$$`, so "held by alice (52170)" names the caller's
# own earlier PROCESS back at them and reads as somebody else's lease. The behaviour is deliberate
# (a false yes is the dangerous direction, see above); being unable to tell why it fired is not.
advisory_hint() { # -> one sentence when no session id is exposed, empty otherwise
  [ -n "$(session_id)" ] && return 0
  printf '%s' " No session id is exposed here, so ownership cannot be proven for anyone and this would refuse whoever ran it — the owner shown may well be your own earlier process. Set HANDOFF_SESSION_ID to a value that is stable for this terminal, then re-claim."
}

is_archived() { [ -f "$(arch_file "$1")" ]; }

# Handoff type. "standalone" = a self-contained reference/knowledge doc: gate-exempt (no lease
# needed to edit) and not surfaced as claimable work. "coordination" (the default, and what an
# absent `type:` means) = a lease-gated work item. Keep the absence⇒coordination rule so legacy
# docs and existing boards behave exactly as before.
doc_type() {
  local t
  t="$(meta "$1" type)"
  printf '%s' "${t:-coordination}"
}
# --- document schema (ADR 0004) --------------------------------------------------------
# `environment` is an OPEN string, not an enum: every fleet names its stages differently, and a
# closed list would either be wrong somewhere or grow forever. What IS normalized is the handful of
# spellings that mean the same stage everywhere, so `prd`, `production` and `prod` do not read as
# three environments in the index. An absent value means `dev` — the default is what unlabelled
# work has always been, so no existing doc changes meaning by gaining this field.
normalize_env() { # raw -> canonical
  local e
  e="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
  case "$e" in
    '' | dev | develop | development | local) printf 'dev' ;;
    stg | stage | staging | uat | qa | test | testing) printf 'staging' ;;
    prd | prod | production | live) printf 'prod' ;;
    *) printf '%s' "$(slug "$e")" ;;
  esac
}
doc_env() { normalize_env "$(meta "$1" environment)"; }

# The per-board ordered ladder, lowest environment first. It exists so `list` and the index can
# order by how close work is to production rather than alphabetically — `dev, staging, prod` is
# meaningful and `dev, prod, staging` is noise. Anything a board does not name sorts after the
# ladder, in the order encountered.
env_ladder() { printf '%s' "$HANDOFF_ENVIRONMENTS"; }
env_rank() { # env -> integer sort key
  local want="$1" i=0 e
  local -a _ladder=()
  IFS=',' read -r -a _ladder <<< "$(env_ladder)"
  for e in "${_ladder[@]:-}"; do
    i=$((i + 1))
    [ "$(normalize_env "$e")" = "$want" ] && {
      printf '%s' "$i"
      return
    }
  done
  printf '99'
}

# `depends_on` holds BOARD IDS ONLY and means "cannot start before that lands". `blocked_on` stays
# free text for what the board cannot model (`external — …`, `decision — …`). Keeping them apart is
# the whole of ADR 0004: they are written at different moments by different reasoning, and merging
# them would either force free text into a machine-checkable field or discard the cases the board
# genuinely cannot represent.
#
# Reads flow style (`[a, b]`) and block style (`- a`) alike, because meta() only ever sees the
# key's own line and a block list would otherwise read as empty — the same trap repos_of documents.
depends_of() { # path -> newline-separated child ids (canonicalized)
  local f="$1" inline rest
  inline="$(meta "$f" depends_on)"
  # The brackets are QUOTED. `${var#[}` is an unterminated bracket EXPRESSION to bash, not a literal
  # `[`, so it silently strips nothing and every declared dependency reads as empty.
  inline="${inline#"["}"
  inline="${inline%"]"}"
  # `printf '%s\n'`, not `printf '%s'`. Without the trailing newline the final (and on a one-element
  # list, only) field reaches `read` with no line terminator, so `read` sets the variable AND
  # returns non-zero — the loop body never runs, and every single-dependency doc reads as having
  # none. Silent, and in exactly the wrong direction: an unchecked dependency looks like no
  # dependency at all.
  printf '%s\n' "$inline" | tr ',' '\n' | while IFS= read -r one; do
    one="$(printf '%s' "$one" | tr -d '[:space:]')"
    # norm_id prints no newline; without the echo every id after the first is glued onto it.
    [ -n "$one" ] && norm_id "$one" 2> /dev/null && echo
  done
  rest="$(sed -n '/^depends_on:/,/^[a-z_]*:/p' "$f" | sed -n 's/^[[:space:]]*-[[:space:]]*//p')"
  printf '%s\n' "$rest" | while IFS= read -r one; do
    one="$(printf '%s' "$one" | tr -d '[:space:]')"
    # norm_id prints no newline; without the echo every id after the first is glued onto it.
    [ -n "$one" ] && norm_id "$one" 2> /dev/null && echo
  done
}

# A standalone doc's `role` says what it is FOR, where `type` says what its lifecycle is. Absent
# reads as `reference`, which is what every standalone doc written before this field was one.
# --- schema versioning (ADR 0003) ------------------------------------------------------
# TWO numbers, because the documents and the tooling that reads them drift at very different
# rates — and on a shared board they drift PER PERSON. `payload` covers the CLI, templates and
# hooks, and its drift stays a verifier warning saying re-run the installer. `schema` covers the
# DOCUMENT FORMAT and is the only thing that ever triggers a migration. One number would mean a
# routine CLI bugfix prompting a whole-board rewrite for every member of every group.
#
# The compatibility rule is deliberately ASYMMETRIC:
#
#   read forward   — a doc from a newer schema is listed, indexed and shown, with one warning.
#   write backward — refused outright, naming both versions.
#
# Refusing to write is what makes reading safe, and the two are one decision. Warn-and-proceed
# covers reading and says nothing about writing, so an older CLI could read a newer doc, run
# `release` on it, and silently drop every field it did not understand. The brief check at the
# offline-import path dies on an unknown format instead; that is right for a brief (one file, one
# executor, a bad parse means wrong work) and wrong here, where one newer document would take
# `list` down for every member of a shared board.
SCHEMA_VERSION=4

# Absent means schema 0 — every document written before the format was versioned. Not "unknown":
# those docs have a known shape, it is simply the one that predates the stamp.
doc_schema() { # path -> integer
  local v
  v="$(meta "$1" schema)"
  case "$v" in '' | *[!0-9]*) printf '0' ;; *) printf '%s' "$v" ;; esac
}

# Printed at most once per invocation. A board mid-upgrade has many newer docs, and one warning per
# doc turns `list` into a wall of identical text that everybody learns to scroll past.
_SCHEMA_WARNED=0
warn_schema_forward() { # path
  [ "$_SCHEMA_WARNED" = 0 ] || return 0
  local v
  v="$(doc_schema "$1")"
  [ "$v" -gt "$SCHEMA_VERSION" ] || return 0
  _SCHEMA_WARNED=1
  echo "⚠️  $(basename "$1" .md) is schema $v; this CLI understands $SCHEMA_VERSION." >&2
  echo "    Reading it anyway — fields this CLI does not know are shown as-is. To EDIT it, update" >&2
  echo "    the board: re-run setup-handoff, then './handoff migrate'." >&2
}

# The write gate. Every mutating command calls this before touching a doc; nothing else needs to,
# because a read that goes wrong shows stale text and a write that goes wrong destroys data.
require_writable() { # path id
  local v
  v="$(doc_schema "$1")"
  [ "$v" -le "$SCHEMA_VERSION" ] && {
    offer_migration
    offer_locations_move
    return 0
  }
  die "$2 is schema $v and this CLI understands $SCHEMA_VERSION — refusing to write it.
       Editing it here would silently drop every field this CLI does not know about.
       Update the board first: re-run setup-handoff, then './handoff migrate'."
}

# The board's own stamp, which is what `migrate` moves. A board with no stamp is schema 0.
board_schema() {
  local v=""
  if [ -f "$DIR/handoff.json" ] && command -v python3 > /dev/null 2>&1; then
    v="$(python3 -c 'import json,sys
try: d = json.load(open(sys.argv[1]))
except Exception: raise SystemExit(0)
v = d.get("schema")
print(v if isinstance(v, int) else "")' "$DIR/handoff.json" 2> /dev/null)"
  fi
  case "$v" in '' | *[!0-9]*) printf '0' ;; *) printf '%s' "$v" ;; esac
}

# The write gate's blind spot. require_writable compares a doc that ALREADY EXISTS, which covers
# every mutating command except the one that creates the doc: `new` stamps the file with this CLI's
# own SCHEMA_VERSION, so it is writable by construction no matter how far behind the CLI is. On a
# board a teammate has already migrated, that silently files a downlevel document among current
# ones — and nothing downstream can tell it apart from a genuinely old doc awaiting migration, so
# the next `migrate` "upgrades" a file that was written wrong today. Check the BOARD's stamp before
# anything is created. Reads are untouched; this is a write gate like the other one.
require_board_writable() { # what-this-command-would-do
  local v
  v="$(board_schema)"
  [ "$v" -le "$SCHEMA_VERSION" ] && {
    offer_migration
    offer_locations_move
    return 0
  }
  die "this board is schema $v and this CLI understands $SCHEMA_VERSION — refusing to $1.
       The document would be stamped schema $SCHEMA_VERSION on a schema $v board, and no later
       reader could tell it apart from one that predates the migration.
       Update this repo first: re-run setup-handoff, then './handoff migrate'."
}

# ADR 0003, "Migration is offered, never silent" — the OTHER direction of the two gates above. They
# both handle the CLI being BEHIND the thing it is writing, where the answer is to refuse. When the
# BOARD is behind the CLI the write is perfectly safe, which is why nothing refused it — and also
# why nothing ever mentioned it: `migrate` sat there waiting to be typed unprompted, and a board
# nobody migrated took every write without a word. So a write from a human offers.
#
# Three rules shape it, and each one is load-bearing:
#   - it NEVER blocks. Declining, a failed migration, no answer at all — the write the user actually
#     typed proceeds. A board upgrade must never be the reason a claim or a release fails.
#   - it never prompts a hook or CI (`migrate_can_prompt`, the same test `migrate` itself uses).
#     hooks.sh reports the same drift as one line on the session banner; that is the hook's half.
#   - it stays quiet while a lease is held in this section, because `migrate` would refuse in that
#     state (gate 2) — and every `release` is by definition holding one. Prompting for something
#     guaranteed to fail is how an offer trains people to answer no.
#
# It rides the write gates rather than the eight call sites: those gates are, by construction,
# on every write path and on nothing else, so a command added later inherits the offer for free.
_MIGRATE_OFFERED=0
offer_migration() {
  [ "$_MIGRATE_OFFERED" = 0 ] || return 0
  _MIGRATE_OFFERED=1
  # Cheapest test first, and not only for tidiness: `migrate_can_prompt` is two shell builtins,
  # while `board_schema` spawns python3 and `held_leases_in_section` walks every doc. Every
  # scripted write — CI, a grader, a hook that shells out — fails this one and pays nothing for a
  # prompt it was never going to see.
  migrate_can_prompt || return 0
  local v
  v="$(board_schema)"
  [ "$v" -lt "$SCHEMA_VERSION" ] || return 0
  [ -z "$(held_leases_in_section)" ] || return 0

  echo "ℹ️  This board is schema $v; this CLI writes schema $SCHEMA_VERSION. './handoff migrate' brings it current." >&2
  printf 'Migrate the board first? [y/N] ' >&2
  local reply=""
  read -r reply < /dev/tty || reply=""
  case "$reply" in
    y | Y | yes | YES) ;;
    *)
      echo "Not migrating — continuing. Run './handoff migrate' when convenient." >&2
      return 0
      ;;
  esac

  # In a subshell on purpose: `migrate` dies on any of its four gates, and none of them — no git
  # history, a lease taken since, a dirty tree, a rejected push — is a reason to abort the command
  # the user came here to run. The migration's own message says which gate stopped it.
  if ! (cmd_migrate --yes); then
    echo "⚠️  The migration did not run (see above) — continuing without it." >&2
  fi
  return 0
}

# ADR 0010 — the repo-location cache moved from ~/.agents/handoff.json into <board>/.locations.json,
# and an existing map moves only when someone says yes. Same shape as offer_migration above, for the
# same reasons: never blocks, never prompts a hook or CI, asks once per command. It differs in one
# way: this offer RECOMMENDS yes, because unlike a schema migration the move has no precondition
# that can fail and nothing on the board changes but an ignored file. Declining changes nothing, so
# the offer comes back on the next write. `handoff locations --move` does the same thing unprompted.
_LOCATIONS_OFFERED=0
offer_locations_move() {
  [ "$_LOCATIONS_OFFERED" = 0 ] || return 0
  _LOCATIONS_OFFERED=1
  migrate_can_prompt || return 0
  command -v handoff_legacy_locations > /dev/null 2>&1 || return 0
  local n
  n="$(handoff_legacy_locations "$DIR")"
  case "$n" in '' | 0 | *[!0-9]*) return 0 ;; esac
  echo "ℹ️  ~/.agents/handoff.json caches $n checkout location(s) for this board. That cache now lives in the board, as .locations.json (ignored by git)." >&2
  printf 'Move them into the board? Recommended — only these entries leave the user file. [Y/n] ' >&2
  local reply=""
  read -r reply < /dev/tty || reply="n"
  case "$reply" in
    '' | y | Y | yes | YES) ;;
    *)
      echo "Not moving — continuing. They still resolve from ~, and this will be offered again." >&2
      return 0
      ;;
  esac
  cmd_locations --move >&2 || echo "⚠️  The move did not complete (see above) — continuing without it." >&2
  return 0
}

cmd_locations() { # [--move]
  local move=0 n
  while [ $# -gt 0 ]; do
    case "$1" in
      --move) move=1 ;;
      *) die "unknown flag: $1 (usage: handoff locations [--move])" ;;
    esac
    shift
  done
  command -v handoff_legacy_locations > /dev/null 2>&1 \
    || die "this board's scripts/config.sh predates the location move — re-run setup-handoff first."
  if [ "$move" = 0 ]; then
    n="$(handoff_legacy_locations "$DIR")"
    echo "$n legacy location(s) for this board in ~/.agents. Move them with: handoff locations --move"
    return 0
  fi
  n="$(handoff_legacy_locations "$DIR" --move)" || die "could not move the legacy locations."
  handoff_ignore_locations "$DIR"
  echo "Moved $n location(s) into $DIR/.locations.json. The user file was kept; only those entries left it."
}

VALID_ROLES="steering spec reference brief-archive"
doc_role() {
  local r
  r="$(meta "$1" role)"
  printf '%s' "${r:-reference}"
}

is_standalone() { [ "$(doc_type "$1")" = "standalone" ]; }
is_orchestrator() { [ "$(doc_type "$1")" = "orchestrator" ]; }

# An orchestrator tracks a BUNDLE of related handoffs. It holds no work of its own, so like a
# standalone it needs no lease and is gate-exempt; unlike a standalone it is not a reference doc but
# an index whose progress is DERIVED from its children every time it is read. Nothing about child
# status is stored on the orchestrator — a stored count would desync the moment a child closed
# without the parent being updated, which is exactly the rot this doc is meant to prevent.
children_of() { # path -> newline-separated child ids (canonicalized)
  local raw c
  raw="$(meta "$1" children)"
  raw="${raw#[}"
  raw="${raw%]}"
  # Split on commas with IFS rather than `tr ',' '\n' | while read`: that pipeline silently DROPS
  # the last element, because the final field carries no trailing newline and `read` returns
  # non-zero on it, ending the loop before the body runs. A bundle quietly losing its last child is
  # exactly the kind of miscount this doc type exists to prevent.
  local IFS=','
  for c in $raw; do
    c="$(printf '%s' "$c" | tr -d '"[:space:]')"
    [ -n "$c" ] || continue
    resolve_id "$c" || continue
    printf '\n'
  done
}

# The write-side counterpart of children_of: a `--children` CSV in, the canonical comma-joined
# `children:` value out. It exists so the two sides split the list the same way, because they used
# not to:
#
#   * The write side split on WHITESPACE as well as commas (`for c in $(… | tr ',' ' ')`), so a
#     quoted multi-word child id — the spelling the `id` positional argument explicitly supports —
#     silently became several children. `--children 'rbac-gap,RBAC Gap Two'` recorded four ids, two
#     of which named no doc: an inflated progress denominator and permanent MISSING children, so the
#     bundle could never close. Splitting on `,` only (via IFS, scoped to this function) and
#     TRIMMING each element's surrounding whitespace keeps `a,b,c` and `"a, b, c"` equivalent while
#     leaving whitespace inside an element for norm_id to fold into a dash.
#   * The write side canonicalized with norm_id, which slugifies unconditionally, so a legacy dotted
#     id like `sprint-26.7.2-handoff` was recorded as `sprint-26-7-2-handoff`, matched no doc, and
#     reported MISSING for the bundle's whole life. resolve_id — what the read side already used —
#     prefers whichever spelling names a real file and falls back to the canonical slug when neither
#     does, so a child planned but not yet filed still records (and still reports MISSING) as before.
#
# Trimming with a parameter expansion rather than `tr -d '[:space:]'`: the read side can delete all
# whitespace because it only ever sees already-slugged ids, but here the input is what the user typed.
children_csv() { # "a, b, c" -> "a-handoff, b-handoff, c-handoff"; non-zero on an unusable element
  local raw="$1" out="" c
  local IFS=','
  for c in $raw; do
    c="${c#"${c%%[![:space:]]*}"}" # strip leading whitespace
    c="${c%"${c##*[![:space:]]}"}" # strip trailing whitespace
    [ -n "$c" ] || continue
    c="$(resolve_id "$c")" || return 1
    out="${out:+$out, }$c"
  done
  printf '%s' "$out"
}

# "<done>/<total>" plus the ids still outstanding. A child that names no file counts as missing, not
# as done — a typo must never read as progress.
# An outstanding roster is UNBOUNDED, and it is rendered in places that are read constantly: the
# session banner is injected into every agent's context on every session, so a bundle with a large
# roster is a direct token cost levied on unrelated work. One live board carries a bundle declaring
# 100 children of which 97 do not exist — 97 ids reprinted on every session start, forever, for a
# bundle that can never close.
#
# The count is the signal; the names are a sample. `list --verbose` restores the full roster for
# the one moment somebody actually wants it, and the orchestrator's own generated table always
# holds every row, so nothing is lost — it is just not shouted.
ROSTER_LIMIT="${HANDOFF_ROSTER_LIMIT:-5}"
truncate_roster() { # csv [limit] -> "a, b, c, … and N more"
  local csv="$1" limit="${2:-$ROSTER_LIMIT}" n=0 head="" one
  [ -n "$csv" ] || return 0
  local total
  total="$(printf '%s' "$csv" | awk -F', ' '{print NF}')"
  if [ "${total:-0}" -le "$limit" ]; then
    printf '%s' "$csv"
    return 0
  fi
  while [ "$n" -lt "$limit" ]; do
    n=$((n + 1))
    one="$(printf '%s' "$csv" | cut -d',' -f"$n" | sed 's/^ //')"
    head="${head:+$head, }$one"
  done
  printf '%s, … and %s more' "$head" "$((total - limit))"
}

child_progress() { # path -> "done|total|outstanding-csv"
  local total=0 done=0 out="" cf st
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    total=$((total + 1))
    cf=""
    [ -f "$(doc_file "$c")" ] && cf="$(doc_file "$c")"
    [ -z "$cf" ] && [ -f "$(arch_file "$c")" ] && cf="$(arch_file "$c")"
    if [ -z "$cf" ]; then
      out="${out:+$out, }$c (MISSING)"
      continue
    fi
    st="$(meta "$cf" status)"
    if [ "$st" = "done" ]; then done=$((done + 1)); else out="${out:+$out, }$c ($st)"; fi
  done <<< "$(children_of "$1")"
  printf '%s|%s|%s' "$done" "$total" "$out"
}

# The same derivation, rendered as a table INTO the orchestrator doc itself.
#
# `list` and INDEX.md already derive bundle progress, but neither is what a fresh session reads when
# it opens the bundle doc: that session saw `children: [a, b, c]` and prose, and had to open every
# child to learn which one to pick up and who holds it. This closes that gap WITHOUT reintroducing
# the rot the type exists to prevent — the table is GENERATED between markers and rebuilt from the
# children's own frontmatter on every `index`, so it can no more desync than INDEX.md can. Nothing
# here is a stored fact, and a hand-edit inside the markers is overwritten on the next run.
children_table() { # orchestrator-path -> the generated block's body
  local f="$1" c cf link kind owner exp lease bo st
  local prog kdone ktotal out
  prog="$(child_progress "$f")"
  kdone="${prog%%|*}"
  ktotal="$(printf '%s' "$prog" | cut -d'|' -f2)"
  out="${prog#*|*|}"
  if [ "$ktotal" -eq 0 ]; then
    printf 'No children yet. Add them with `./handoff children add %s <child-id>`.\n' "$(basename "$f" .md)"
    return
  fi
  if [ -n "$out" ]; then
    # Truncated here too: the table immediately below carries every child, one row each, so a full
    # roster in the summary line is the same information twice — and it is the copy that gets
    # quoted into banners and briefs.
    printf '**%s/%s done.** Outstanding — %s\n\n' "$kdone" "$ktotal" "$(truncate_roster "$out")"
  else
    printf '**%s/%s done** — every child is closed.\n\n' "$kdone" "$ktotal"
  fi
  printf '| Child | Status | Acts next | Severity | Updated | Blocked on | Lease |\n'
  printf '| --- | --- | --- | --- | --- | --- | --- |\n'
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    cf=""
    link=""
    # The link is built from the basename, not from $DIR, because in all three layouts an active
    # sibling sits beside the orchestrator and an archived one sits under its section's archive/.
    if [ -f "$(doc_file "$c")" ]; then
      cf="$(doc_file "$c")"
      link="./$(basename "$cf")"
    elif [ -f "$(arch_file "$c")" ]; then
      cf="$(arch_file "$c")"
      link="./archive/$(basename "$cf")"
    fi
    if [ -z "$cf" ]; then
      # Planned but not filed. Rendered as a row rather than omitted: a bundle is routinely drafted
      # before its children exist, and the missing row IS the next action.
      printf '| `%s` | `MISSING` | — | — | — | — | not filed yet |\n' "$c"
      continue
    fi
    st="$(meta "$cf" status)"
    lease='—'
    if [ "$st" != "done" ]; then
      IFS='|' read -r kind owner exp <<< "$(lock_state "$(lock_key "$c")")"
      case "$kind" in
        held) lease="🔒 $owner" ;;
        expired) lease="⚠️ stale ($owner) — reclaimable" ;;
      esac
    fi
    bo="$(meta "$cf" blocked_on)"
    [ -n "$bo" ] && is_archived "${bo%% *}" && bo="$bo ✅ resolved"
    # Pipes are stripped from every free-text cell: a title carrying one would shift the whole row
    # and silently misreport the column after it. Empty cells render as an em dash rather than
    # blank, so a missing audience reads as "nobody named" instead of a rendering glitch.
    local title aud sev
    title="$(strip_pipes "$(meta "$cf" title)")"
    aud="$(strip_pipes "$(meta "$cf" audience)")"
    sev="$(strip_pipes "$(meta "$cf" severity)")"
    printf '| [%s](%s) | `%s` | %s | %s | %s | %s | %s |\n' \
      "${title:-$c}" "$link" "$st" "${aud:-—}" "${sev:-—}" \
      "$(meta "$cf" updated)" "$(strip_pipes "${bo:-—}")" "$lease"
  done <<< "$(children_of "$f")"
}

# Rewrite one orchestrator's generated children block in place, adding the section if the doc
# predates it. Writes ONLY when the rendered block differs from what is on disk: `index` runs after
# every mutating command, so an unconditional write would touch every bundle doc on the board on
# every claim anywhere — git churn that says a bundle changed when nothing about it did.
write_children_block() { # orchestrator-path
  local f="$1" t bf
  t="$(mktemp)" || die "mktemp failed"
  bf="$(mktemp)" || die "mktemp failed"
  children_table "$f" > "$bf"
  # The body is routed through a FILE, never `awk -v`: POSIX awk decodes C-style escapes in a
  # -v-assigned value, so a child title carrying a Windows path would be mangled on the way in.
  # Same remediation splice_result and set_field already apply.
  if grep -q '<!-- handoff:children:begin -->' "$f"; then
    awk -v bf="$bf" '
      /<!-- handoff:children:begin -->/ {
        print
        print ""
        while ((getline line < bf) > 0) print line
        close(bf)
        print ""
        skip = 1
        next
      }
      /<!-- handoff:children:end -->/ { skip = 0 }
      !skip { print }
    ' "$f" > "$t"
  else
    # Inserted BEFORE "## Activity" rather than appended, because log_activity appends to the end
    # of the file and would otherwise write its next entry underneath the table, outside its own
    # section. Apostrophes are avoided in the emitted text — the awk program is single-quoted.
    awk -v bf="$bf" '
      function emit(   line) {
        print "## Children"
        print ""
        print "<!-- GENERATED by ./handoff index - do not edit by hand. Rebuilt from the child docs"
        print "     themselves on every index run, so it cannot drift from their real state."
        print "     Change the roster with: ./handoff children add|rm <parent> <child> -->"
        print ""
        # prettier-ignore-start/end: the generated table is UNALIGNED markdown, and a repo that
        # runs prettier over its docs would re-align it on every commit while the next index run
        # un-aligns it again — the file would churn forever on a bundle nobody touched. Same
        # reason INDEX.md is prettier-ignored. Inert in a repo that does not use prettier.
        print "<!-- prettier-ignore-start -->"
        print "<!-- handoff:children:begin -->"
        print ""
        while ((getline line < bf) > 0) print line
        close(bf)
        print ""
        print "<!-- handoff:children:end -->"
        print "<!-- prettier-ignore-end -->"
        print ""
      }
      !placed && /^## Activity/ { emit(); placed = 1 }
      { print }
      END { if (!placed) { print ""; emit() } }
    ' "$f" > "$t"
  fi
  cmp -s "$t" "$f" || cat "$t" > "$f" || die "could not write the children block into $f"
  rm -f "$t" "$bf"
}

# Refresh every orchestrator in the CALLER's section. Deliberately not applied across sections on a
# grouped board: the roll-up is read-only across groups because each section is maintained by its
# own repo, and a bundle's table is that section's generated state, not the board root's.
refresh_children_blocks() {
  local f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    is_orchestrator "$f" || continue
    write_children_block "$f"
  done < <(each_doc)
}

# Every handoff doc file is named "<id>-handoff.md" and the id IS the filename stem. norm_id
# canonicalizes any user-supplied id to that form (idempotent — never doubles the suffix), so
# `new rbac-gap`, `claim rbac-gap`, and `claim rbac-gap-handoff` all resolve to rbac-gap-handoff.
#
# Ids are compared as literal strings everywhere — lease directory names under .locks/, blocked_on
# cross-references, INDEX.md rows, and the hooks' case-sensitive *-handoff.md gate. So the id must
# also be slugified to lowercase kebab-case, or "RBAC Gap" and "rbac-gap" become two leases over
# one doc (and on a case-insensitive filesystem the edit gate silently fails open). Lowercasing
# happens BEFORE the suffix test, so "RBAC-Handoff" yields rbac-handoff, not rbac-handoff-handoff.
# Returns non-zero on an id that slugifies to nothing ("!!!"), so callers can die with usage.
norm_id() {
  local s
  s="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//')"
  [ -n "$s" ] || return 1
  case "$s" in *-handoff) printf '%s' "$s" ;; *) printf '%s-handoff' "$s" ;; esac
}

# The pre-slug spelling of an id: suffix-only canonicalization, no case/separator folding. This is
# what norm_id did before ids were slugified, and it is the only thing legacy_id is for.
legacy_id() { case "$1" in *-handoff) printf '%s' "$1" ;; *) printf '%s-handoff' "$1" ;; esac }

# Free-text frontmatter values land in the doc as unquoted YAML (`key: <value>`), so a ":" inside
# the value turns the line into a nested mapping and breaks every frontmatter parser that reads the
# doc (markdown preview, external tooling). Quoting the value instead would leak literal quotes
# through meta()'s plain-sed readers (list, INDEX, hooks), so the colon is folded to the board's
# em-dash convention: "Handoff: auth suite" → "Handoff — auth suite".
#
# Applied to every frontmatter value that carries arbitrary user text: title (--title on new/import
# and import's H1-derived fallback), note (--note), audience, severity, and the "external: ..."
# blocked_on escape hatch. Not applied to ids/children (norm_id slugifies those) nor to the trailing
# release note, which lands in the body's Activity log where a colon is harmless.
fold_colons() {
  printf '%s' "$1" | sed \
    -e 's/[[:space:]]*:[[:space:]]*/ — /g' \
    -e 's/[[:space:]]\{1,\}/ /g' \
    -e 's/^ //' -e 's/ $//' \
    -e 's/ —$//' -e 's/^— //'
}

# Resolve a user-supplied id to the id an EXISTING doc actually uses. Prefers the canonical slug,
# but falls back to the pre-slug spelling when only that file exists — otherwise slugifying would
# orphan docs on boards installed before this rule (their filenames are not being migrated: a
# rename breaks blocked_on cross-references and git history for a cosmetic gain). Creation never
# calls this — `new`/`import` always slugify, so no new non-conforming file is ever created.
resolve_id() {
  local want raw
  want="$(norm_id "$1")" || return 1
  if [ -f "$(doc_file "$want")" ] || [ -f "$(arch_file "$want")" ]; then
    printf '%s' "$want"
    return
  fi
  raw="$(legacy_id "$1")"
  if [ -f "$(doc_file "$raw")" ] || [ -f "$(arch_file "$raw")" ]; then
    printf '%s' "$raw"
    return
  fi
  printf '%s' "$want" # neither exists — return canonical so doc_of reports it by its proper name
}

# The redaction reminder embedded at the top of every generated doc body. A handoff doc is
# committed to git history, so secrets pasted into it persist. Kept as a function so the coordination
# and standalone fallback templates stay identical.
redaction_comment() {
  echo "<!-- NEVER COMMIT SECRETS. This doc is committed to git history. Redact any keys,"
  echo "     secrets, passwords, confidential data, or PII. If a credential is truly needed,"
  echo "     prompt the user and record its NAME (env var / secret-manager ref), never the value. -->"
}

# --- the secret scanner (ADR 0005) --------------------------------------------------------
# The redaction comment above is a REQUEST. This is the enforcement, and it runs on the CLI's
# WRITE path — create, release, import a result, render an outbound brief — rather than in a
# pre-commit hook. A pre-commit hook has nothing to attach to on a board that is not a repository,
# and that is exactly the board that most needs the check.
#
# Two rules shape every line of it:
#
#   1. It never echoes what it matched. A refusal that prints the credential it caught has put
#      that credential into a terminal, a scrollback, and very likely an agent transcript — which
#      is the harm the check exists to prevent. Refusals name the RULE, never the value.
#   2. It is a chokepoint, not a habit. Every write path calls this one function, so a new rule
#      lands everywhere at once and no path can drift into scanning less than its neighbours.
#   3. It refuses; it never redacts. The secret guard masks a CONFIG FILE because the credential
#      belongs there and the reader only needs the shape. Nothing belongs in a handoff document,
#      so a match here is evidence of a mistake, not content to be spared -- and by the time an
#      outbound brief is rendered the value has been at rest in a file on a shared board. Masking
#      the copy that leaves would hide that from the one person who can rotate it. See ADR 0008.
#
# The patterns are shaped like credentials, not like the word "password": every one of them has a
# vendor prefix or a structural marker, so prose about secrets (which is most of what a security
# handoff contains) passes clean. The two shapeless rules — a quoted assignment and a long random
# base64 run — are the ones that will produce the occasional false positive, which is what
# `--force-secret` is for.
secret_rules() {
  cat << 'RULES'
aws-access-key-id	(AKIA|ASIA)[0-9A-Z]{16}
github-token	gh[pousr]_[A-Za-z0-9]{20,}
github-fine-grained-pat	github_pat_[A-Za-z0-9_]{30,}
gitlab-token	glpat-[A-Za-z0-9_-]{20,}
slack-token	xox[baprs]-[A-Za-z0-9-]{10,}
private-key-block	-----BEGIN [A-Z ]*PRIVATE KEY-----
anthropic-api-key	sk-ant-[A-Za-z0-9_-]{24,}
openai-api-key	sk-(proj-)?[A-Za-z0-9_-]{32,}
google-api-key	AIza[0-9A-Za-z_-]{35}
stripe-secret-key	[sr]k_(live|test)_[A-Za-z0-9]{20,}
npm-token	npm_[A-Za-z0-9]{36}
json-web-token	eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}
quoted-credential-assignment	(password|passwd|secret|token|api[_-]?key)[[:space:]]*[=:][[:space:]]*["'][^"']{12,}["']
RULES
}

# Scan text on stdin. Prints the names of every rule that matched, one per line, and returns 0 when
# something matched — so callers read like `if hits="$(... | scan_secrets)"; then refuse`.
scan_secrets() { # stdin -> matched rule names; 0 = something matched
  local buf hit=1 name re
  buf="$(cat)"
  while IFS="$(printf '\t')" read -r name re; do
    [ -n "$name" ] || continue
    if grep -Eq -- "$re" <<< "$buf"; then
      printf '%s\n' "$name"
      hit=0
    fi
  done <<< "$(secret_rules)"
  return $hit
}

# The one override record, so every write path logs a bypassed scan the same way: which rules fired
# (never the value) and the reason the caller gave. Output is byte-identical to the six inline copies
# this replaced.
log_secret_override() { # doc-path label hits reason
  log_activity "$1" "$2 ($(printf '%s' "$3" | tr '\n' ' ' | sed 's/ $//')) — $(fold_colons "$4")"
}

# The one refusal message, so every write path says the same thing and none of them can drift into
# printing the value. `where` names what was being written, `hits` the rules that fired.
#
# The override is a FLAG WITH A REASON, not a bare bypass: a scanner on the write path will produce
# false positives (see the two shapeless rules above), and the honest answer to that is a recorded
# decision rather than a silent hole. Callers log the reason onto the doc's Activity log.
die_on_secret() { # where hits
  die "$1 looks like it contains a credential — matched: $(printf '%s' "$2" | tr '\n' ' ' | sed 's/ $//').
       Nothing was written. Redact it and re-run, recording the credential's NAME (env var or
       secret-manager reference) rather than its value.
       If this value has already been in a file on this board, redacting it now does NOT remove
       it from that file's history — treat it as disclosed and rotate it.
       If this is a false positive, re-run with: --force-secret \"<why this is safe>\""
}

# --- machine references (ADR 0020) --------------------------------------------------------
# A path under $HOME or $WORKSPACE_ROOT, a local port, a *.local hostname: each resolves on the
# machine that wrote it and means nothing — or means something else — anywhere it is read from. A
# board with a remote (its docs are pushed) and a tracker or brief (off-machine by definition) can
# carry one straight into another developer's session or another organization's issue tracker.
#
# Deliberately a SEPARATE detector from scan_secrets, not a mode of it (ADR 0020's decision): this
# answers a portability question, not a credential one, and it REWRITES rather than refusing — a
# home path costs the owner nothing to lose, so there is no reason to block the write the way a
# credential match does. Two rules rewrite ($HOME -> ~, $WORKSPACE_ROOT -> a literal token);
# everything else is reported but left alone, either because it cannot be rewritten losslessly
# (another user's home, a local port or hostname) or because rewriting it would break a command
# (`verify:`, below). It never fails and never changes the exit status of its caller.
#
# Reports ONE line to stderr naming the rules that fired and how many times, e.g.
# "handoff: machine references — rewrote home-path ×2; flagged local-port ×1 (ADR 0020)" — never
# the matched text, for the same reason scan_secrets never echoes a credential. Silent when
# nothing matched.
#
# Container names are NOT detected here — nothing in this detector recognizes a
# `docker-compose`/Kubernetes service name as a machine reference. Flagged in the ADR review as a
# gap to close later, not attempted here.
machine_refs_filter() { # stdin -> stdout (rewritten); report on stderr; never fails, never blocks
  if ! command -v python3 > /dev/null 2>&1; then
    cat # no interpreter to rewrite with -- pass the text through rather than lose it
    return 0
  fi
  local py
  py="$(mktemp)" || {
    cat
    return 0
  }
  # Written to a FILE, then run as `python3 "$py"` — NOT `python3 - <<'PY' ... PY`. That form
  # reads the PROGRAM itself from stdin, which consumes the very input this filter exists to
  # read: sys.stdin.read() below would see nothing but EOF. A temp file keeps this process's
  # inherited stdin (the caller's piped or redirected text) free for the script to read.
  cat > "$py" << 'PY'
import os, re, sys

text = sys.stdin.read()
home = os.environ.get("HOME", "")
wsroot = os.environ.get("WORKSPACE_ROOT", "")


def valid_root(p):
    # Only an absolute path longer than "/" is a root worth rewriting under -- an unset or
    # relative value would otherwise match everywhere, or nowhere usefully.
    return bool(p) and p.startswith("/") and len(p) > 1


home_ok = valid_root(home)
ws_ok = valid_root(wsroot)

# A rewritten root must be a WHOLE path prefix: followed by "/", whitespace, a quote, a
# backtick, ")" or end of line/string -- never just any character, or "/Users/alice2" would be
# rewritten when HOME is "/Users/alice". Zero-width, so it is never consumed by the match.
BOUND = r"""(?=[/\s'"` )]|$)"""
ws_re = re.compile(re.escape(wsroot) + BOUND) if ws_ok else None
home_re = re.compile(re.escape(home) + BOUND) if home_ok else None
# Warn-only: another user's home directory, a local port, a *.local hostname. Scanned on the
# ALREADY-rewritten line, so the current user's own home (just turned into "~") is never also
# reported here -- what is left really is someone else's.
other_re = re.compile(r"(?:/Users|/home)/[A-Za-z0-9_.-]+(?=/)")
port_re = re.compile(r"\b(?:localhost|127\.0\.0\.1|0\.0\.0\.0):[0-9]{2,5}\b")
local_host_re = re.compile(r"\b[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\.local\b")
verify_re = re.compile(r"^\s*verify\s*:")

counts = {
    "workspace-path": 0,
    "home-path": 0,
    "other-home-path": 0,
    "local-port": 0,
    "local-host": 0,
    "home-path-in-verify": 0,
}

# `verify:` holds a shell command inside the quotes YAML frontmatter forces on it (see meta()) --
# "~" does not expand inside those quotes, so rewriting a home path there would break the
# command. Detected by position (inside the FIRST frontmatter block) and by key name, never
# rewritten, only flagged.
lines = text.split("\n")
out = []
fm_delims = 0
in_fm = False
for line in lines:
    is_verify_line = False
    if line == "---":
        fm_delims += 1
        in_fm = fm_delims == 1
    elif in_fm and verify_re.match(line):
        is_verify_line = True

    if is_verify_line:
        if home_ok and home_re.search(line):
            counts["home-path-in-verify"] += len(home_re.findall(line))
        out.append(line)
        continue

    newline = line
    if ws_ok:
        newline, n = ws_re.subn("$WORKSPACE_ROOT", newline)
        counts["workspace-path"] += n
    if home_ok:
        newline, n = home_re.subn("~", newline)
        counts["home-path"] += n

    counts["other-home-path"] += len(other_re.findall(newline))
    counts["local-port"] += len(port_re.findall(newline))
    counts["local-host"] += len(local_host_re.findall(newline))

    out.append(newline)

sys.stdout.write("\n".join(out))

rewrote = ["%s ×%d" % (n, counts[n]) for n in ("workspace-path", "home-path") if counts[n]]
flagged = [
    "%s ×%d" % (n, counts[n])
    for n in ("other-home-path", "local-port", "local-host", "home-path-in-verify")
    if counts[n]
]
if rewrote or flagged:
    clauses = []
    if rewrote:
        clauses.append("rewrote " + ", ".join(rewrote))
    if flagged:
        clauses.append("flagged " + ", ".join(flagged))
    sys.stderr.write("handoff: machine references — " + "; ".join(clauses) + " (ADR 0020)\n")
PY
  python3 "$py"
  local rc=$?
  rm -f "$py"
  return $rc
}

# Rewrite a file in place when it carries a machine reference; a no-op (byte-identical, silent)
# when it does not. The file-vs-filter split mirrors how callers already hold a path (a board doc)
# or a stream (a rendered mirror body, an exported brief) -- both funnel through the one filter
# above so the rules and the report line can never drift between the two shapes.
machine_refs_file() { # path
  local f="$1" tmp
  tmp="$(mktemp)" || return 0
  machine_refs_filter < "$f" > "$tmp"
  cmp -s "$f" "$tmp" || cat "$tmp" > "$f"
  rm -f "$tmp"
}

# --- sensitivity (ADR 0005) ---------------------------------------------------------------
# `sensitivity` is a HANDLING FLAG, NOT AN ACCESS BOUNDARY. Board membership is the access
# boundary: anyone who can read the board can read every document on it, restricted or not. What
# the flag changes is what the TOOLING will do with a document — refuse to export it, refuse to
# hand it to a delegated agent, and say so at claim time. Nothing here keeps a reader out, and it
# must never be described as if it does.
#
# Absent reads as `normal`, and `migrate` never fills it in: stamping a default sensitivity onto a
# document about a credential exposure writes an actively false claim, and no script can tell which
# document that is. It is set by the author, at `new` or by hand.
VALID_SENSITIVITY="normal restricted"
doc_sensitivity() { # path -> normal | restricted (anything unrecognized reads as normal)
  local s
  s="$(meta "$1" sensitivity)"
  case " $VALID_SENSITIVITY " in *" $s "*) printf '%s' "$s" ;; *) printf 'normal' ;; esac
}
is_restricted() { [ "$(doc_sensitivity "$1")" = "restricted" ]; }

# Printed on claim, and nowhere else it would become wallpaper. It states the boundary in the same
# breath as the handling rule, because the whole failure mode of a flag like this is somebody
# reading it as a permission.
restricted_banner() { # id
  echo "🔴 RESTRICTED — $1 is marked sensitivity: restricted."
  echo "    It cannot be exported as a brief and must not be handed to a delegated or external"
  echo "    agent. Do the work yourself, in this session."
  echo "    This is a HANDLING rule, not an access control — everyone with board access can read"
  echo "    it. Keep credentials out of the doc; record their NAMES, never their values."
}

# Templates live in <board>/templates/. The flat fallback covers a board installed before the
# restructure (templates sat next to the CLI); when neither exists the callers fall back to an
# inline heredoc, so a missing template is never fatal.
tmpl_path() {
  if [ -f "$DIR/templates/$1" ]; then
    printf '%s' "$DIR/templates/$1"
  else
    printf '%s' "$DIR/$1"
  fi
}

# Fill a template's PLACEHOLDER_* tokens with literal values.
#
# This must NOT be `sed "s|PLACEHOLDER_NOTE|$note|"`. The value comes from --title/--note, i.e.
# arbitrary user text: a `|` in it closes the s/// expression early (sed then reads the remainder as
# a filename and fails), and `&` in a replacement expands to the whole match. The redirection has
# already truncated the destination by then, so the failure lands as a ZERO-BYTE handoff doc while
# the command still reports success. Bash's ${var//pat/rep} substitutes literally, needs no external
# process, and cannot be broken by any character in the value.
render_tmpl() { # tmpl-path KEY=value...
  local content
  content="$(cat "$1")" || return 1
  shift
  local kv k v
  for kv in "$@"; do
    k="${kv%%=*}"
    v="${kv#*=}"
    content="${content//$k/$v}"
  done
  printf '%s\n' "$content"
}

# Release a lease: remove its files then the now-empty dir. rmdir only removes an empty
# directory, so this never recursively deletes anything unexpected (no `rm -rf`).
clear_lock() {
  rm -f "$LOCKS/$1/owner" 2> /dev/null
  rmdir "$LOCKS/$1" 2> /dev/null || true
}

# Move an active doc to its archived location (section-aware), preferring git mv so history follows
# the rename. A no-op if $f is not the section's active doc (e.g. already archived). Falls back to a
# plain mv when the board lives outside any git worktree (a standalone shared board owned by no repo).
#
# Returns 0 when the doc was moved (or there was nothing to move), non-zero when the move failed —
# and prints the reason. It used to end in `|| true`, which made every failure invisible: the doc
# kept its `done` frontmatter, stayed in the live directory, and the caller still printed
# "moved to archive/". `list` reads the live directory, so a closed handoff went on being injected
# into every session-start board as open work, and someone eventually re-executed a finished item.
# The `|| true` was there so a board outside any git worktree still works — but the plain-`mv`
# fallback already covers that, so it only ever masked real failures.
archive_doc() { # active-doc-path id
  local f="$1" id="$2" dest err
  [ "$f" = "$(doc_file "$id")" ] || return 0
  dest="$(arch_file "$id")"
  mkdir -p "$(dirname "$dest")" || return 1
  git -C "$DIR" mv "$f" "$dest" 2> /dev/null && return 0
  err="$(mv "$f" "$dest" 2>&1)" && return 0
  printf 'archive failed: %s\n' "$err" >&2
  return 1
}

# What every `done` path prints when archive_doc could not move the doc. The release itself already
# succeeded in frontmatter, so this must not read as "the release failed" — it reads as "the doc is
# done but still live", which is the one thing the operator has to act on.
warn_archive_failed() { # id
  echo "⚠️  $1 is marked done, but its doc could NOT be moved to archive/."
  echo "    It is still in the live directory, so \`list\` will keep showing it as open work."
  echo "    Move it manually: git mv $(doc_file "$1") $(arch_file "$1")"
}

cmd_new() {
  local id="" title="" audience="" severity="medium" note="" type="coordination" children="" group="${HANDOFF_GROUP:-}"
  local environment="" depends="" role="" spec="" sensitivity="normal" force_secret="" ext_ref="" share=""
  local reviewer="" reviewer_set=0 home="" home_named=""
  id="${1:?usage: handoff new <id> [--title T] [--type coordination|standalone|orchestrator] [--standalone] [--orchestrator --children a,b,c] [--role steering|spec|reference|brief-archive] [--audience REPO] [--home REPO] [--group G] [--severity S] [--env ENV] [--after ID[,ID]] [--spec REF] [--sensitivity normal|restricted] [--reviewer HANDLE] [--note N]}"
  shift
  # Before the arg loop, because no flag can make this safe and nothing below should run on a
  # board this CLI must not add to. The board stamp is board-wide, so --group cannot change it.
  require_board_writable "create $id"
  while [ $# -gt 0 ]; do
    case "$1" in
      --title)
        title="${2:-}"
        shift 2
        ;;
      --audience)
        audience="${2:-}"
        shift 2
        ;;
      --home)
        require_value --home "$#" "${2:-}"
        home="$2"
        home_named=1
        shift 2
        ;;
      --group)
        group="${2:-}"
        shift 2
        ;;
      --severity)
        severity="${2:-}"
        shift 2
        ;;
      --note)
        note="${2:-}"
        shift 2
        ;;
      --type)
        type="${2:-}"
        shift 2
        ;;
      --standalone)
        type="standalone"
        shift
        ;;
      --orchestrator)
        type="orchestrator"
        shift
        ;;
      --children)
        children="${2:-}"
        shift 2
        ;;
      --env | --environment)
        environment="${2:-}"
        shift 2
        ;;
      # `--after` writes depends_on, and the flag is named for what the author is actually saying:
      # "this comes after that". There is deliberately no fanout command that clones one handoff
      # across a ladder of environments — the prod follow-up is a different piece of work with
      # different evidence, and minting it automatically produces the exact open-forever docs the
      # boards are already full of. `new --env prod --after <id>` is one line and says more.
      --after | --depends-on)
        depends="${2:-}"
        shift 2
        ;;
      --role)
        role="${2:-}"
        shift 2
        ;;
      --spec)
        spec="${2:-}"
        shift 2
        ;;
      --sensitivity)
        sensitivity="${2:-}"
        shift 2
        ;;
      --ref)
        require_value --ref "$#" "${2:-}"
        ext_ref="$2"
        shift 2
        ;;
      --share)
        require_value --share "$#" "${2:-}"
        share="$2"
        shift 2
        ;;
      --reviewer)
        require_value --reviewer "$#" "${2:-}"
        reviewer="$2"
        reviewer_set=1
        shift 2
        ;;
      --force-secret)
        # Reason REQUIRED, and recorded on the doc. An override with no stated reason is a silent
        # bypass wearing a flag, and the whole point of putting the scanner on the write path is
        # that getting past it leaves a trace.
        require_value --force-secret "$#" "${2:-}"
        force_secret="$2"
        shift 2
        ;;
      *)
        reject_unknown_flag "$1"
        shift
        ;;
    esac
  done
  case " $VALID_SENSITIVITY " in *" $sensitivity "*) ;; *) die "bad --sensitivity: $sensitivity (use ${VALID_SENSITIVITY// /|})" ;; esac
  # ADR 0017 — the repository whose tracker owns this handoff's issue. Pinned here and never changed:
  # `audience` moves with whoever acts next, the issue does not. Resolved before --ref, because the
  # reference is checked against THIS home's tracker.
  if [ "$type" != standalone ] && [ -z "$home" ]; then
    home="${HANDOFF_REPO:-}"
    [ -z "$home" ] && [ "$type" = coordination ] && home="$audience"
  fi
  # A DEFAULTED home that cannot be an alias is dropped, never fatal: it came from `audience`, which
  # is free text this board accepts as given (a `|` in one is a case the brief packer already
  # handles). Only a home somebody NAMED is worth refusing over.
  if [ -n "$home" ] && [ -z "$home_named" ]; then
    case "$home" in *[!A-Za-z0-9._-]*) home="" ;; esac
  fi
  if [ -n "$home" ]; then
    case "$home" in *[!A-Za-z0-9._-]*) die "--home '$home' is not a repository alias (letters, digits, dot, dash, underscore)." ;; esac
    [ "$type" = standalone ] && die "a standalone doc has no home — it is never mirrored (ADR 0017)."
    # Checked only when the caller NAMED it, and only against a registry that exists. A home derived
    # from the audience is as good as the audience, which nothing validates either; and a cross-repo
    # board has no registry at all until the cross-repo sync writes one, so validating there would
    # refuse every `new` on a board that is working perfectly well.
    if [ -n "$(registered_aliases)" ] && ! board_registers "$DIR" "$home"; then
      if [ -n "$home_named" ]; then
        die "--home $home is not a repository this board registers ($(registered_aliases | tr '\n' ' ' | sed 's/ $//')) — pass one of those."
      fi
      # Derived, so the write proceeds — but a home nothing registers is mirrored nowhere, and the
      # value came from $HANDOFF_REPO or the audience rather than from this command line, so the
      # person running it has not seen it. Say it once, here, rather than only in the verifier.
      echo "⚠️  home: $home is not a repository this board registers ($(registered_aliases | tr '\n' ' ' | sed 's/ $//')) — $id will be mirrored nowhere until it names one." >&2
    fi
  fi
  CUR_TRACKER="$home"
  [ -n "${ext_ref:-}" ] && { ext_ref="$(validate_external_ref "$ext_ref")" || exit 3; }
  # Refused, not folded — see validate_reviewer. A handle is an identifier, not prose. Keyed on
  # "the flag was given" rather than "the value is non-empty", so `--reviewer ""` is refused instead
  # of quietly filing a doc with no reviewer on it.
  [ "$reviewer_set" = 1 ] && { reviewer="$(validate_reviewer "$reviewer")" || exit 3; }
  # ADR 0013: `share` is audience, not handling. One value exists; restricted always wins; a
  # standalone doc is never published, so marking it would assert something nothing honours.
  if [ -n "$share" ]; then
    [ "$share" = public ] || die "bad --share: $share (the only value is public; leave it off to keep a doc unshared)"
    [ "$sensitivity" = restricted ] && die "--share public on a restricted doc is a contradiction — restricted never leaves the board. Pick one."
    [ "$type" = standalone ] && die "--share applies to work a tracker can publish; a standalone doc is never mirrored or delegated."
  fi
  [ "$sensitivity" = "restricted" ] && [ "$type" = "standalone" ] \
    && die "--sensitivity applies to work that can be delegated; a standalone/reference doc is never exported. Keep the material off the board instead."
  case "$type" in coordination | standalone | orchestrator) ;; *) die "bad --type: $type (use coordination|standalone|orchestrator)" ;; esac
  # Scoped exactly as `--for-review` is, and for the same reason: the field names who reviews THIS
  # WORK. A bundle holds no work of its own and is never claimed, and a standalone doc has no
  # lifecycle to review — naming a reviewer on either asserts a duty against nothing.
  [ -n "$reviewer" ] && [ "$type" != "coordination" ] \
    && die "--reviewer applies to coordination handoffs; a doc of type '$type' has no work of its own to review"
  if [ -n "$role" ]; then
    [ "$type" = "standalone" ] || die "--role only applies to a standalone doc (it says what a reference doc is FOR; coordination docs have a lifecycle, not a role)"
    case " $VALID_ROLES " in *" $role "*) ;; *) die "bad --role: $role (use ${VALID_ROLES// /|})" ;; esac
  fi
  [ -n "$spec" ] && [ "$type" = "orchestrator" ] && die "--spec applies to coordination and standalone docs, not to a bundle index"
  [ -n "$children" ] && [ "$type" != "orchestrator" ] && die "--children only applies to --orchestrator"
  # --group (or the wired $HANDOFF_GROUP) selects the board section this doc lands in. Overriding the
  # ambient GROUP here reroutes doc_file/arch_file/sec_index/lock_key for the rest of this command; on
  # a flat board (no LAYOUT) it is inert and the doc lands at the flat path exactly as before.
  if [ -n "$group" ]; then
    GROUP="$(slug "$group")"
    LOCKS="$(sec_dir)/.locks"
  fi
  # files are always <id>-handoff.md and the id is a lowercase-kebab slug of what the caller passed
  local raw_id="$id"
  id="$(norm_id "$id")" || die "unusable id: '$raw_id' (needs at least one letter or digit)"
  [ -f "$(doc_file "$id")" ] || [ -f "$(arch_file "$id")" ] && die "$id already exists"
  [ -n "$title" ] || title="$id"
  title="$(fold_colons "$title")"
  [ -n "$title" ] || title="$id"
  # Every other free-text value goes into frontmatter unquoted too, so fold them here — once,
  # before any branch — rather than in each of the three type branches and their heredoc fallbacks.
  note="$(fold_colons "$note")"
  audience="$(fold_colons "$audience")"
  severity="$(fold_colons "$severity")"
  environment="$(normalize_env "$environment")"
  # `--after` names board ids, so canonicalize them exactly as `claim` would. A dependency recorded
  # under a spelling that matches no file is a dependency nothing can ever check.
  local dlist=""
  if [ -n "$depends" ]; then
    dlist="$(children_csv "$depends")" || die "unusable id in --after: '$depends' (each needs at least one letter or digit)"
  fi
  # `spec:` is resolved by the reader, not here — a path, a URL, or a board id, in that order. It
  # is not validated at creation because a handoff is routinely filed before its spec is written.
  #
  # QUOTED rather than colon-folded, for the same reason as `verified_by`: the most common value is
  # a URL, and folding turns `https://…` into `https — //…`, which resolves to nothing. Readers
  # strip one surrounding quote pair; an embedded double quote becomes a single one, since the
  # frontmatter is unquoted YAML and a nested `"` would end the value early.
  [ -n "$spec" ] && spec="\"$(printf '%s' "$spec" | tr '"' "'")\""
  local d target
  d="$(today)"
  target="$(doc_file "$id")"
  mkdir -p "$(dirname "$target")" # the section subdir on a subfolder-layout board (a no-op when flat)
  # Rendered to a temp file, NOT to $target. The scanner below has to see the finished document
  # before the board does, so that a credential pasted into --title/--note/--audience/--spec is
  # refused with nothing on disk — "nothing was written" has to be literally true, not nearly.
  local staged created_msg=""
  staged="$(mktemp)" || die "mktemp failed"

  if [ "$type" = "orchestrator" ]; then
    # An orchestrator: an index over a bundle of related handoffs. Gate-exempt (no lease), no
    # audience/severity of its own. Children are canonicalized here so `--children rbac-gap` and
    # `--children rbac-gap-handoff` record the same id; progress is derived at read time, never
    # stored. A child that does not exist yet is allowed — a bundle is often planned before it is
    # filed — but `list` reports it as MISSING rather than counting it toward progress.
    local clist=""
    clist="$(children_csv "$children")" || die "unusable child id in --children: '$children' (each needs at least one letter or digit)"
    local tmpl
    tmpl="$(tmpl_path handoff-orchestrator-template.md)"
    if [ -f "$tmpl" ]; then
      render_tmpl "$tmpl" "PLACEHOLDER_ID=$id" "PLACEHOLDER_TITLE=$title" \
        "PLACEHOLDER_CREATED=$d" "PLACEHOLDER_UPDATED=$d" \
        "PLACEHOLDER_CHILDREN=$clist" "PLACEHOLDER_NOTE=$note" > "$staged"
    else
      {
        echo "---"
        echo "id: $id"
        echo "title: $title"
        echo "type: orchestrator"
        echo "status: open"
        echo "children: [$clist]"
        echo "created: $d"
        echo "updated: $d"
        echo "note: $note"
        echo "---"
        echo
        redaction_comment
        echo
        echo "## Bundle"
        echo
        echo "## Children"
        echo
        echo "<!-- prettier-ignore-start -->"
        echo "<!-- handoff:children:begin -->"
        echo "<!-- handoff:children:end -->"
        echo "<!-- prettier-ignore-end -->"
        echo
        echo "## Sequencing"
        echo
        echo "## Suggested skills"
        echo
      } > "$staged"
    fi
    created_msg="Created $target (orchestrator over ${clist:-no children yet}) — no claim needed."
  elif [ "$type" = "standalone" ]; then
    # A standalone/reference doc: gate-exempt, self-contained, no audience/severity/lease.
    local tmpl
    tmpl="$(tmpl_path handoff-standalone-template.md)"
    if [ -f "$tmpl" ]; then
      render_tmpl "$tmpl" "PLACEHOLDER_ID=$id" "PLACEHOLDER_TITLE=$title" \
        "PLACEHOLDER_ROLE=${role:-reference}" \
        "PLACEHOLDER_CREATED=$d" "PLACEHOLDER_UPDATED=$d" \
        "PLACEHOLDER_NOTE=$note" > "$staged"
    else
      {
        echo "---"
        echo "id: $id"
        echo "title: $title"
        echo "type: standalone"
        echo "role: ${role:-reference}"
        echo "status: open"
        echo "created: $d"
        echo "updated: $d"
        echo "note: $note"
        echo "---"
        echo
        redaction_comment
        echo
        echo "## Summary"
        echo
        echo "## Context"
        echo
        echo "## Suggested skills"
        echo
      } > "$staged"
    fi
    created_msg="Created $target (standalone/reference) — no claim needed; edit it freely."
  else
    if [ "$TOPOLOGY" = "cross-repo" ] && [ -z "$audience" ]; then
      # Shared board: no single default identity. Use the calling repo's env identity if present,
      # otherwise require an explicit --audience rather than defaulting to a stale/foreign name.
      if [ -n "${HANDOFF_REPO:-}" ]; then
        audience="$HANDOFF_REPO"
      else die "cross-repo board: pass --audience <repo> (which repo acts next) — a shared board has no default identity"; fi
    fi
    local tmpl
    tmpl="$(tmpl_path handoff-doc-template.md)"
    if [ -f "$tmpl" ]; then
      # PLACEHOLDER_* tokens (not {{...}} or <...>) so a prettier/lint pass on the shipped
      # template never mangles them before `handoff new` fills them in.
      render_tmpl "$tmpl" "PLACEHOLDER_ID=$id" "PLACEHOLDER_TITLE=$title" \
        "PLACEHOLDER_AUDIENCE=$audience" "PLACEHOLDER_SEVERITY=$severity" \
        "PLACEHOLDER_ENVIRONMENT=$environment" "PLACEHOLDER_SENSITIVITY=$sensitivity" \
        "PLACEHOLDER_CREATED=$d" "PLACEHOLDER_UPDATED=$d" \
        "PLACEHOLDER_NOTE=$note" > "$staged"
    else
      {
        echo "---"
        echo "id: $id"
        echo "title: $title"
        echo "type: coordination"
        echo "status: open"
        [ -n "$audience" ] && echo "audience: $audience"
        echo "severity: $severity"
        echo "environment: $environment"
        echo "sensitivity: $sensitivity"
        echo "depends_on: []"
        echo "created: $d"
        echo "updated: $d"
        echo "note: $note"
        echo "---"
        echo
        redaction_comment
        echo
        echo "## Current state"
        echo
        echo "## Context"
        echo
        echo "## Verify"
        echo
        echo "## Suggested skills"
        echo
      } > "$staged"
    fi
    created_msg="Created $target — claim it before working: ./handoff claim $id \"...\""
  fi
  # The write path's scanner (ADR 0005). Everything above rendered into $staged; the board is still
  # untouched, so a refusal here leaves no half-created doc, no index entry, and nothing to clean up.
  local hits=""
  if hits="$(scan_secrets < "$staged")"; then
    if [ -z "$force_secret" ]; then
      rm -f "$staged"
      die_on_secret "the new $id doc" "$hits"
    fi
  fi
  cat "$staged" > "$target" || {
    rm -f "$staged"
    die "could not write $target"
  }
  rm -f "$staged"
  echo "$created_msg"

  # Mirror the section into a `group:` frontmatter key for search/roll-up. Only on a grouped board, so
  # a flat board's docs carry no group line and stay byte-identical to before this feature.
  grouped && set_field "$target" group "$GROUP"
  set_field "$target" schema "$SCHEMA_VERSION"
  # Written after rendering rather than through placeholders: both are optional, and a template
  # placeholder left unsubstituted would put the literal string into the frontmatter.
  [ -n "$dlist" ] && set_field "$target" depends_on "[$dlist]"
  [ -n "$spec" ] && set_field "$target" spec "$spec"
  [ -n "${ext_ref:-}" ] && set_field "$target" external_ref "$ext_ref"
  [ -n "$home" ] && set_field "$target" home "$home"
  [ -n "$reviewer" ] && set_field "$target" reviewer "$reviewer"
  [ -n "$share" ] && set_field "$target" share "$share"
  # Coordination and orchestrator docs carry it explicitly so the field is discoverable at the one
  # moment somebody is looking at the frontmatter. A standalone doc is never exported or delegated,
  # so the field would assert a handling rule that has nothing to apply to.
  [ "$type" = "standalone" ] || set_field "$target" sensitivity "$sensitivity"
  if [ -n "$force_secret" ] && [ -n "$hits" ]; then
    log_secret_override "$target" "secret-scan OVERRIDDEN at creation" "$hits" "$force_secret"
    echo "⚠️  Secret scan overridden — recorded on the doc's activity log."
  fi
  # ADR 0020 — only on a board whose docs are pushed somewhere (board_remote non-empty covers an
  # in-repo board too: its docs travel with that repo's own commits).
  [ -n "$(board_remote)" ] && machine_refs_file "$target"
  # Same `if` form as cmd_claim's, for the same reason — here the status is currently swallowed by
  # the two commands below, which is luck, not design.
  if is_restricted "$target"; then restricted_banner "$id"; fi
  echo "🔒 Before committing: redact secrets/keys/passwords/PII — this doc goes into git history."
  cmd_index
}

# Read a returned brief back onto the board. Everything in the file was written OUTSIDE this repo's
# tooling, so the refusals below are the substance of this command, not defensive padding.
#
# The one thing it never does is write `status`. The executor's claim lands in `result_claimed`,
# beside a `status` it did not change: `done` stays a reviewer action backed by evidence the
# reviewer reproduced. That is the whole protocol, preserved across a trust boundary.
import_result() {
  local src="" force_repo=0 force_secret=""
  src="${1:?usage: handoff import --result <file> [--force-repo] [--force-secret REASON]}"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --force-repo)
        force_repo=1
        shift
        ;;
      --force-secret)
        require_value --force-secret "$#" "${2:-}"
        force_secret="$2"
        shift 2
        ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  [ -f "$src" ] || die "no such file: $src"

  local ver
  ver="$(meta "$src" brief)"
  [ "$ver" = "1" ] || die "unknown brief format '$ver' — this CLI reads brief format 1. Update the board (re-run setup-handoff) or the brief."

  # Repo guard FIRST. A brief names file:line locations that may exist in another repo and mean
  # something else there; landing its result on a same-named handoff would be silent corruption.
  local want_root have_root
  want_root="$(meta "$src" repo_root_commit)"
  have_root="$(repo_root_commit)"
  if [ "$want_root" = "unverified" ]; then
    [ "$force_repo" -eq 1 ] \
      || die "this brief was rendered without a verified repo identity — confirm it targets $(basename "${REPO_DIR:-.}") by hand, then re-run with --force-repo"
    echo "⚠️  Importing a brief with an unverified repo identity because --force-repo was given."
  elif [ "$want_root" != "$have_root" ]; then
    die "this brief targets a different repository ($(meta "$src" repo_name) at $(meta "$src" repo_origin), provider $(meta "$src" repo_provider)) — refusing to import it here"
  fi

  local id f
  id="$(resolve_id "$(meta "$src" handoff)")" || die "brief names an unusable handoff id"
  if is_archived "$id"; then
    die "$id is already archived at $(arch_file "$id") — reopen it before importing a result"
  fi
  f="$(doc_of "$id")" || no_such "$id"

  local claimed
  claimed="$(meta "$src" result_status)"
  case "$claimed" in
    done | partial | blocked) ;;
    "") die "the brief's result_status is empty — it was not filled in" ;;
    *) die "bad result_status '$claimed' (expected done, partial, or blocked)" ;;
  esac

  local body
  body="$(result_block "$src")"
  # A block that still carries only headings and the template comments is not a result.
  local substance
  substance="$(printf '%s\n' "$body" | grep -v '^###' | grep -v '^[[:space:]]*<!--' | tr -d '[:space:]')"
  [ -n "$substance" ] || die "the brief's Result block was not filled in"

  # result_by/result_at are just as untrusted as the Result body and land in the same
  # permanently-committed doc — fetched here, once, so the secret scan below and the writes further
  # down both see the exact same values (nothing is re-read from the file in between).
  local result_by_raw result_at_raw
  result_by_raw="$(meta "$src" result_by)"
  result_at_raw="$(meta "$src" result_at)"

  # The returned text is untrusted and about to enter git history permanently. Scans the Result
  # body AND the frontmatter fields spliced from this same file — a credential pasted into
  # `result_by:` instead of the body would otherwise walk straight past a body-only scan.
  #
  # Through the shared scanner (ADR 0005), not a local regex: this used to be the ONLY scan in the
  # CLI and it carried its own four patterns, so every rule added for the outbound path would have
  # had to be added here too, by hand, forever.
  local in_hits=""
  if in_hits="$(printf '%s\n%s\n%s\n' "$body" "$result_by_raw" "$result_at_raw" | scan_secrets)"; then
    if [ -z "$force_secret" ]; then
      die_on_secret "the Result block returned for $id" "$in_hits"
    fi
  fi

  if [ "$claimed" = "done" ] \
    && [ -z "$(printf '%s\n' "$body" | awk '/^### Commits and PR/{c=1;next} /^###/{c=0} c' | tr -d '[:space:]')" ]; then
    echo "⚠️  The brief claims done but names no commit or PR. Treat the evidence with extra suspicion."
  fi

  local src_commit head_commit
  src_commit="$(meta "$src" source_commit)"
  head_commit="$(git -C "${REPO_DIR:-.}" rev-parse --short HEAD 2> /dev/null || echo "")"
  if [ -n "$src_commit" ] && [ -n "$head_commit" ] && [ "$src_commit" != "$head_commit" ]; then
    echo "⚠️  Brief was rendered at $src_commit; HEAD is $head_commit. The Where anchors may have moved."
  fi

  # `handoff:` above is attacker-controlled (it comes from the returned brief), so id resolution
  # can be pointed at ANY live doc on the board, not only the one that was actually delegated —
  # combined with the frontmatter-injection bug this fixes elsewhere, that let a result be stamped
  # onto a doc nobody sent out. Refuse unless the target doc shows it was genuinely delegated, and
  # unless its `brief:` pointer names THIS exact file — otherwise a stray or hand-edited `handoff:`
  # value (or a second, unrelated brief) could stamp a claim onto a doc that was never exported, or
  # silently overwrite an already-imported result from a different executor. Checked here, right
  # before the writes, so every refusal above (format, repo, id, result_status, empty result,
  # secrets) still fires on its own untouched doc first.
  local want_brief brief_abs src_abs
  want_brief="$(meta "$f" brief)"
  [ -n "$want_brief" ] && [ -n "$(meta "$f" delegated_at)" ] \
    || die "$id was never delegated (no brief:/delegated_at on the board doc) — refusing to import a result onto it. Nothing was written."
  case "$want_brief" in
    /*) brief_abs="$want_brief" ;;
    *) brief_abs="${REPO_DIR:+$REPO_DIR/}$want_brief" ;;
  esac
  src_abs="$(abs_path "$src")"
  [ "$brief_abs" = "$src_abs" ] \
    || die "$id's brief: does not point at $src — refusing to import a result from a different or unrelated brief file. Nothing was written."

  # Defense in depth, independent of how set_field is implemented: an imported result must never
  # cause these keys to appear or change. If any did, something upstream broke — restore the doc
  # immediately rather than leave a compromised frontmatter key on a doc headed for git history.
  local backup
  backup="$(mktemp)" || die "mktemp failed"
  require_writable "$f" "$(meta "$f" id)"
  cp "$f" "$backup" || die "could not back up $f before importing"
  local deny_before_verify deny_before_status deny_before_repos deny_before_audience \
    deny_before_id deny_before_children deny_before_blocked_on deny_before_home
  deny_before_verify="$(meta "$f" verify)"
  deny_before_status="$(meta "$f" status)"
  deny_before_repos="$(meta "$f" repos)"
  deny_before_audience="$(meta "$f" audience)"
  deny_before_id="$(meta "$f" id)"
  deny_before_children="$(meta "$f" children)"
  deny_before_blocked_on="$(meta "$f" blocked_on)"
  deny_before_home="$(meta "$f" home)"

  splice_result "$f" "$body"
  set_field "$f" result_from "$(fold_colons "$result_by_raw")"
  set_field "$f" result_at "$(fold_colons "$result_at_raw")"
  set_field "$f" result_claimed "$claimed"
  # `executed_by` is decided when work is handed OUT (ADR 0015), so an import PRESERVES it — a
  # result arriving is not the moment anyone learns whether a human was watching. Only a doc with no
  # kind at all is stamped here: one delegated before this field was re-cut, or handed out by hand.
  # It is stamped `afk`, because a result arriving from outside with nobody having said a person was
  # present is exactly the unattended case, and that is the reading that asks for more scrutiny
  # rather than less.
  [ -n "$(meta "$f" executed_by)" ] || set_field "$f" executed_by afk
  set_field "$f" review pending

  if [ "$(meta "$f" verify)" != "$deny_before_verify" ] \
    || [ "$(meta "$f" status)" != "$deny_before_status" ] \
    || [ "$(meta "$f" repos)" != "$deny_before_repos" ] \
    || [ "$(meta "$f" audience)" != "$deny_before_audience" ] \
    || [ "$(meta "$f" home)" != "$deny_before_home" ] \
    || [ "$(meta "$f" id)" != "$deny_before_id" ] \
    || [ "$(meta "$f" children)" != "$deny_before_children" ] \
    || [ "$(meta "$f" blocked_on)" != "$deny_before_blocked_on" ]; then
    cat "$backup" > "$f"
    rm -f "$backup"
    die "import --result: the reported values would have altered a protected frontmatter key (verify/status/repos/audience/home/id/children/blocked_on) on $id — refused and restored the doc. This should never happen; treat it as a bug."
  fi
  rm -f "$backup"

  log_activity "$f" "result reported by $result_by_raw claiming $claimed — awaiting review"
  if [ -n "$force_secret" ] && [ -n "$in_hits" ]; then
    log_secret_override "$f" "inbound secret-scan OVERRIDDEN on import" "$in_hits" "$force_secret"
    echo "⚠️  Inbound secret scan overridden — recorded on $id's activity log."
  fi

  # ADR 0020 — same gate as `new`/plain `import`: only a board whose docs are pushed somewhere.
  [ -n "$(board_remote)" ] && machine_refs_file "$f"

  echo "Imported the reported result into $f."
  echo "Board status is UNCHANGED — the report is a claim, not a verdict."
  echo "Review the PR, reproduce the evidence, then close it yourself:"
  echo "  handoff release $id --status done --verified-by \"<how YOU verified live code>\""
  cmd_index
}

# Replace (or append) the doc's reported-result block. Bounded by the same marker pair the brief
# uses, which is what makes a re-import replace rather than stack up a second copy.
splice_result() { # doc-path body
  local f="$1" body="$2" t
  t="$(mktemp)" || die "mktemp failed"
  if grep -q '<!-- handoff:result:begin -->' "$f"; then
    # The body is routed through a FILE, never through `awk -v`: POSIX awk interprets C-style
    # backslash escapes (\f, \b, \t, ...) in a -v-assigned value, so evidence text containing a
    # Windows path or a regex would be silently mangled here on every RE-import — the fresh-append
    # branch below uses `printf '%s'` instead, which never interprets escapes, so identical input
    # used to produce two different on-disk results depending on which branch ran. getline reads
    # raw bytes and interprets nothing, so this branch now matches that branch byte-for-byte.
    local bf
    bf="$(mktemp)" || die "mktemp failed"
    printf '%s' "$body" > "$bf"
    awk -v bf="$bf" '
      /<!-- handoff:result:begin -->/ {
        print
        print ""
        while ((getline line < bf) > 0) print line
        close(bf)
        skip = 1
        next
      }
      /<!-- handoff:result:end -->/   { skip = 0 }
      !skip { print }
    ' "$f" > "$t" && cat "$t" > "$f"
    rm -f "$bf"
  else
    {
      cat "$f"
      printf '\n## Result (reported)\n\n'
      printf '<!-- Reported by an external executor and spliced in by `handoff import --result`.\n'
      printf '     It is a CLAIM about live code, not a verified board status. -->\n\n'
      printf '<!-- handoff:result:begin -->\n\n%s\n\n<!-- handoff:result:end -->\n' "$body"
    } > "$t" && cat "$t" > "$f"
  fi
  rm -f "$t"
}

# Bring an existing file onto the board as a handoff (default type: standalone). Used to migrate
# reference docs. Never moves the source (the caller trashes it); we copy + normalize frontmatter.
cmd_import() {
  # Two commands under one verb, with INVERTED preconditions: plain `import` refuses an id that is
  # already on the board, `--result` refuses one that is not. Routed here rather than as its own
  # subcommand to keep the export/import pair symmetric for the caller.
  if [ "${1:-}" = "--result" ] && [ "${2:-}" = "--from-issue" ]; then
    shift 2
    import_result_from_issue "$@"
    return
  fi
  if [ "${1:-}" = "--result" ]; then
    shift
    import_result "$@"
    return
  fi
  local src="" id="" title="" type="standalone" severity="" note="" group="${HANDOFF_GROUP:-}"
  src="${1:?usage: handoff import <file> [--id ID] ... | handoff import --result <file> [--force-repo]}"
  shift
  # Same blind spot as `new`, same gate: plain import CREATES a board document, stamped with this
  # CLI's schema. `--result` returned above and writes an existing doc, so require_writable covers it.
  require_board_writable "import $src"
  while [ $# -gt 0 ]; do
    case "$1" in
      --id)
        id="${2:-}"
        shift 2
        ;;
      --group)
        group="${2:-}"
        shift 2
        ;;
      --title)
        title="${2:-}"
        shift 2
        ;;
      --type)
        type="${2:-}"
        shift 2
        ;;
      --severity)
        severity="${2:-}"
        shift 2
        ;;
      --note)
        note="${2:-}"
        shift 2
        ;;
      --standalone)
        type="standalone"
        shift
        ;;
      *)
        reject_unknown_flag "$1"
        shift
        ;;
    esac
  done
  [ -f "$src" ] || die "no such file: $src"
  case "$type" in coordination | standalone) ;; *) die "bad --type: $type (use coordination|standalone)" ;; esac
  [ -n "$id" ] || id="$(basename "$src" .md)"
  # norm_id is the only sanitizer: it slugifies to lowercase kebab-case and appends the suffix, so
  # board files are always <id>-handoff.md. It rejects an id with nothing alphanumeric in it.
  id="$(norm_id "$id")" || die "could not derive a usable id from $src — pass --id"
  if [ -n "$group" ]; then
    GROUP="$(slug "$group")"
    LOCKS="$(sec_dir)/.locks"
  fi
  [ -f "$(doc_file "$id")" ] || [ -f "$(arch_file "$id")" ] && die "$id already exists on the board"
  # title: --title, else the first markdown H1, else the id
  [ -n "$title" ] || title="$(sed -n 's/^# //p' "$src" | head -1)"
  [ -n "$title" ] || title="$id"
  title="$(fold_colons "$title")"
  [ -n "$title" ] || title="$id"
  note="$(fold_colons "$note")"
  severity="$(fold_colons "$severity")"
  local d dest
  d="$(today)"
  dest="$(doc_file "$id")"
  mkdir -p "$(dirname "$dest")" # the section subdir on a subfolder-layout board (a no-op when flat)

  if [ "$(head -1 "$src")" = "---" ]; then
    # Source already has YAML frontmatter — copy it, then upsert the board keys via set_field.
    cp "$src" "$dest"
    set_field "$dest" id "$id"
    set_field "$dest" title "$title"
    set_field "$dest" type "$type"
    [ -n "$(meta "$dest" status)" ] || set_field "$dest" status "open"
    [ -n "$(meta "$dest" created)" ] || set_field "$dest" created "$d"
    set_field "$dest" updated "$d"
    [ "$type" = "coordination" ] && [ -n "$severity" ] && set_field "$dest" severity "$severity"
  else
    # No frontmatter — prepend a fresh block above the content, verbatim.
    {
      echo "---"
      echo "id: $id"
      echo "title: $title"
      echo "type: $type"
      echo "status: open"
      [ "$type" = "coordination" ] && echo "severity: ${severity:-medium}"
      echo "created: $d"
      echo "updated: $d"
      echo "note: $note"
      echo "---"
      echo
    } > "$dest"
    cat "$src" >> "$dest"
  fi
  grouped && set_field "$dest" group "$GROUP" # record the section for search; no-op on a flat board
  # ADR 0020 — same gate as `new`: only a board whose docs are pushed somewhere.
  [ -n "$(board_remote)" ] && machine_refs_file "$dest"
  echo "Imported $src → $dest (type: $type)."
  echo "🔒 Before committing: redact secrets/keys/passwords/PII — this doc goes into git history."
  cmd_index
}

# Render a board doc into a self-contained execution brief for someone who has the repo but not the
# board — no leases, no hooks, no skills. The brief inlines the executor contract that those would
# otherwise carry, and it carries repo identity so it cannot be run against the wrong checkout.
cmd_export() {
  local id="${1:?usage: handoff export <id> [--to WHO] [--executed-by hitl|afk] [--out DIR] [--branch NAME] [--no-claim] [--force-secret REASON]}"
  shift
  local raw_id="$id" to="" outdir="" branch="" do_claim=1 force_secret="" to_issue=0 executed_by=afk
  id="$(resolve_id "$id")" || die "unusable id: '$raw_id' (needs at least one letter or digit)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --to-issue)
        to_issue=1
        shift
        ;;
      --to)
        require_value --to "$#" "${2:-}"
        to="$(fold_colons "$2")"
        shift 2
        ;;
      --out)
        require_value --out "$#" "${2:-}"
        outdir="$2"
        shift 2
        ;;
      --branch)
        require_value --branch "$#" "${2:-}"
        branch="$2"
        shift 2
        ;;
      --no-claim)
        do_claim=0
        shift
        ;;
      --executed-by)
        require_value --executed-by "$#" "${2:-}"
        executed_by="$2"
        case "$executed_by" in
          hitl | afk) ;;
          *) die "--executed-by must be hitl (a person is present and will report what they observed) or afk (nobody is watching, so the evidence must be reproducible) — got '$executed_by'" ;;
        esac
        shift 2
        ;;
      --force-secret)
        require_value --force-secret "$#" "${2:-}"
        force_secret="$2"
        shift 2
        ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  local f
  f="$(doc_of "$id")" || no_such "$id"
  is_standalone "$f" && die "$id is a standalone/reference handoff — it holds no work to delegate. Send the file itself."
  [ "$(meta "$f" status)" = "done" ] && die "$id is already done — nothing to delegate"
  # Before reading sensitivity off it: a doc this CLI cannot write is a doc whose fields it has no
  # business interpreting. export_one/export_bundle check again on their own path; this is a pure
  # check, so the second call costs nothing.
  require_writable "$f" "$id"
  # The hard half of `sensitivity: restricted` (ADR 0005). Checked HERE, before the bundle branch
  # and before a single file is touched, so the refusal is total: no cover, no child brief, no
  # lease, no stamp. There is no --force for it — an override on the claim banner is a nudge, an
  # override on the outbound path is the whole control.
  is_restricted "$f" \
    && die "$id is sensitivity: restricted — it cannot be exported as a brief or handed to an external executor. Do the work in a session with board access. (This is a handling rule; board membership is the access boundary.)"

  if [ "$to_issue" = 1 ]; then
    # A bundle is a shape the tracker can already express (ADR 0014 projects one as a parent issue
    # with native sub-issues), so the issue path splits the same way the file path does rather than
    # refusing the unit a contractor is actually handed.
    if is_orchestrator "$f"; then
      export_bundle_to_issue "$id" "$f" "$outdir" "$branch" "$do_claim" "$force_secret"
    else
      export_to_issue "$id" "$f" "$outdir" "$branch" "$do_claim" "$force_secret"
    fi
    stamp_executed_by "$f" "$executed_by"
    return
  fi

  if is_orchestrator "$f"; then
    # export_one hardcodes an empty branch per child (each gets its own default fix/<child-id>),
    # so a bundle export silently DISCARDED --branch instead of honoring or rejecting it. Refuse
    # it outright rather than pretend a single branch name could apply to N independent children.
    [ -n "$branch" ] && die "--branch is not supported for a bundle export — each child gets its own default branch (fix/<child-id>)"
    export_bundle "$id" "$f" "$to" "$outdir" "$do_claim" "$force_secret"
    stamp_executed_by "$f" "$executed_by"
    return
  fi
  export_one "$id" "$f" "$to" "$outdir" "$branch" "$do_claim" "$force_secret"
  stamp_executed_by "$f" "$executed_by"
}

# ADR 0015 — `executed_by` records whether a HUMAN WAS IN THE LOOP, not who acted. Who acted does
# not decide how much review a closure needs: a contractor's agent grinding through a migration
# unattended and an engineer watching a change land are both outside the board, and they need
# opposite amounts of scrutiny.
#
# Written when work is handed OUT rather than when a result arrives, so the value exists even if no
# result ever comes back, and so the requester has decided what evidence they will accept before
# anyone starts. `afk` is the default because the two mistakes do not cost the same: under-reviewing
# unwatched work is how a wrong change closes, while over-reviewing watched work costs a second look.
#
# On a bundle the CHILDREN carry it. The parent is an index — nobody executes it — and giving it a
# kind would put a `mode:` label on an issue that reports no work.
stamp_executed_by() { # doc mode
  local f="$1" mode="$2" kid kf
  if is_orchestrator "$f"; then
    while IFS= read -r kid; do
      [ -n "$kid" ] || continue
      kf="$(doc_of "$kid" 2> /dev/null || true)"
      [ -n "$kf" ] && [ -f "$kf" ] && set_field "$kf" executed_by "$mode"
    done <<< "$(children_of "$f")"
    return
  fi
  set_field "$f" executed_by "$mode"
}

# Guard for brief_identity's packed "a|b|c|d|e" return: `fold_colons` only folds ":", so a
# user-supplied field (audience, via --audience) can still carry "|" and shift every field after
# it when the caller's `IFS='|' read -r a b c d` splits the string back apart. Applied to every
# field before packing, not just audience, so the guard holds even if a future field starts
# carrying free text too.
strip_pipes() { printf '%s' "$1" | tr -d '|'; }

# --- cross-repo target resolution ---------------------------------------------------------
# On a grouped board (register-cross-repo-handoff) the board is owned by NO repo and a handoff's
# `audience` names a repo other than the one export runs in. The target is resolved from
# `<board>/repos.json` — the projection of the `.handoff-repos.json` cascade that the cross-repo
# sync writes, because this CLI ships inside the target repos and can neither reach that skill's
# resolver nor know the cascade's --scope.
#
# It is NEVER resolved by name. An earlier version guessed `${REPO_DIR}/../$audience/.git` and
# treated a hit as verified; a same-named but unrelated sibling then put that unrelated repo's REAL
# root commit into the brief and rendered a fully confident preflight, which is indistinguishable
# from a fabricated SHA to the executor.
#
# Each registry entry is ATTESTED with the target's root commit as of the last sync, and that
# attestation is re-checked against the live repo here. A declared path that now holds something
# else — a moved checkout, a hand-edited manifest, a stale registry — fails closed to "unverified"
# instead of stamping a confident SHA for the wrong repo. Every failure mode degrades; none guesses.
#
# Prints "reason|abs-path|attested-root". reason is one of:
#   ok           the audience resolved to exactly one attested entry
#   no-python    python3 is unavailable, so the registry cannot be read
#   no-registry  this board has no repos.json (never synced, or a flat board)
#   bad-registry repos.json is unreadable or malformed
#   no-entry     the registry declares no repo with this audience in the caller's section
#   ambiguous    two entries in one section claim this audience, so there is no single answer
board_repo_entry() { # audience -> "reason|abs-path|attested-root"
  local aud="$1"
  command -v python3 > /dev/null 2>&1 || {
    printf 'no-python||'
    return
  }
  [ -f "$DIR/handoff.json" ] || [ -f "$DIR/repos.json" ] || {
    printf 'no-registry||'
    return
  }
  local legacy="" result
  command -v handoff_legacy_location_files > /dev/null 2>&1 && legacy="$(handoff_legacy_location_files)"
  # Captured through a function rather than a heredoc inside $(...): bash 3.2 (macOS /bin/bash)
  # mis-parses quotes in a heredoc body nested in a command substitution.
  result="$(_board_repo_entry_py "$aud" "$legacy")"
  # The cache is one disk's truth, so it must never ride a `git add` into a board everybody clones.
  # Setup writes this rule; a board installed before the cache moved gets it here, through the same
  # helper `locations --move` uses.
  [ -f "$DIR/.locations.json" ] && command -v handoff_ignore_locations > /dev/null 2>&1 \
    && handoff_ignore_locations "$DIR" > /dev/null 2>&1
  printf '%s' "$result"
}

_board_repo_entry_py() { # audience legacy-files -> "reason|abs-path|attested-root"
  python3 - "$DIR/handoff.json" "$DIR" "$1" "$GROUP" "$2" << 'PY'
import json, os, subprocess, sys

reg, board, aud, group = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
HOME = os.path.expanduser("~")
# The per-machine location cache lives IN the board (ADR 0010): a location belongs to one board on
# one disk, so the board is its home. It is ignored by the board's own .gitignore beside .locks/, so
# cloning the board never carries one machine's paths to another. It used to live in
# ~/.agents/handoff.json — a namespace other tools share, and one this tooling no longer writes.
LOCATIONS = os.path.join(board, ".locations.json")
# The legacy user-layer maps are still READ, below the board's own cache, so a machine that has not
# accepted the move keeps resolving. They are never written: moving entries out of them is the
# prompted migration in config.sh (handoff_legacy_locations), never a side effect of a lookup. The
# list itself comes from config.sh (handoff_legacy_location_files), so the reader and the mover
# cannot disagree about which files count.
USER_LOCATIONS = tuple(p for p in sys.argv[5].split("\n") if p)


def out(s):
    sys.stdout.write(s)
    raise SystemExit(0)


def root_commit(path):
    """The repo's first commit — the identity that survives being moved, renamed, or re-cloned."""
    if not os.path.isdir(path):
        return ""
    try:
        r = subprocess.run(["git", "-C", path, "rev-list", "--max-parents=0", "HEAD"],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return ""
    lines = [ln for ln in r.stdout.split() if ln]
    return lines[-1] if lines else ""


def load_locations():
    out = {}
    for path in USER_LOCATIONS + (LOCATIONS,):  # the board's own cache last, so it wins
        try:
            with open(path) as fh:
                data = json.load(fh)
            locs = data.get("locations")
            if isinstance(locs, dict):
                out.update(locs)
        except (OSError, ValueError, AttributeError):
            continue
    return out


def remember(sha, path):
    """Cache a discovered location in the board. Best-effort: a board this machine cannot write
    still resolves, it just pays for the scan again next time."""
    try:
        try:
            with open(LOCATIONS) as fh:
                data = json.load(fh)
            if not isinstance(data, dict):
                data = {}
        except (OSError, ValueError):
            data = {}
        data.setdefault("locations", {})
        if not isinstance(data["locations"], dict):
            data["locations"] = {}
        data["locations"][sha] = path
        tmp = LOCATIONS + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(data, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(tmp, LOCATIONS)
    except OSError:
        pass


def scan_roots():
    """Where to look for a checkout whose root commit matches. $WORKSPACE_ROOT is the declared
    answer; the board's own parent directories are the fallback, because a board scaffolded by the
    cross-repo sync sits beside the repos it coordinates. One level deep only — a full-disk walk on
    every unresolved audience is not a lookup, it is a hang."""
    roots = []
    for raw in (os.environ.get("WORKSPACE_ROOT", ""), os.path.dirname(board),
                os.path.dirname(os.path.dirname(board))):
        if not raw:
            continue
        p = os.path.realpath(os.path.expanduser(raw))
        if os.path.isdir(p) and p not in roots:
            roots.append(p)
    return roots


def discover(sha):
    for root in scan_roots():
        try:
            names = sorted(os.listdir(root))
        except OSError:
            continue
        for name in names:
            if name.startswith("."):
                continue
            cand = os.path.join(root, name)
            if not os.path.isdir(os.path.join(cand, ".git")):
                continue
            if root_commit(cand) == sha:
                remember(sha, cand)
                return cand
    return ""


def read_registry():
    """The projected repo list, from the board's consolidated file or the standalone predecessor.

    `_generated` is the block the cross-repo sync owns. Reading the consolidated file first means a
    board that has been re-synced answers from one place; a board that has not keeps answering from
    repos.json until it is.
    """
    for path, key in ((reg, "_generated"), (os.path.join(board, "repos.json"), None)):
        if not os.path.isfile(path):
            continue
        with open(path) as fh:
            data = json.load(fh)
        block = data.get(key) if key else data
        if not isinstance(block, dict):
            continue
        repos = block.get("repos")
        if isinstance(repos, list):
            return repos
    return None


# ABSENT and UNREADABLE are different answers and get different messages. Now that every board has
# a handoff.json, "the file is there but declares no fleet" is the ordinary state of a single-repo
# board — reporting that as a corrupt registry would send someone to repair a file that is fine.
try:
    repos = read_registry()
except Exception:  # noqa: BLE001 - any unreadable registry is one failure mode: do not trust it
    out("bad-registry||")
if repos is None:
    out("no-registry||")

# `path` is no longer required for an entry to be usable — rootCommit alone identifies the repo,
# which is the whole point of schema 2. A v1 entry still carries a path and it is still honoured
# below, as a hint that has to prove itself.
hits = [r for r in repos
        if isinstance(r, dict) and r.get("audience") == aud and r.get("rootCommit")]
# The manifest is the fence: a repo coordinates only with the peers ITS OWN group lists, and a
# handoff only ever acts within its caller's section. Restricting to that section is not a
# tiebreak — it is the same scoping every other command already applies, and it lets two groups
# sharing one board each have their own "api" without either becoming ambiguous. With no section
# set (a flat board, or a board-level invocation) there is nothing to scope by, so uniqueness
# across the whole registry is the requirement.
if group:
    hits = [r for r in hits if r.get("group") == group]
if not hits:
    out("no-entry||")
if len(hits) > 1:
    # Two repos answering to one audience within one section is not a tie to break by heuristic —
    # it is a manifest the operator has to fix. Resolving either would be a coin flip rendered as
    # verified.
    out("ambiguous||")

entry = hits[0]
sha = entry["rootCommit"]

# Resolution order, all of it keyed on the committed identity and none of it on a committed
# location: the per-machine map, then the v1 path (accepted only if that checkout really is this
# repo), then a bounded discovery scan whose answer is cached back into the map.
cached = load_locations().get(sha)
if cached and root_commit(cached) == sha:
    out("ok|%s|%s" % (os.path.realpath(cached), sha))

# A schema-1 entry's path is honoured UNVERIFIED, exactly as before. Attestation is the caller's
# job — brief_identity compares the live root commit against the attested one and degrades to
# "unverified" with a re-sync instruction when they disagree. Verifying here instead would collapse
# "the recorded path now holds a different repo" (a stale registry, fix by re-syncing) into "no
# checkout of this repo was found" (a missing clone, fix by cloning), and the operator would be
# told to do the wrong thing.
legacy = entry.get("path")
if legacy:
    out("ok|%s|%s" % (os.path.realpath(os.path.join(board, legacy)), sha))

found = discover(sha)
if found:
    out("ok|%s|%s" % (os.path.realpath(found), sha))

# Identified but not located. Distinct from "not declared": the board knows exactly which repo is
# meant and this machine simply does not have it where anything can see it, which is a different
# thing to tell the operator and a different thing to fix.
out("no-location||%s" % sha)
PY
}

# Resolve identity for the repo a brief targets. On a flat board that is this repo; on a grouped
# board it is the audience's repo, resolved through board_repo_entry above. Anything that cannot be
# resolved AND attested records "unverified" rather than fabricate a SHA — a fabricated SHA would
# make a wrong-repo run look verified, which is worse than no guard at all.
brief_identity() { # doc-path -> "name|provider|origin|rootsha|note"
  local f="$1" target="${REPO_DIR:-}" name provider origin root note=""
  local aud raw reason="" attested="" live=""
  aud="$(strip_pipes "$(meta "$f" audience)")"
  if [ -n "$aud" ] && [ "$aud" != "$REPO_NAME" ]; then
    IFS='|' read -r reason target attested <<< "$(board_repo_entry "$aud")"
    case "$reason" in
      ok)
        live="$(repo_root_commit "$target")"
        if [ -z "$live" ]; then
          target=""
          note="> **Warning** — \`$aud\` is declared in this board's cross-repo registry, but its checkout was not reachable when this brief was rendered, so the root-commit check above cannot pass. Confirm by name and remote instead, and ask the sender before proceeding."
        elif [ "$live" != "$attested" ]; then
          target=""
          note="> **Warning** — the path this board records for \`$aud\` no longer holds that repository (its root commit does not match the one recorded at the last cross-repo sync), so identity was not resolved. Re-run the cross-repo sync and re-export rather than trusting this brief's location."
        fi
        ;;
      no-python)
        target=""
        note="> **Warning** — resolving \`$aud\` needs python3, which was not available when this brief was rendered, so the root-commit check above cannot pass. Confirm by name and remote instead, and ask the sender before proceeding."
        ;;
      no-registry)
        target=""
        note="> **Warning** — this board carries no cross-repo registry, so \`$aud\` could not be resolved to a repository and the root-commit check above cannot pass. Re-run register-cross-repo-handoff's sync on the workspace, or confirm by name and remote and ask the sender before proceeding."
        ;;
      ambiguous)
        target=""
        note="> **Warning** — more than one repository on this board claims the audience \`$aud\`, so there is no single target and identity was not resolved. Fix the group manifest, re-sync, then re-export."
        ;;
      no-location)
        # Identified but not located: the board knows which repo is meant, this machine just does
        # not have it anywhere the resolver looks. That is a per-machine problem with a per-machine
        # fix, and saying so is more useful than the generic "not declared" warning.
        target=""
        note="> **Warning** — this board identifies \`$aud\` by root commit \`$attested\`, but no checkout with that root commit was found on this machine, so the root-commit check above cannot pass. Clone it, or record where it lives in this board's \`.locations.json\` (a \`locations\` map of root commit to path), then re-export."
        ;;
      bad-registry)
        target=""
        note="> **Warning** — this board's cross-repo registry could not be read (invalid JSON, or not the expected shape), so \`$aud\` was not resolved and the root-commit check above cannot pass. Re-run register-cross-repo-handoff's sync to regenerate it — the file is generated, so a hand-edit is the usual cause."
        ;;
      *)
        target=""
        note="> **Warning** — this board's cross-repo registry does not declare a repository named \`$aud\`${GROUP:+ in the \`$GROUP\` section}, so the root-commit check above cannot pass. Confirm by name and remote instead, and ask the sender before proceeding."
        ;;
    esac
  fi
  if [ -z "$target" ]; then
    [ -n "$note" ] || note="> **Warning** — the target repository was not reachable when this brief was rendered, so the root-commit check above cannot pass. Confirm by name and remote instead, and ask the sender before proceeding."
    printf '%s|%s|%s|%s|%s' "${aud:-unknown}" "unknown" "unverified" "unverified" "$(strip_pipes "$note")"
    return
  fi
  name="$(strip_pipes "$(basename "$target")")"
  raw="$(repo_origin_norm "$(git -C "$target" config --get remote.origin.url 2> /dev/null || echo "")")"
  provider="$(strip_pipes "$(repo_provider_of "$raw")")"
  origin="$(strip_pipes "$(repo_path_of "$raw")")"
  root="$(strip_pipes "$(repo_root_commit "$target")")"
  printf '%s|%s|%s|%s|%s' "$name" "$provider" "${origin:-unknown}" "${root:-unverified}" "$note"
}

# Resolve blocked_on and, for a bundle child, its siblings into readable lines. A brief's reader
# cannot query the board, so a bare id would be meaningless to them.
brief_dependencies() { # doc-path -> markdown lines
  local f="$1" b out="" bf
  b="$(meta "$f" blocked_on)"
  if [ -n "$b" ]; then
    case "$b" in
      external*) out="- Blocked on something off the board — $b" ;;
      *)
        bf="$(doc_of "$(resolve_id "$b")" 2> /dev/null || true)"
        if [ -n "$bf" ] && [ -f "$bf" ]; then
          out="- Blocked on \`$b\` — $(meta "$bf" title) (status — $(meta "$bf" status))"
        else
          out="- Blocked on \`$b\` (not resolvable from this board)"
        fi
        ;;
    esac
  fi
  [ -n "$out" ] || out="None. This unit stands alone."
  printf '%s' "$out"
}

export_one() {               # id doc to outdir branch do_claim force-secret-reason
  require_writable "$2" "$1" # stamps delegated_to/delegated_at on the doc
  local id="$1" f="$2" to="$3" outdir="$4" branch="$5" do_claim="$6" force_secret="${7:-}"
  local name provider origin root note
  IFS='|' read -r name provider origin root note <<< "$(brief_identity "$f")"
  [ -n "$branch" ] || branch="fix/$id"

  local dest_dir dest
  dest_dir="${outdir:-$(briefs_dir)}"
  mkdir -p "$dest_dir" || die "could not create $dest_dir"
  # Resolved to an absolute path (not left as whatever --out was typed, possibly relative) BEFORE
  # building dest — a relative --out otherwise gets stamped raw into the doc's `brief:` field
  # below, recording a pointer that only resolves from the exporter's transient cwd. abs_path needs
  # the directory to exist first, which mkdir -p above already guarantees.
  dest_dir="$(abs_path "$dest_dir")" || die "could not resolve $dest_dir"
  dest="$dest_dir/$id.brief.md"

  local tmpl
  tmpl="$(tmpl_path handoff-brief-template.md)"
  [ -f "$tmpl" ] || die "brief template missing from this board — re-run setup-handoff to update it"

  # OUTBOUND REDACTION (ADR 0005). The brief is rendered to a temp file and scanned BEFORE the
  # claim and before anything lands on the board, because this is the one path on which a secret
  # leaves the trust boundary. The inbound check on `import --result` used to be the only scan,
  # which is the wrong half: refusing a pasted secret on the way IN while splicing document
  # sections verbatim on the way OUT protects nothing.
  #
  # It scans the RENDERED brief, not the source doc — the brief is what ships, and it is also the
  # only artifact that carries the spliced Context/Where/Decisions/Verify together with the
  # identity block this command generates.
  local staged
  staged="$(mktemp)" || die "mktemp failed"
  render_tmpl "$tmpl" \
    "PLACEHOLDER_ID=$id" \
    "PLACEHOLDER_TITLE=$(meta "$f" title)" \
    "PLACEHOLDER_SEVERITY=$(meta "$f" severity)" \
    "PLACEHOLDER_REPO_NAME=$name" \
    "PLACEHOLDER_REPO_PROVIDER=$provider" \
    "PLACEHOLDER_REPO_ORIGIN=$origin" \
    "PLACEHOLDER_ROOT_COMMIT=$root" \
    "PLACEHOLDER_SOURCE_COMMIT=$(git -C "${REPO_DIR:-.}" rev-parse --short HEAD 2> /dev/null || echo unknown)" \
    "PLACEHOLDER_SOURCE_BRANCH=$(git -C "${REPO_DIR:-.}" rev-parse --abbrev-ref HEAD 2> /dev/null || echo unknown)" \
    "PLACEHOLDER_EXPORTED=$(today)" \
    "PLACEHOLDER_BRANCH=$branch" \
    "PLACEHOLDER_PREFLIGHT_NOTE=$note" \
    "PLACEHOLDER_CONTEXT=$(doc_section "$f" Context)" \
    "PLACEHOLDER_WHERE=$(doc_section "$f" Where)" \
    "PLACEHOLDER_DECISIONS=$(doc_section "$f" Decisions)" \
    "PLACEHOLDER_VERIFY=$(doc_section "$f" Verify)" \
    "PLACEHOLDER_DEPENDENCIES=$(brief_dependencies "$f")" \
    > "$staged" || {
    rm -f "$staged"
    die "could not render the brief for $id"
  }

  # ADR 0020 — always, not gated on this board's remote: a brief leaves the machine by
  # definition, and before the secret scan so a rewritten path can never itself trip it.
  machine_refs_file "$staged"

  local hits=""
  if hits="$(scan_secrets < "$staged")"; then
    if [ -z "$force_secret" ]; then
      rm -f "$staged"
      die_on_secret "the brief for $id" "$hits"
    fi
  fi

  # Claim BEFORE writing the brief or stamping the doc, not after. cmd_claim dies when the id is
  # already leased by a concurrent agent — precisely the race the lease exists to prevent — and
  # die exits the whole process. Claiming first means that death leaves the doc and filesystem
  # untouched; claiming last would leave a doc reading "delegated", an Activity entry saying the
  # export happened, and a brief on disk, with no lease actually held.
  #
  # A lease THIS session already holds is the one case that must not die: cmd_claim does not
  # special-case self-ownership, so `claim X` then `export X` — the obvious order, investigate then
  # delegate — refused on the caller's own lease, and inside a bundle it aborted the whole export.
  # Extending is what a claim would have achieved anyway: the point of claiming at export time is
  # "a live lease I own for as long as this is out", and renewing the held one reaches exactly that,
  # with a full TTL, rather than leaving a lease that may expire while the brief is with an
  # executor. Foreign and expired leases keep going through cmd_claim untouched.
  if [ "$do_claim" -eq 1 ]; then
    if lease_is_mine "$id"; then
      cmd_touch "$id" > /dev/null
      # stderr, not stdout: export_bundle sends export_one's stdout to /dev/null, and "I kept your
      # lease instead of taking a new one" is exactly the kind of thing that must not vanish there.
      echo "🔒 $id was already leased by this session — lease extended, not re-claimed." >&2
    else
      cmd_claim "$id" "delegated to ${to:-an external executor}" > /dev/null
    fi
  fi

  cat "$staged" > "$dest" || {
    rm -f "$staged"
    die "could not write $dest"
  }
  rm -f "$staged"

  if [ -n "$force_secret" ] && [ -n "$hits" ]; then
    log_secret_override "$f" "outbound secret-scan OVERRIDDEN on export" "$hits" "$force_secret"
    echo "⚠️  Outbound secret scan overridden — recorded on $id's activity log." >&2
  fi

  set_field "$f" delegated_to "${to:-unassigned}"
  set_field "$f" delegated_at "$(today)"
  # A standalone shared board (no repo of its own — see register-cross-repo-handoff) runs with
  # REPO_DIR empty. Without this guard, "${dest#"$REPO_DIR"/}" degrades to "${dest#/}", which only
  # strips the leading slash off an absolute path — storing something no reader can resolve.
  if [ -n "$REPO_DIR" ]; then
    set_field "$f" brief "${dest#"$REPO_DIR"/}"
  else
    set_field "$f" brief "$dest"
  fi
  log_activity "$f" "exported as a brief for ${to:-an external executor}"

  echo "Wrote $dest"
  echo "🔒 Before committing — redact secrets/keys/PII, then commit the brief so the executor can pull it."
  cmd_index
}

export_bundle() { # id doc to outdir do_claim force-secret-reason
  local id="$1" f="$2" to="$3" outdir="$4" do_claim="$5" force_secret="${6:-}"
  local dest_dir cover kid kf n=0
  local kids

  # Pre-flight EVERY child before writing anything — no cover file, no brief, no claim, no stamp.
  # A live foreign lease used to surface only mid-fan-out: child 1 got claimed and stamped, child 2
  # died on cmd_claim, `cmd_index` never ran, and the operator was left staring at a lease error
  # with child 1 out to a contractor who was sent nothing and no reverse operation to undo it
  # (finding 5, final whole-branch review — re-running just died again until the foreign lease
  # cleared). Refuse the WHOLE export up front instead. A child with no doc at all is not part of
  # this check — it was never claimable to begin with, and stays a per-child skip-with-warning
  # below, same as before.
  #
  # A child leased by THIS session is not a blocker. Refusing there was a dead end: the orchestrator
  # would have to release its own lease first, or pass --no-claim, which drops leasing for every
  # child in the run. export_one extends a self-held lease instead of re-claiming it, so the export
  # is still fully leased when it completes.
  kids="$(children_of "$f")"

  # Restricted children, checked in the SAME pre-flight as live foreign leases and for the same
  # reason: a refusal that lands mid-fan-out has already written a cover file and shipped half the
  # bundle. cmd_export already refused a restricted PARENT; this is the child that carries the
  # sensitive half of an otherwise ordinary bundle, and exporting the other five briefs while
  # refusing that one would hand an executor a bundle whose cover names a unit they were never
  # sent — so the whole export is refused, not the child.
  local restricted=""
  while IFS= read -r kid; do
    [ -n "$kid" ] || continue
    kf="$(doc_of "$kid" 2> /dev/null || true)"
    [ -n "$kf" ] && [ -f "$kf" ] || continue
    if is_restricted "$kf"; then restricted="${restricted:+$restricted }$kid"; fi
  done <<< "$kids"
  [ -z "$restricted" ] \
    || die "cannot export bundle $id — restricted child(ren):$restricted. A restricted unit is never handed to an external executor. Nothing was written; split it out of the bundle, or do the whole bundle in a session with board access."

  if [ "$do_claim" -eq 1 ]; then
    local busy=""
    while IFS= read -r kid; do
      [ -n "$kid" ] || continue
      kf="$(doc_of "$kid" 2> /dev/null || true)"
      [ -n "$kf" ] && [ -f "$kf" ] || continue
      local kind owner exp
      IFS='|' read -r kind owner exp <<< "$(lock_state "$(lock_key "$kid")")"
      if [ "$kind" = "held" ] && ! lease_is_mine "$kid"; then
        busy="$busy $kid(held by $owner until $(human "$exp"))"
      fi
    done <<< "$kids"
    [ -z "$busy" ] \
      || die "cannot export bundle $id — a child has a live lease held by another session and cannot be claimed:$busy. Nothing was written; wait for the lease to clear or ask the holder, then re-run.$(advisory_hint)"
  fi

  dest_dir="${outdir:-$(briefs_dir)}"
  mkdir -p "$dest_dir" || die "could not create $dest_dir"
  # Same absolute-path fix as export_one — see there for why a relative --out cannot be stamped raw.
  dest_dir="$(abs_path "$dest_dir")" || die "could not resolve $dest_dir"
  cover="$dest_dir/$id.cover.md"
  {
    echo "# Bundle — $(meta "$f" title)"
    echo
    echo "You have been given a bundle of related units. Each has its own brief; read this first."
    echo
    echo "## Bundle"
    echo
    doc_section "$f" Bundle
    echo
    echo "## Sequencing"
    echo
    doc_section "$f" Sequencing
    echo
    echo "## Units"
    echo
  } > "$cover"

  while IFS= read -r kid; do
    [ -n "$kid" ] || continue
    kf="$(doc_of "$kid" 2> /dev/null || true)"
    if [ -z "$kf" ] || [ ! -f "$kf" ]; then
      echo "⚠️  child $kid has no doc on this board — skipped" >&2
      continue
    fi
    export_one "$kid" "$kf" "$to" "$dest_dir" "" "$do_claim" "$force_secret" > /dev/null
    echo "- \`$kid\` — $(meta "$kf" title) — brief at \`$kid.brief.md\`" >> "$cover"
    n=$((n + 1))
  done <<< "$kids"

  # The parent used to gain no delegated_to/delegated_at/brief and no Activity entry, so `list`
  # showed no recipient for the bundle and repair-handoff's orphaned-delegation check (which keys
  # on delegated_at) was structurally blind to an abandoned bundle export (finding 4). Stamp it
  # the same way export_one stamps a coordination doc, pointing brief: at the cover.
  if [ -n "$REPO_DIR" ]; then
    set_field "$f" brief "${cover#"$REPO_DIR"/}"
  else
    set_field "$f" brief "$cover"
  fi
  set_field "$f" delegated_to "${to:-unassigned}"
  set_field "$f" delegated_at "$(today)"
  log_activity "$f" "exported as a bundle cover for ${to:-an external executor} ($n child brief(s))"

  echo "Wrote $cover and $n child brief(s) in $dest_dir"
  echo "🔒 Before committing — redact secrets/keys/PII, then commit the briefs."
  cmd_index
}

cmd_list() {
  # EVERY argument is checked, not just $1. The old form read `$1` alone, so an unknown flag was
  # ignored outright — and one in second position stayed invisible even when the first was valid.
  # `list` only reads, so the cost was a wrong VIEW rather than a damaged doc, but it is the same
  # rule as the four write commands and it is applied here for the same reason.
  local VERBOSE=0 want_ref="" want_tracker=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --verbose | -v) VERBOSE=1 ;;
      --tracker) want_tracker=1 ;;
      --ref)
        require_value --ref "$#" "${2:-}"
        want_ref="$(fold_colons "$2")"
        shift
        ;;
      *) reject_unknown_flag "$1" ;;
    esac
    shift
  done
  # A grouped board with no section in scope lists NOTHING: every doc lives under its section, so
  # each_doc's glob matches nothing. An empty table at exit 0 makes "there is no work" and "you
  # cannot see the work" indistinguishable — and this is the reachable case, not a corner one,
  # because a `handoff list` typed by hand inherits no HANDOFF_GROUP (only the tool hooks carry it).
  # Silence here is what let a member repo read its own board as empty. Notice goes to stderr so
  # stdout stays exactly the table its readers parse.
  if board_is_grouped && [ -z "$GROUP" ]; then
    echo "handoff: this board is sectioned ($BOARD_GROUPS) and no HANDOFF_GROUP is set," >&2
    echo "         so nothing below is scoped to you. Re-run as: HANDOFF_GROUP=<section> handoff list" >&2
  fi
  # Tracker drift (ADR 0014) is READ, not computed: the last mirror run left a generated report, and
  # `list` stays offline. `--tracker` is the opt-in live check — it asks the tracker now, at the cost
  # of a round trip, and still writes nothing.
  local drift=""
  if [ "$want_tracker" = 1 ]; then
    drift="$(drift_live)" || return 1
    if [ -n "$drift" ]; then
      echo "Checked the tracker live: $(printf '%s\n' "$drift" | grep -c .) handoff(s) diverge from it." >&2
    else
      echo "Checked the tracker live: nothing diverges from it." >&2
    fi
  else
    drift="$(drift_rows)"
  fi
  # ENV is on the session banner deliberately. "Which stage is this?" is the question that decides
  # how carefully to move, and it was previously answerable only by opening the doc.
  printf '%-44s %-9s %-14s %-8s %-8s %s\n' ID STATUS AUDIENCE ENV SEVERITY LOCK
  printf '%-44s %-9s %-14s %-8s %-8s %s\n' "$(printf '%.44s' "--------------------------------------------")" \
    "---------" "--------------" "--------" "--------" "----"
  local standalone="" orchestrators=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    local base
    base="$(basename "$f" .md)"
    case "$base" in INDEX | README | handoff-doc-template | handoff-standalone-template | handoff-orchestrator-template) continue ;; esac
    # --ref narrows to one ticket's work. Every doc type is filtered alike: a bundle can map to an
    # epic just as a coordination doc maps to a story.
    [ -z "$want_ref" ] || [ "$(meta "$f" external_ref)" = "$want_ref" ] || continue
    # A bundle is mirrored like any other doc, so a bundle's issue can drift too.
    local dnote
    dnote="$(drift_note "$drift" "$f" "$base")"
    if is_orchestrator "$f"; then
      local prog done total out
      prog="$(child_progress "$f")"
      done="${prog%%|*}"
      total="$(printf '%s' "$prog" | cut -d'|' -f2)"
      out="${prog#*|*|}"
      [ "$VERBOSE" = 1 ] || out="$(truncate_roster "$out")"
      orchestrators="${orchestrators}$(printf '%-44s %-9s %s' "$base" "$done/$total done" "${out:-— all children done}$dnote")"$'\n'
      continue
    fi
    if is_standalone "$f"; then
      standalone="${standalone}$(printf '%-44s %-9s %s' "$base" "$(meta "$f" status)" "$(meta "$f" title)")"$'\n'
      continue
    fi
    local kind owner exp
    IFS='|' read -r kind owner exp <<< "$(lock_state "$base")"
    local lock='—'
    case "$kind" in
      held) lock="🔒 $owner until $(human "$exp")" ;;
      expired) lock="⚠️  STALE $owner (expired $(human "$exp")) — reclaimable" ;;
    esac
    # Delegation and review markers. A delegated row is NOT free even though its lease may look
    # ordinary, and a review-pending row is waiting on the reader rather than on the executor —
    # both are things a board reader acts on differently.
    warn_schema_forward "$f"
    local deleg review_flag extra=""
    deleg="$(meta "$f" delegated_to)"
    review_flag="$(meta "$f" review)"
    [ -n "$deleg" ] && [ "$(meta "$f" review)" != "done" ] && extra="$extra  → $deleg"
    # Naming the reviewer when the doc names one: `⇤ review` says work is waiting, and the handle
    # says on whom. Appended to the same marker rather than given a column, because it is present on
    # a minority of rows and an empty column on every other one buys nothing.
    if [ "$review_flag" = "pending" ]; then
      local rvw_h
      rvw_h="$(meta "$f" reviewer)"
      extra="$extra  ⇤ review${rvw_h:+ → $rvw_h}"
    fi
    # A cross-board wait (ADR 0018): when blocked_on names a recognised "external — HOST/OWNER/
    # REPO#ID" reference and that board is cloned on this machine (via the developer's own `boards`
    # map), show its current status next to the entry — read-only, never fetched, never copied.
    # `list` never showed blocked_on before this, and still does not for ordinary free text: the
    # blocker appears only when it carries at least one recognised cross-board reference, resolved
    # or not, so a board of free-text blockers lists exactly as it always has.
    local bo
    bo="$(meta "$f" blocked_on)"
    case "$bo" in
      *'external — '*/*/*'#'*) extra="$extra  ⛔ $(annotate_blocked_on "$bo")" ;;
    esac
    extra="$extra$dnote"
    printf '%-44s %-9s %-14s %-8s %-8s %s\n' \
      "$base" "$(meta "$f" status)" "$(meta "$f" audience)" "$(doc_env "$f")" "$(meta "$f" severity)" "$lock$extra"
  done < <(each_doc | while IFS= read -r one; do [ -n "$one" ] && printf '%s\t%s\n' "$(env_rank "$(doc_env "$one")")" "$one"; done | sort -k1,1n -k2,2 | cut -f2-)
  if [ -n "$orchestrators" ]; then
    printf '\nOrchestrators (bundles — progress derived from children, no claim needed):\n'
    printf '%-44s %-9s %s\n' ID PROGRESS OUTSTANDING
    printf '%s' "$orchestrators"
  fi
  if [ -n "$standalone" ]; then
    printf '\nStandalone / reference (no claim needed):\n'
    printf '%-44s %-9s %s\n' ID STATUS TITLE
    printf '%s' "$standalone"
  fi
}

# --- push-CAS lease transport (ADR 0002) -----------------------------------------------
# `claim` is STRICT and `release` is OPTIMISTIC, and the asymmetry is the design, not an
# inconsistency. A claim asserts something about the FUTURE ("nobody else may work this"), and an
# assertion made without seeing the other machines' leases is not mutual exclusion — it is a local
# file. A release records something that ALREADY HAPPENED, so refusing it offline would strand a
# lease that its holder has already stopped working, which is the one failure the board exists to
# prevent. Reads never touch the network at all.

# Fetch and fast-forward so the local view of the leases is current. Never merge, never rebase: a
# board whose history has genuinely diverged is a repair job, and papering over it on the claim
# path is how two machines end up both believing they hold the same lease.
board_sync_or_die() {
  local br
  board_git fetch --quiet || die "cannot reach the board's remote, so this claim cannot be safe.
       'claim' needs the network to see other machines' leases (ADR 0002).
       Reconnect and retry — 'release' still works offline."
  board_git rev-parse --verify --quiet HEAD > /dev/null \
    || die "the board has no commits yet, so there is nothing to claim against.
       Re-run setup-handoff on it — the installer commits the board's machinery."
  br="$(board_git rev-parse --abbrev-ref HEAD)"
  [ -n "$br" ] && [ "$br" != "HEAD" ] || die "the board is in detached HEAD — check out its branch before claiming."
  board_git rev-parse --verify --quiet '@{upstream}' > /dev/null || return 0 # no upstream yet; the first push sets it
  drop_generated_indexes
  board_git merge --ff-only --quiet '@{upstream}' && return 0
  die "the board's local history has diverged from its remote, or an uncommitted change is in the way.
       A claim will not merge that for you — sort it out in $DIR, then retry."
}

# Every uncommitted change git reports on the board, as a board-relative path. `status --porcelain`
# rather than `diff`, because a freshly generated INDEX.md on a board whose first claim has not
# landed yet is UNTRACKED, and `diff` cannot see an untracked file.
board_changed_paths() { # -> board-relative paths, one per line
  local line rel
  while IFS= read -r line; do
    rel="${line:3}"
    rel="${rel##* -> }" # a rename (a `done` release archives its doc through git mv)
    rel="${rel%\"}"
    rel="${rel#\"}"
    [ -n "$rel" ] && printf '%s\n' "$rel"
  done < <(board_git status --porcelain --untracked-files=all)
}

# Is this path one of the generated index files — any section's sub-index or the board-root
# roll-up? Every spelling is listed, flat and both grouped layouts: a prefix board's sub-index is
# INDEX-<group>.md, and while that one was missing its regeneration was the uncommitted file the
# next claim tripped over.
is_generated_index() { # board-relative path
  case "$1" in INDEX.md | INDEX-*.md | */INDEX.md) return 0 ;; esac
  return 1
}

# What a lease commit must carry with it. These are DERIVED files: committing them alongside the
# lease is safe, and leaving them behind is not — an uncommitted generated file makes the next
# fast-forward refuse, so the board's own bookkeeping would take the claim path down. Orchestrator
# docs are included because a claim changes the Lease column of every bundle table the claimed doc
# appears in.
#
# Only THIS section's generated files (ADR 0019). Sweeping in every section's index and the
# board-root roll-up made two claims of unrelated handoffs in different groups rewrite the same
# files, so every write on the board contended with every other. The roll-up is `handoff index`'s
# alone now, and another section's files are that section's commits' business.
board_generated_dirty() { # -> board-relative paths, one per line
  local rel own_index own_drift
  own_index="$(sec_index)"
  own_index="${own_index#"$DIR"/}"
  own_drift="$(drift_file)"
  own_drift="${own_drift#"$DIR"/}"
  while IFS= read -r rel; do
    case "$rel" in
      "$own_index" | "$own_drift")
        printf '%s\n' "$rel"
        continue
        ;;
      INDEX.md | INDEX-*.md | */INDEX.md | TRACKER-DRIFT.md | TRACKER-DRIFT-*.md | */TRACKER-DRIFT.md)
        continue # the roll-up, or another section's — never part of this section's lease commit
        ;;
    esac
    [ -f "$DIR/$rel" ] && is_orchestrator "$DIR/$rel" && printf '%s\n' "$rel"
  done < <(board_changed_paths)
}

# Drop local changes to generated INDEX files before fast-forwarding onto the remote. They are
# derived: rebuilding one loses nothing, while a stale local copy — the roll-up a board-level
# `index` left behind, or a copy a lost race had staged — makes the fast-forward refuse over a file
# nobody wrote by hand (ADR 0019: generated files are never merged, only rebuilt). Tracker drift
# reports are left alone: they are only rewritten by a mirror run, so a local one is real news.
drop_generated_indexes() {
  local rel
  while IFS= read -r rel; do
    is_generated_index "$rel" || continue
    if board_git cat-file -e "HEAD:$rel"; then
      board_git checkout --quiet HEAD -- "$rel"
    else
      board_git reset --quiet -- "$rel" # never committed: unstage it and let the rebuild rewrite it
    fi
  done < <(board_changed_paths)
}

# ADR 0019: how many times a lease commit is pushed before the remote's refusal is believed. Three,
# because a lost race among a busy board's agents clears within one or two retries, while a remote
# that refuses every time is an outage that a longer loop would only hide.
LEASE_PUSH_ATTEMPTS=3

# After a rejected push: take the remote's new tip, keeping whatever is staged for our own commit.
lease_resync() { # -> 0 when the local branch now sits on the remote's tip
  board_git fetch --quiet || return 1
  drop_generated_indexes
  board_git merge --ff-only --quiet '@{upstream}'
}

# ADR 0019: a lease commit regenerates only its own section — the sub-index and the bundle tables
# that read from it. The board-root roll-up belongs to `handoff index` (or CI) alone; see
# board_generated_dirty for why. A board with no remote has no lease commit and no race, so it
# keeps the full regeneration it always had.
lease_index() {
  if ! leases_shared; then
    cmd_index
    return
  fi
  if board_is_grouped && [ -z "$GROUP" ]; then return 0; fi
  refresh_children_blocks
  write_section_index
  echo "Wrote $(sec_index)"
}

# The compare-and-swap itself. Commit the lease, push it, and let the REMOTE decide who won: a
# rejected non-fast-forward push means another machine committed a lease against the same parent
# first. There is no race window left to close by hand — this is the primitive git already gives
# every branch, applied to a file whose whole purpose is to be claimed exactly once.
lease_commit_push() { # key subject [doc-path] -> 0 won, non-zero lost or could not record
  local key="$1" subject="$2" doc="${3:-}" rel
  board_git add -- "$LOCKS/$key" || return 1
  [ -n "$doc" ] && [ -e "$doc" ] && board_git add -- "$doc"
  # ensure_lease_visibility may have just rewritten this; leaving it behind means the repair is
  # re-announced on every claim and the board goes on ignoring leases for everyone else.
  [ -f "$DIR/.gitignore" ] && board_git add -- "$DIR/.gitignore"
  while IFS= read -r rel; do
    [ -n "$rel" ] && board_git add -- "$DIR/$rel"
  done < <(board_generated_dirty)
  board_git commit --quiet -m "$subject" || return 1
  board_git push --quiet "$(board_remote)" HEAD || return 1
  return 0
}

# Losing the CAS is the NORMAL outcome of a race, not an error state, so the undo has to be
# narrow and safe. `reset --soft` keeps the worktree; clear_lock removes the owner file we just
# wrote; re-staging that one path brings the index back in line with HEAD. There is no
# `reset --hard` and no recursive delete anywhere on this path — a board holds irreplaceable
# documents, and the generated files swept into the commit are regenerated by the next index run.
lease_rollback() { # key
  board_git reset --soft --quiet HEAD~1
  clear_lock "$1"
  board_git add --all -- "$LOCKS/$1"
}

# Release's transport. Every failure here is a WARNING: the release already happened in the
# frontmatter, and the lease is already gone locally. Saying "release failed" would be false and
# would invite a retry that has nothing left to do.
release_commit_push() { # subject [doc-path]
  leases_shared || return 0
  local rel doc="${2:-}"
  board_git add --all -- "$LOCKS" 2> /dev/null
  [ -f "$DIR/.gitignore" ] && board_git add -- "$DIR/.gitignore"
  # `done` archives the doc through `git mv`, which is already staged; an open/blocked release only
  # rewrote its frontmatter, which is not. Stage whichever happened — the doc's status IS the state
  # other machines came here to read.
  [ -n "$doc" ] && [ -e "$doc" ] && board_git add -- "$doc"
  while IFS= read -r rel; do
    [ -n "$rel" ] && board_git add -- "$DIR/$rel"
  done < <(board_generated_dirty)
  board_git diff --cached --quiet && return 0 # nothing of ours to record
  if ! board_git commit --quiet -m "$1"; then
    echo "⚠️  The release is recorded in the doc, but it could not be committed to the board."
    echo "    Commit and push $DIR yourself so other machines see the lease is free."
    return 0
  fi
  # A rejected push is retried like a claim's (ADR 0019): take the remote's new tip and commit
  # again on top of it. There is no lease to re-check — this lease was ours and is already gone.
  local attempt=1
  until board_git push --quiet "$(board_remote)" HEAD; do
    if [ "$attempt" -ge "$LEASE_PUSH_ATTEMPTS" ] || ! release_recommit "$1" "$doc"; then
      echo "⚠️  Released locally and committed, but the push did not land (offline?)."
      echo "    Other machines still see this lease as held until you push $DIR."
      return 0
    fi
    attempt=$((attempt + 1))
  done
  return 0
}

# Move a release commit that lost its push onto the remote's new tip. On any failure the commit is
# put back exactly as it was, so the release stays recorded locally and the caller only warns.
release_recommit() { # subject doc
  local rel
  board_git reset --soft --quiet HEAD~1 || return 1
  if ! lease_resync; then
    board_git commit --quiet -m "$1"
    return 1
  fi
  lease_index > /dev/null
  [ -n "$2" ] && [ -e "$2" ] && board_git add -- "$2"
  while IFS= read -r rel; do
    [ -n "$rel" ] && board_git add -- "$DIR/$rel"
  done < <(board_generated_dirty)
  board_git commit --quiet -m "$1"
}

warn_open_dependencies() { # doc-path id
  local f="$1" id="$2" dep df open=""
  while IFS= read -r dep; do
    [ -n "$dep" ] || continue
    if [ -f "$(doc_file "$dep")" ]; then
      df="$(doc_file "$dep")"
    elif [ -f "$(arch_file "$dep")" ]; then
      continue # archived means landed
    else
      open="$open\n  - $dep (not filed on this board yet)"
      continue
    fi
    [ "$(meta "$df" status)" = "done" ] || open="$open\n  - $dep ($(meta "$df" status)) — $(meta "$df" title)"
  done <<< "$(depends_of "$f")"
  [ -n "$open" ] || return 0
  printf '⚠️  %s declares prerequisites that have not landed:%b\n' "$id" "$open"
  echo "    Claiming anyway — depends_on is advisory. If you are working around one, say so in the doc."
}

cmd_claim() {
  local id="${1:?usage: handoff claim <id> [note]}"
  shift || true
  # accept the short or full id, in any casing; the lease is keyed on the resolved stem
  local raw_id="$id"
  id="$(resolve_id "$id")" || die "unusable id: '$raw_id' (needs at least one letter or digit)"
  # Every remaining argument is note text, so each one is checked before it becomes note text.
  local _a
  for _a in "$@"; do reject_unknown_flag "$_a" "the note is a trailing positional, not a flag"; done
  local note="${*:-}"
  # Resolve the doc BEFORE deriving the lock key. The key is a pure function of the id, so an
  # unresolvable id would otherwise mint a lease for a doc that does not exist.
  local f doc_path
  f="$(doc_of "$id")" || no_such "$id"
  doc_path="$f" # survives cmd_index, which walks every doc on the board
  local key
  key="$(lock_key "$id")" # the lock is keyed on the doc's stem, unique board-wide across sections
  require_writable "$f" "$id"
  is_standalone "$f" && die "$id is a standalone/reference handoff — no lease needed; just edit it."
  is_orchestrator "$f" && die "$id is an orchestrator (a bundle index) — no lease needed; claim one of its children instead."
  [ "$(meta "$f" status)" = "done" ] && die "$id is already done — nothing to claim"

  # ADVISORY, and deliberately so (ADR 0004). `depends_on` is about whether work can START, and
  # work legitimately starts out of order — a production incident gets fixed before the
  # pre-production backfill. A tool that refused the claim here would be routed around, and a rule
  # people route around protects nothing. So: say it, then get out of the way.
  warn_open_dependencies "$f" "$id"

  # On a shared board the lease state worth checking is the REMOTE's, so fetch before reading it.
  # Both of these are no-ops on a local-only board and cost it nothing.
  if leases_shared; then
    board_sync_or_die
    ensure_lease_visibility
  fi

  local kind owner exp
  IFS='|' read -r kind owner exp <<< "$(lock_state "$key")"
  if [ "$kind" = "held" ]; then
    die "$id is CLAIMED by $owner until $(human "$exp"). Do not work on it — pick another handoff, or ask $owner."
  fi

  # Atomic: mkdir fails if the directory already exists, so two racing agents
  # cannot both win the lease. Do not replace this with a frontmatter edit.
  # .locks/ itself is gitignored and may not exist on a fresh install — create the
  # parent (non-atomic, fine) so the per-id mkdir (atomic, the real lock) can run.
  mkdir -p "$LOCKS"
  if ! mkdir "$LOCKS/$key" 2> /dev/null; then
    die "$id was just claimed by someone else — re-run 'handoff list'"
  fi

  local me sess exp_new attempt=1
  me="$(whoami_id)"
  sess="$(session_id)"
  if [ "$kind" = "expired" ]; then
    echo "⚠️  Took over an EXPIRED lease from $owner (expired $(human "$exp"))."
    log_activity "$f" "lease taken over from $owner (expired $(human "$exp")) by $me"
  fi

  # The compare-and-swap. The local `mkdir` above already excluded every other process on THIS
  # machine; the push is what excludes the other machines. The index runs first so the generated
  # files travel in the same commit — see board_generated_dirty for why they cannot be left behind.
  #
  # A rejected push is retried (ADR 0019), because on a busy board it usually means someone else
  # landed UNRELATED work first: the remote moved, not the lease. Each retry takes the remote's
  # new tip and reads the lease again before writing anything, so losing the race for this very
  # handoff still refuses exactly as it always has. The generated files are rebuilt on the new tip,
  # never merged — they are derived, so there is nothing in them to reconcile.
  while :; do
    exp_new="$(($(now) + TTL_HOURS * 3600))"
    {
      echo "owner=$me"
      echo "session=$sess" # raw id — the enforcement gate matches this against the tool payload
      echo "claimed=$(now)"
      echo "expires=$exp_new"
      # The reader recomputes expiry from this lease's COMMIT time on a shared board, so it needs the
      # claimer's TTL rather than its own — two members may configure different ttlHours.
      echo "ttl_hours=$TTL_HOURS"
      echo "note=$note"
    } > "$LOCKS/$key/owner"
    lease_index
    leases_shared || break
    lease_commit_push "$key" "handoff: claim $id" "$doc_path" && break

    lease_rollback "$key"
    local synced=0
    lease_resync && synced=1
    IFS='|' read -r kind owner exp <<< "$(lock_state "$key")"
    [ "$kind" = "held" ] \
      && die "$id was claimed by $owner first — their push landed before yours. Nothing was claimed here. Pick another handoff, or ask $owner."
    [ "$synced" = 1 ] && [ "$attempt" -lt "$LEASE_PUSH_ATTEMPTS" ] \
      || die "could not record the claim on the board's remote, so nothing was claimed. Re-run 'handoff list' and retry."
    attempt=$((attempt + 1))
    mkdir -p "$LOCKS"
    mkdir "$LOCKS/$key" 2> /dev/null || die "$id was just claimed by someone else — re-run 'handoff list'"
  done

  echo "🔒 Claimed $id as $me for ${TTL_HOURS}h (until $(human "$exp_new")). Release it when you stop."
  # After the claim, not before: the banner is a HANDLING instruction for whoever is about to do
  # the work, and printing it on a claim that then lost a race would be telling nobody anything.
  # `$doc_path`, not `$f`: cmd_index ran above and walks every doc on the board, and this is the
  # same dynamic-scope hazard the doc_path copy was introduced for.
  # `if`, not `cond && action`: this is the LAST statement in the function, so `&&` handed the
  # function — and the process — the CONDITION's exit status. An ordinary claim on a non-restricted
  # doc therefore exited 1 while succeeding in every observable way, which is the worst shape a bug
  # can take here: every hook, script and CI step that checks `handoff claim`'s exit code read a
  # successful claim as a failure, and the one case that exited 0 was the restricted one.
  if is_restricted "$doc_path"; then restricted_banner "$id"; fi
}

cmd_touch() {
  local id="${1:?usage: handoff touch <id>}"
  id="$(resolve_id "$id")" || die "unusable id: '$1' (needs at least one letter or digit)"
  local tf
  tf="$(doc_of "$id" 2> /dev/null)" && require_writable "$tf" "$id"
  local key
  key="$(lock_key "$id")"
  local kind owner exp
  IFS='|' read -r kind owner exp <<< "$(lock_state "$key")"
  [ "$kind" = "free" ] && die "$id is not claimed"
  # rewrite the lease with a fresh expiry, preserving the other fields
  local t
  t="$(mktemp)"
  grep -v '^expires=' "$LOCKS/$key/owner" > "$t"
  echo "expires=$(($(now) + TTL_HOURS * 3600))" >> "$t"
  cat "$t" > "$LOCKS/$key/owner"
  rm -f "$t"
  # On a shared board the deadline other machines read is the lease's COMMIT time, so an extension
  # that is not committed extends nothing outside this checkout. Optimistic, like a release: if the
  # push cannot land, the extension is still real locally and saying "touch failed" would be false.
  release_commit_push "handoff: extend lease on $id" "$(doc_of "$id" 2> /dev/null)"
  echo "Lease on $id extended ${TTL_HOURS}h."
}

# ADR 0011 — a handoff has ONE board of record. `move` transfers it: the doc lands on the target
# board (through the target's own `import`, so the target's layout, section and schema gates all
# apply), and the source keeps an archived one-line pointer. Never a copy — two copies of one
# handoff is the second writer ADR 0002 rules out.
#
# The trust boundary is read from the boards' git remotes, not declared: same host and owner, or a
# target with no remote (material stays on this machine), proceeds. Anything else refuses until the
# caller names the target's host/owner with --to-remote — naming it, not a bare yes, is the consent.
# A `sensitivity: restricted` doc never crosses a differing remote, named or not — on an outbound
# path an override would be the whole control. Within one host and owner it moves, since the
# material does not leave the trust boundary (ADR 0011).
board_origin_norm() { # board-dir -> host/owner/repo of its configured origin, or nothing
  local b="$1" name url
  name="$(handoff_board_remote "$b")"
  [ -n "$name" ] || return 0
  # The CONFIGURED url, never `remote get-url`: an insteadOf rewrite would report where git fetches
  # from rather than which host and owner the board says it belongs to.
  url="$(handoff_board_git "$b" config --get "remote.$name.url")"
  [ -n "$url" ] || return 0
  repo_origin_norm "$url"
}

board_owner_key() { # board-dir -> "host/owner" of its configured origin, or nothing
  board_origin_norm "$1" | cut -d/ -f1-2
}

# ADR 0018 — a CHILD board declares, in its own committed config, the board it is narrower than.
# The parent's members never learn a same-owner child's name, because nothing on the parent says
# it. A child under ANOTHER owner is the one case the parent must also say yes to, under
# `acceptChildren`: a declaration made only on the child's side would let any board anywhere name
# a parent and receive its work unannounced.
board_config_value() { # board-dir key -> a string value, or one list item per line
  [ -f "$1/handoff.json" ] && command -v python3 > /dev/null 2>&1 || return 0
  python3 -c 'import json,sys
try: d = json.load(open(sys.argv[1]))
except Exception: raise SystemExit(0)
v = d.get(sys.argv[2]) if isinstance(d, dict) else None
if isinstance(v, str): print(v)
elif isinstance(v, list):
    for x in v:
        if isinstance(x, str): print(x)' "$1/handoff.json" "$2" 2> /dev/null
}

board_parent() { # board-dir -> host/owner/repo of the parent it declares, or nothing
  local p
  p="$(board_config_value "$1" parent | head -1)"
  [ -n "$p" ] && repo_origin_norm "$p"
}

board_accepts_child() { # parent-board-dir child-host/owner/repo -> 0 when the parent lists it
  local c
  while IFS= read -r c; do
    [ -n "$c" ] && [ "$(repo_origin_norm "$c")" = "$2" ] && return 0
  done < <(board_config_value "$1" acceptChildren)
  return 1
}

# ADR 0018 — "cross-board waits have a recognised form": `blocked_on: external — HOST/OWNER/REPO#ID`
# (several may be joined by "; "). The developer's own `boards` map, BOARDS_MAP (from
# handoff.local.json ONLY — see config.sh), names where such a board sits on THIS machine. No other
# discovery ever happens: no scanning a workspace, no guessing from a sibling directory. A wrong
# guess here would read some unrelated repository as though it spoke for another board.
board_mapped_path() { # host/owner/repo -> the developer's mapped path for that board, or nothing
  [ -n "${BOARDS_MAP:-}" ] && command -v python3 > /dev/null 2>&1 || return 0
  python3 -c 'import json, sys
try:
    d = json.loads(sys.argv[1])
except Exception:
    raise SystemExit(0)
v = d.get(sys.argv[2]) if isinstance(d, dict) else None
if isinstance(v, str) and v:
    sys.stdout.write(v)' "$BOARDS_MAP" "$1" 2> /dev/null
}

# Resolve one recognised cross-board reference to the status of ID on that board, when — and only
# when — BOTH hold: the developer's map names a clone of it, AND that clone's OWN git remote really
# normalizes to the key the reference names (board_origin_norm, defined above). A stale or wrong
# mapping is never trusted to speak for another board; the second check is what keeps the map a
# HINT rather than a claim this function takes on faith.
#
# Read-only, always — no git network call is made here (no fetch/pull/ls-remote/clone; the
# worktree is read exactly as it sits on disk, which is also why the answer can be stale between
# someone else's push and this developer's next pull. Nothing is fetched to make it fresher, and
# nothing on the mapped board is ever written).
#
# Searches every section shape (flat, subfolder, prefix) because THIS board — the one asking — has
# no way to know how board B is laid out, and sourcing B's own config.sh to find out would run a
# second board's shell inside this one's process for a read `list` never needed to make. A glob
# across all three shapes costs nothing B's own CLI would not already pay, and needs no shell at all.
external_ref_status() { # host/owner/repo id -> status word ("not on that board" when absent), or
                         # nothing when the reference cannot be trusted (unmapped or mismatched)
  local key="$1" want="$2" path p st
  # annotate_blocked_on (the only caller) runs under `set -f` while it splits blocked_on on ";", and
  # that shell option survives into this command-substitution subshell — globbing MUST be back on
  # here, or every subfolder/prefix pattern below stays literal and a real doc reads as absent.
  set +f
  path="$(board_mapped_path "$key")"
  [ -n "$path" ] && [ -d "$path" ] || return 0
  [ "$(board_origin_norm "$path" 2> /dev/null)" = "$key" ] || return 0
  want="$(norm_id "$want" 2> /dev/null)" || return 0
  for p in "$path/$want.md" "$path"/*/"$want.md" "$path"/*--"$want.md"; do
    [ -f "$p" ] || continue
    printf '%s' "$(meta "$p" status)"
    return 0
  done
  for p in "$path/archive/$want.md" "$path"/*/archive/"$want.md" "$path/archive"/*--"$want.md"; do
    [ -f "$p" ] || continue
    st="$(meta "$p" status)"
    printf '%s' "${st:-done}"
    return 0
  done
  printf 'not on that board'
}

# Append the resolved status to each recognised entry inside a blocked_on value, leaving everything
# else untouched — several waits can be joined by "; ", and each is checked on its own so one
# unrecognised or unresolvable entry never hides another that IS resolvable. Anything that is not
# "external — HOST/OWNER/REPO#ID" (no "#", a different prefix, ordinary prose) passes through
# byte-for-byte, which is what keeps `blocked_on`'s free-text cases (ADR 0004) exactly as free as
# they were before this existed.
annotate_blocked_on() { # blocked_on-value -> the same value, external refs annotated
  local raw="$1" entry key id status joined="" first=1
  [ -n "$raw" ] || return 0
  local IFS_OLD="$IFS"
  IFS=';'
  set -f
  for entry in $raw; do
    entry="${entry# }"
    entry="${entry% }"
    case "$entry" in
      'external —'*'#'*)
        key="${entry#external — }"
        key="${key%%#*}"
        id="${entry##*#}"
        status="$(external_ref_status "$key" "$id")"
        [ -n "$status" ] && entry="$entry → $status"
        ;;
    esac
    if [ "$first" = 1 ]; then
      joined="$entry"
      first=0
    else
      joined="$joined; $entry"
    fi
  done
  set +f
  IFS="$IFS_OLD"
  printf '%s' "$joined"
}

# The generic adapter lookup shared by every ADR 0018 check that is not routed through a
# particular tracker's own config (tracker_adapter() reads external.system for THAT; this asks
# nothing about any tracker at all, so a board need declare no tracker for board_visibility() or
# host_account_guard() to still work): HANDOFF_TRACKER_ADAPTER first — the same seam the
# fake-tracker harness already substitutes with — then the shipped tracker-github.sh. Prints
# nothing and fails when no adapter resolves; callers treat that as "unknown"/"cannot confirm"
# rather than dying here, since a board or a developer that never touches GitHub is unaffected.
board_generic_adapter() { # -> adapter path on stdout, or empty with non-zero
  local f
  if [ -n "${HANDOFF_TRACKER_ADAPTER:-}" ] && [ -f "$HANDOFF_TRACKER_ADAPTER" ]; then
    printf '%s' "$HANDOFF_TRACKER_ADAPTER"
    return 0
  fi
  for f in "$DIR/scripts/tracker-github.sh" "$_self_dir/tracker-github.sh" "$_self_dir/scripts/tracker-github.sh"; do
    [ -f "$f" ] && {
      printf '%s' "$f"
      return 0
    }
  done
  return 1
}

# ADR 0018 — the board's OWN remote is a trust boundary too, not only its trackers (ADR 0013).
# Asked through the same adapter mechanism a tracker uses, but never through tracker config: a
# board need declare no tracker at all to still have this checked. Only github.com is asked —
# every other host, a board with no remote, or a failed call reads "unknown" rather than guessing.
# Never cached. GitHub's `internal` collapses into "private" here, same as ADR 0013.
# HANDOFF_TRACKER_ADAPTER, the same seam the fake-tracker harness already uses, lets a test
# substitute the adapter that answers this too — it never widens WHICH provider is asked, only
# which script speaks for it.
board_visibility() { # board-dir -> public|private|unknown, printed on stdout
  local dir="$1" origin provider adapter="" path vis
  origin="$(board_origin_norm "$dir")"
  [ -n "$origin" ] || { printf 'unknown'; return 0; }
  provider="$(repo_provider_of "$origin")"
  if [ "$provider" != github ]; then
    printf 'unknown'
    return 0
  fi
  adapter="$(board_generic_adapter)" || adapter=""
  [ -n "$adapter" ] || { printf 'unknown'; return 0; }
  path="$(repo_path_of "$origin")"
  vis="$(printf '{"repo": "%s"}' "$path" | bash "$adapter" visibility 2> /dev/null \
    | python3 -c 'import json, sys
try: print(str(json.load(sys.stdin).get("visibility", "")).lower())
except Exception: print("")' 2> /dev/null)"
  case "$vis" in
    public) printf 'public' ;;
    private | internal) printf 'private' ;;
    *) printf 'unknown' ;;
  esac
}

board_public_refusal() { # remote -> the refusal sentence
  printf 'this board'"'"'s own remote (%s) is public, and a board must be private (ADR 0018) — its leases and document history would become readable by anyone, permanently. Nothing was sent. Make the repository private, then re-run.' "$1"
}

# Called once per run, before any tracker pass sends anything (ADR 0018) — distinct from, and
# checked before, ADR 0013's per-tracker gate. A board with no remote is skipped silently: nothing
# widens by staying on one machine. `unknown` warns rather than refuses, so a host with no
# visibility API (or a call that fails) still lets a board work. `claim` never calls this — it
# stays a plain git operation, unconditionally, per ADR 0018.
board_visibility_gate() { # board-dir -> 0, or dies
  local dir="$1" origin vis
  # Only a board with a remote of its OWN (ADR 0002's shared board). An in-repo board's remote is
  # the code repository it lives in, whose audience that repository already decided — an
  # open-source project's board is public by design (ADR 0013), and refusing it here would break it.
  handoff_leases_shared "$dir" || return 0
  origin="$(board_origin_norm "$dir")"
  [ -n "$origin" ] || return 0
  vis="$(board_visibility "$dir")"
  case "$vis" in
    public) die "$(board_public_refusal "$origin")" ;;
    unknown) echo "handoff: warning — could not confirm $origin (this board's own remote) is private; continuing (ADR 0018)." >&2 ;;
  esac
  return 0
}

# ADR 0018 — the host account is NEVER a trust boundary (that stays the remote's host and owner,
# checked above); it is a per-machine safety check that catches sending to a tracker while logged
# into the wrong account. `hostAccount`, recorded per developer in handoff.local.json (ADR 0010),
# never the board's own committed handoff.json (config.sh drops it from every committed layer).
#
# Nothing is asked and nothing is printed when HOST_ACCOUNT is unset — an existing board, or a
# developer who never records one, behaves exactly as before this ADR: zero calls to the adapter's
# whoami op. Called once per run, by mirror_preflight (after board_visibility_gate, before any
# tracker is asked for anything) and by export --to-issue, both the single-doc and the bundle path
# (before any issue is created).
#
# A recorded account that cannot be confirmed — no adapter resolves, the whoami op fails, or it
# answers with no login — refuses exactly like a mismatch: writing under an unconfirmed identity is
# the harm this guard exists to prevent, so "I don't know" and "it's the wrong one" get the same
# answer. Compared case-insensitively: GitHub logins are.
host_account_guard() { # -> 0, or dies
  [ -n "$HOST_ACCOUNT" ] || return 0
  local adapter active
  adapter="$(board_generic_adapter)" || adapter=""
  active=""
  if [ -n "$adapter" ]; then
    active="$(printf '{}' | bash "$adapter" whoami 2> /dev/null | python3 -c 'import json, sys
try:
    v = json.load(sys.stdin).get("login", "")
    print(v if isinstance(v, str) else "")
except Exception:
    print("")' 2> /dev/null)"
  fi
  [ -n "$active" ] \
    || die "could not confirm which account is active — this board expects the host account $HOST_ACCOUNT (handoff.local.json, ADR 0018), and writing under an unconfirmed identity is refused. Nothing was sent. Check 'gh auth status', then re-run."
  [ "$(printf '%s' "$active" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$HOST_ACCOUNT" | tr '[:upper:]' '[:lower:]')" ] \
    || die "this board expects the host account $HOST_ACCOUNT (handoff.local.json, ADR 0018), but the active account is $active — refusing to send anything under the wrong identity. Nothing was sent. Switch first: gh auth switch --user $HOST_ACCOUNT"
  return 0
}

# The trust boundary. Returns 0 when the move stays inside one boundary (same host and owner, a
# target with no remote, or a cross-owner child both sides have linked), 1 when it crosses and the
# caller named the target's owner. Dies otherwise — and always for a restricted doc, which never
# crosses owners, named or not.
move_check_trust() { # doc id target-board to-remote
  local f="$1" id="$2" to="$3" to_remote="$4" src_key dst_key src_repo dst_repo src_parent
  src_key="$(board_owner_key "$DIR")"
  dst_key="$(board_owner_key "$to")"
  # A target with no remote keeps the material on this machine, which widens nothing — even out of
  # a child board.
  [ -n "$dst_key" ] || return 0
  src_repo="$(board_origin_norm "$DIR")"
  dst_repo="$(board_origin_norm "$to")"

  # Out of a child: it said it is narrower than its parent, so ANY move out of it widens who reads
  # the work — to the parent itself and under the same owner included (ADR 0018). Naming the target
  # is the consent; a restricted doc still never leaves its owner.
  src_parent="$(board_parent "$DIR")"
  if [ -n "$src_parent" ]; then
    [ "$src_key" != "$dst_key" ] && is_restricted "$f" \
      && die "$id is sensitivity: restricted — it never moves to a board under a different remote (${src_key:-no remote} → $dst_key), and there is no override. Do the work where it is."
    [ "$to_remote" = "$dst_key" ] \
      || die "refusing to move $id out of a child board: this board declares it is narrower than $src_parent, so moving work out of it widens who can read it.
       If that is intended, name the target: --to-remote $dst_key"
    return 1
  fi

  [ "$src_key" != "$dst_key" ] || return 0

  # Into a child under another owner that BOTH sides have linked: the child names this board as its
  # parent and this board accepts it. Still never a restricted doc — accepting a child does not make
  # an account this owner does not control part of it.
  if [ -n "$src_repo" ] && [ "$(board_parent "$to")" = "$src_repo" ] && board_accepts_child "$DIR" "$dst_repo"; then
    is_restricted "$f" \
      && die "$id is sensitivity: restricted — it never moves to a board under a different remote ($src_key → $dst_key), even a child board this one accepts, and there is no override. Do the work where it is."
    return 0
  fi

  is_restricted "$f" \
    && die "$id is sensitivity: restricted — it never moves to a board under a different remote (${src_key:-no remote} → $dst_key), and there is no override. Do the work where it is."
  [ "$to_remote" = "$dst_key" ] \
    || die "refusing to move $id across a trust boundary: the source board's remote is ${src_key:-absent} and the target's is $dst_key.
       Moving it carries this material to another owner. If that is intended, name the target: --to-remote $dst_key"
  return 1
}

# Write the copy the target will import: the doc, with board-local edges turned into an external
# blocker (depends_on names board ids, which mean nothing on another board — ADR 0004), where it
# came from, and one Activity line saying so.
move_stage_copy() { # doc staged-path src-label activity-note
  local f="$1" staged="$2" src_label="$3" note="$4" deps blocker
  cat "$f" > "$staged"
  deps="$(depends_of "$f" | tr '\n' ' ' | sed 's/ $//')"
  if [ -n "$deps" ]; then
    blocker="$(meta "$f" blocked_on)"
    blocker="${blocker:+$blocker; }external — depends on $deps on $src_label"
    set_field "$staged" depends_on "[]"
    set_field "$staged" blocked_on "$(fold_colons "$blocker")"
  fi
  set_field "$staged" moved_from "$(fold_colons "$src_label")"
  log_activity "$staged" "$note"
}

# The target's own import, run AS the target: its layout, its section, its schema gate. From the
# target directory so no repo config around the caller can re-route the section. Prints the path
# the doc landed at; dies (non-zero) when the target refuses, having moved nothing.
move_import_into() { # staged-path target-board group new-id type title
  local staged="$1" to="$2" tgroup="$3" new_id="$4" type="$5" title="$6" self out rc dest
  self="$_self_dir/$(basename "${BASH_SOURCE[0]}")"
  out="$(cd "$to" && env HANDOFF_BOARD_PATH="$to" HANDOFF_BOARD_SOURCE="handoff move" \
    HANDOFF_GROUP="$tgroup" HANDOFF_NONINTERACTIVE=1 \
    bash "$self" import "$staged" --id "$new_id" --type "$type" --title "$title" 2>&1)"
  rc=$?
  if [ $rc -ne 0 ]; then
    case "$out" in
      *"already exists"*) die "the target board already has $new_id — nothing moved. Pick another id there: --id <new-id>" ;;
      *) die "the target board refused the import — nothing moved:
$out" ;;
    esac
  fi
  dest="$(printf '%s\n' "$out" | sed -n 's/^Imported .* → \(.*\) (type: .*$/\1/p' | head -1)"
  [ -f "$dest" ] || die "the import reported success but its doc was not found — check $to before retrying:
$out"
  printf '%s' "$dest"
}

move_publish_target() { # target-board dest src-label
  local to="$1" dest="$2" src_label="$3"
  handoff_leases_shared "$to" || return 0
  handoff_board_git "$to" add --all -- "$dest" "$to/INDEX.md" "$(dirname "$dest")/INDEX.md"
  if handoff_board_git "$to" commit --quiet -m "handoff: move in $(basename "$dest" .md) from $src_label"; then
    handoff_board_git "$to" push --quiet "$(handoff_board_remote "$to")" HEAD \
      || echo "⚠️  Moved and committed on the target, but its push did not land. Push $to."
  fi
}

# The source keeps its frontmatter and a one-line body pointing at the new home, closed and
# archived, with its lease released. Never a copy: two copies of one handoff is the second writer
# ADR 0002 rules out.
move_leave_pointer() { # doc id dest dst-label
  local f="$1" id="$2" dest="$3" dst_label="$4" t
  t="$(mktemp)" || die "mktemp failed"
  awk '{ print } /^---$/ { n++; if (n == 2) exit }' "$f" > "$t"
  printf '\nMoved to %s as %s on %s.\n' "$dst_label" "$(basename "$dest" .md)" "$(today)" >> "$t"
  cat "$t" > "$f"
  rm -f "$t"
  set_field "$f" moved_to "$(fold_colons "$dst_label") — $(basename "$dest" .md)"
  set_field "$f" status done
  set_field "$f" updated "$(today)"
  clear_lock "$(lock_key "$id")"
  archive_doc "$f" "$id" || warn_archive_failed "$id"
}

# Docs left here that depended on it now point at a pointer. depends_on cannot follow it across
# boards, so name the ones to rewrite rather than leave them reading as satisfied.
move_dependents_of() { # id -> "a-handoff, b-handoff", or nothing
  local id="$1" other dependents=""
  while IFS= read -r other; do
    [ -n "$other" ] || continue
    depends_of "$other" | grep -qx "$id" && dependents="${dependents:+$dependents, }$(basename "$other" .md)"
  done < <(each_doc)
  printf '%s' "$dependents"
}

cmd_move() { # <id> --to <board-dir> [--group G] [--id NEW] [--to-remote host/owner] [--force-secret REASON]
  local id="${1:?usage: handoff move <id> --to <board-dir> [--group G] [--id NEW-ID] [--to-remote host/owner] [--force-secret REASON]}"
  shift
  local raw_id="$id" to="" tgroup="" new_id="" to_remote="" force_secret=""
  id="$(resolve_id "$id")" || die "unusable id: '$raw_id' (needs at least one letter or digit)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --to)
        require_value --to "$#" "${2:-}"
        to="$2"
        shift 2
        ;;
      --group)
        require_value --group "$#" "${2:-}"
        tgroup="$2"
        shift 2
        ;;
      --id)
        require_value --id "$#" "${2:-}"
        new_id="$2"
        shift 2
        ;;
      --to-remote)
        require_value --to-remote "$#" "${2:-}"
        to_remote="$2"
        shift 2
        ;;
      --force-secret)
        require_value --force-secret "$#" "${2:-}"
        force_secret="$2"
        shift 2
        ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  [ -n "$to" ] || die "move needs --to <board-dir>"
  to="$(cd "$to" 2> /dev/null && pwd)" || die "no such board directory: $to"
  _board_looks_real "$to" || die "$to is not a handoff board (no scripts/config.sh) — install one with setup-handoff first."
  [ "$(cd "$DIR" && pwd -P)" = "$(cd "$to" && pwd -P)" ] && die "$id is already on $to — move is between two boards."

  local f
  f="$(doc_of "$id")" || no_such "$id"
  require_writable "$f" "$id"
  is_orchestrator "$f" && die "$id is an orchestrator — move its children; a bundle index belongs to the board its children are on."
  [ "$(meta "$f" status)" = "done" ] && die "$id is done — closed work stays on the board that closed it."
  if ! is_standalone "$f"; then
    lease_is_mine "$id" || die "moving $id transfers ownership, so this session has to hold its lease — claim it first: handoff claim $id.$(advisory_hint)"
  fi

  local across=""
  move_check_trust "$f" "$id" "$to" "$to_remote" || across=" (across remotes, target named as $(board_owner_key "$to"))"

  # ADR 0017 — a home names a repository of THIS board's registry. The target must register it too,
  # or the doc lands homed at a repository that board has never heard of and can never mirror. Only
  # a target that HAS a registry can contradict a home: a board has none until the cross-repo sync
  # writes one, and refusing there would block a move onto a board that works perfectly well.
  local fhome
  fhome="$(meta "$f" home)"
  if [ -n "$fhome" ] && [ -n "$(DIR="$to" registered_aliases)" ]; then
    board_registers "$to" "$fhome" \
      || die "$id is homed at $fhome, which the target board does not register — nothing moved. Register $fhome there first (register-cross-repo-handoff)."
  fi

  local hits=""
  if hits="$(scan_secrets < "$f")"; then
    [ -n "$force_secret" ] || die_on_secret "the move of $id" "$hits"
  fi

  local src_label dst_label stage_dir staged dest
  src_label="$(board_origin_norm "$DIR")"
  src_label="${src_label:-$DIR}"
  dst_label="$(board_origin_norm "$to")"
  dst_label="${dst_label:-$to}"
  stage_dir="$(mktemp -d)" || die "mktemp failed"
  staged="$stage_dir/$id.md"
  move_stage_copy "$f" "$staged" "$src_label" "moved here from $(fold_colons "$src_label") by $(whoami_id)${across}."
  # ADR 0020 — gated on the TARGET board's remote, not the source's: what matters is whether the
  # doc is about to be pushed somewhere, and it is about to live on $to. move_import_into below
  # re-imports this staged copy through the target's own `import`, which applies the same rule
  # again against the same board -- idempotent once this has already rewritten it.
  [ -n "$(handoff_board_remote "$to")" ] && machine_refs_file "$staged"
  [ -n "$force_secret" ] && [ -n "$hits" ] \
    && log_secret_override "$staged" "move secret-scan OVERRIDDEN" "$hits" "$force_secret"
  # move_import_into runs in a command substitution, so its `die` exits only that subshell. The rc
  # check below is what stops the move — keep it when touching this block.
  dest="$(move_import_into "$staged" "$to" "$tgroup" "${new_id:-$id}" "$(doc_type "$f")" "$(meta "$f" title)")"
  local rc=$?
  rm -f "$staged"
  rmdir "$stage_dir" 2> /dev/null
  [ $rc -eq 0 ] || exit $rc
  move_publish_target "$to" "$dest" "$src_label"

  move_leave_pointer "$f" "$id" "$dest" "$dst_label"
  lease_index > /dev/null
  release_commit_push "handoff: move $id to $dst_label" "$(arch_file "$id")"

  local dependents
  dependents="$(move_dependents_of "$id")"
  echo "Moved $id → $dest ($dst_label). An archived pointer stays here."
  [ -n "$dependents" ] \
    && echo "⚠️  Still on this board and depending on it: $dependents. Release each with --blocked-on \"external: …\" — depends_on does not cross boards."
  return 0
}

# ADR 0017 — a tracker attaches per REPOSITORY. A board declares `trackers` in its own committed
# handoff.json, keyed by the repository aliases its registry lists, and a handoff's `home` picks one.
# ADR 0011's single `external` block survives as LEGACY MODE on a single-repository board, where it
# serves every document; on a cross-repository board it routes nothing (the verifier says so). A
# handoff points at a ticket with `external_ref`, checked against its tracker's `refPattern` — level 1
# is reference only: no network, no token. Everything is read from the BOARD file alone — a member
# repo's config must not be able to swap a tracker for its own, and ADR 0013 requires publishing
# policy to live where review sees it.
#
# CUR_TRACKER is the home alias the current tracker operation targets. Every command that reaches a
# tracker sets it first: `mirror` once per pass, `new --ref` and `export`/`import` from the doc's home.
CUR_TRACKER=""

tracker_mode() { # -> trackers | legacy | none
  [ -f "$DIR/handoff.json" ] && command -v python3 > /dev/null 2>&1 || {
    printf 'none'
    return 0
  }
  python3 -c 'import json,sys
try: d = json.load(open(sys.argv[1]))
except Exception: print("none"); raise SystemExit(0)
d = d if isinstance(d, dict) else {}
if isinstance(d.get("trackers"), dict) or isinstance(d.get("trackerRules"), dict): print("trackers")
elif isinstance(d.get("external"), dict) and sys.argv[2] != "cross-repo": print("legacy")
else: print("none")' "$DIR/handoff.json" "$TOPOLOGY" 2> /dev/null || printf 'none'
}

# ADR 0020 — a GROUP can declare a tracker RULE in trackerRules, resolved for a member through the
# origin recorded at registration (_generated.repos[].origin), never read live: a CI mirror has no
# member checkouts. A per-repository entry under `trackers` always wins when both exist. A rule
# never carries allowPublic (stripped defensively below even though the verifier already refuses
# one that does), so a public member repository under a bare rule still needs a per-repository
# opt-in (ADR 0013).
tracker_entry() { # alias -> that home's tracker as a JSON object, or nothing
  [ -f "$DIR/handoff.json" ] && command -v python3 > /dev/null 2>&1 || return 0
  python3 -c 'import json,sys
try: d = json.load(open(sys.argv[1]))
except Exception: raise SystemExit(0)
d = d if isinstance(d, dict) else {}
alias, topology = sys.argv[2], sys.argv[3]
t = d.get("trackers")
if isinstance(t, dict) and isinstance(t.get(alias), dict):
    print(json.dumps(t[alias]))
    raise SystemExit(0)
if isinstance(d.get("external"), dict) and topology != "cross-repo" and not isinstance(t, dict):
    print(json.dumps(d["external"]))
    raise SystemExit(0)
rules = d.get("trackerRules")
if not isinstance(rules, dict):
    raise SystemExit(0)
repos = (d.get("_generated") or {}).get("repos") or []
reg = next((r for r in repos if isinstance(r, dict) and r.get("alias") == alias), None)
group = reg.get("group") if isinstance(reg, dict) else None
origin = reg.get("origin") if isinstance(reg, dict) else None
rule = rules.get(group) if group else None
HOSTS = {"github": "github.com", "gitlab": "gitlab.com", "bitbucket": "bitbucket.org"}
def on_host(o, system): return o.split("/", 1)[0].lower() == HOSTS.get(system or "github", system or "")
# A rule names a SYSTEM and the origin names a HOST: a member on another host is not for this rule to
# mirror, or its path would be reused on a host it does not live on.
if not isinstance(rule, dict) or not isinstance(origin, str) or not origin or not on_host(origin, rule.get("system")):
    raise SystemExit(0)
def path_of(o):
    host = o.split("/", 1)[0]
    return o.split("/", 1)[1] if host in ("github.com", "gitlab.com", "bitbucket.org") else o
entry = dict(rule)
entry.pop("allowPublic", None)
entry["repo"] = path_of(origin)
if entry.get("kind") == "issues" and not entry.get("refPattern"):
    entry["refPattern"] = "#[0-9]+"
print(json.dumps(entry))' "$DIR/handoff.json" "$1" "$TOPOLOGY" 2> /dev/null
}

registered_aliases() { # -> the repository aliases this board's registry lists, one per line
  [ -f "$DIR/handoff.json" ] && command -v python3 > /dev/null 2>&1 || return 0
  python3 -c 'import json,sys
try: d = json.load(open(sys.argv[1]))
except Exception: raise SystemExit(0)
g = d.get("_generated") if isinstance(d, dict) else None
for r in (g or {}).get("repos") or []:
    if isinstance(r, dict) and r.get("alias"): print(r["alias"])' "$DIR/handoff.json" 2> /dev/null
}

# Whether a board can hold a document homed at <alias>. Only a cross-repository board names its
# repositories, so only one can refuse; a single-repository board holds whatever it is given.
board_registers() { # board-dir alias -> 0 when yes
  python3 -c 'import json,sys
try: d = json.load(open(sys.argv[1] + "/handoff.json"))
except Exception: raise SystemExit(0)
if not isinstance(d, dict) or d.get("topology") != "cross-repo": raise SystemExit(0)
repos = (d.get("_generated") or {}).get("repos") or []
raise SystemExit(0 if any(isinstance(r, dict) and r.get("alias") == sys.argv[2] for r in repos) else 1)' "$1" "$2" 2> /dev/null
}

tracker_setting() { # key -> CUR_TRACKER's tracker's <key> as a string, or nothing
  local e
  e="$(tracker_entry "$CUR_TRACKER")"
  [ -n "$e" ] || return 0
  printf '%s' "$e" | python3 -c 'import json,sys
v = json.load(sys.stdin).get(sys.argv[1])
print(v if isinstance(v, str) else "")' "$1"
}

# The passes `mirror` makes. A sprint tool is never mirrored (ADR 0011), so in trackers mode its entry
# is no pass at all; in legacy mode the single pass is still made and require_tracker refuses it with
# the sprint-tool message, exactly as before.
tracker_aliases() { # -> one alias per line, a single empty line (legacy), or nothing
  case "$(tracker_mode)" in
    legacy) printf '\n' ;;
    trackers)
      python3 -c 'import json,sys
d = json.load(open(sys.argv[1]))
declared = d.get("trackers") or {}
aliases = set(a for a, e in declared.items() if isinstance(e, dict) and e.get("kind") == "issues")
# ADR 0020 — every registered member of a ruled group is a pass too, unless it already has its own
# declared entry above (which may be a sprint tool, overriding the rule to opt OUT of the mirror).
rules = d.get("trackerRules") or {}
repos = (d.get("_generated") or {}).get("repos") or []
HOSTS = {"github": "github.com", "gitlab": "gitlab.com", "bitbucket": "bitbucket.org"}
def on_host(o, system): return o.split("/", 1)[0].lower() == HOSTS.get(system or "github", system or "")
for r in repos:
    if not isinstance(r, dict): continue
    a = r.get("alias")
    if not a or a in declared: continue
    rule = rules.get(r.get("group"))
    origin = r.get("origin")
    if isinstance(rule, dict) and rule.get("kind") == "issues" and isinstance(origin, str) and origin and on_host(origin, rule.get("system")):
        aliases.add(a)
for a in sorted(aliases): print(a)' "$DIR/handoff.json" 2> /dev/null
      ;;
  esac
}

tracker_aliases_all() { # -> every alias this board declares a tracker for, sprint tools included
  [ "$(tracker_mode)" = trackers ] || return 0
  python3 -c 'import json,sys
d = json.load(open(sys.argv[1]))
declared = d.get("trackers") or {}
aliases = set(a for a, e in declared.items() if isinstance(e, dict))
rules = d.get("trackerRules") or {}
repos = (d.get("_generated") or {}).get("repos") or []
HOSTS = {"github": "github.com", "gitlab": "gitlab.com", "bitbucket": "bitbucket.org"}
def on_host(o, system): return o.split("/", 1)[0].lower() == HOSTS.get(system or "github", system or "")
for r in repos:
    if not isinstance(r, dict): continue
    a = r.get("alias")
    if not a or a in declared: continue
    rule = rules.get(r.get("group"))
    origin = r.get("origin")
    if isinstance(rule, dict) and isinstance(origin, str) and origin and on_host(origin, rule.get("system")):
        aliases.add(a)
for a in sorted(aliases): print(a)' "$DIR/handoff.json" 2> /dev/null
}

# One board per trust boundary (ADR 0011), kept when trackers multiply (ADR 0017): every tracker on a
# board shares one host and owner, and a board with a remote shares it too. A board without a remote
# takes its owner from its trackers. Checked before anything is sent.
trackers_trust_check() { # -> 0, or dies naming the owners
  [ "$(tracker_mode)" = trackers ] || return 0
  local board_key owners
  board_key="$(board_owner_key "$DIR" | tr '[:upper:]' '[:lower:]')"
  # ADR 0020 — a rule-derived entry is a tracker like any other, so it belongs in this trust check
  # exactly as a declared one does: a member whose origin sits under a different owner refuses the
  # run, naming both.
  owners="$(python3 -c 'import json,sys
d = json.load(open(sys.argv[1]))
keys = set()
def add(repo, system):
    if not isinstance(repo, str) or "/" not in repo: return
    system = system or "github"
    host = "github.com" if system == "github" else system
    keys.add(("%s/%s" % (host, repo.split("/")[0])).lower())
declared = d.get("trackers") or {}
for e in declared.values():
    if isinstance(e, dict): add(e.get("repo"), e.get("system"))
rules = d.get("trackerRules") or {}
repos = (d.get("_generated") or {}).get("repos") or []
def path_of(o):
    host = o.split("/", 1)[0]
    return o.split("/", 1)[1] if host in ("github.com", "gitlab.com", "bitbucket.org") else o
HOSTS = {"github": "github.com", "gitlab": "gitlab.com", "bitbucket": "bitbucket.org"}
def on_host(o, system): return o.split("/", 1)[0].lower() == HOSTS.get(system or "github", system or "")
for r in repos:
    if not isinstance(r, dict): continue
    a = r.get("alias")
    if not a or a in declared: continue
    rule = rules.get(r.get("group"))
    origin = r.get("origin")
    if isinstance(rule, dict) and isinstance(origin, str) and origin and on_host(origin, rule.get("system")):
        add(path_of(origin), rule.get("system"))
print(" ".join(sorted(keys)))' "$DIR/handoff.json" 2> /dev/null)"
  [ -n "$owners" ] || return 0
  case "$owners" in
    *" "*) die "this board's trackers belong to more than one owner ($owners) — one board per trust boundary (ADR 0011, ADR 0017). Give each owner its own board; nothing was sent." ;;
  esac
  [ -z "$board_key" ] || [ "$board_key" = "$owners" ] \
    || die "this board's remote is $board_key but its trackers belong to $owners — one board per trust boundary (ADR 0011, ADR 0017). Mirror from a board owned by $owners; nothing was sent."
  return 0
}

# ADR 0020 — allowPublic is never part of a rule: a rule applies to every member of a group, and a
# group can hold a public repository nobody meant to publish. Checked once per run, before any
# tracker is even asked for its visibility (ADR 0013) — a per-repository entry under `trackers` is
# still free to set allowPublic for the one repository that should actually publish.
tracker_rules_reject_public() { # -> 0, or dies naming the group(s)
  [ -f "$DIR/handoff.json" ] && command -v python3 > /dev/null 2>&1 || return 0
  local groups
  groups="$(python3 -c 'import json,sys
try: d = json.load(open(sys.argv[1]))
except Exception: raise SystemExit(0)
rules = d.get("trackerRules") if isinstance(d, dict) else None
if not isinstance(rules, dict): raise SystemExit(0)
bad = sorted(g for g, r in rules.items() if isinstance(r, dict) and "allowPublic" in r)
print(" ".join(bad))' "$DIR/handoff.json" 2> /dev/null)"
  [ -z "$groups" ] \
    || die "trackerRules sets allowPublic on group(s): $groups — a rule can never opt a group's public repositories into publishing (ADR 0020). Move allowPublic onto a per-repository entry under trackers for the specific repository that should publish, and mark its docs share: public. Nothing was sent."
}

# ADR 0017 — which board a mirrored issue belongs to. Derived, never stored: the board repository's
# root commit plus the board's path inside it, so every clone agrees and a draft board kept in an
# ignored folder of the same repository does not. A board with no git history falls back to its
# physical path; such a board cannot be cloned, so nothing else can share the answer.
board_identity() { # -> 12 lowercase hex digits; dies on a shallow clone
  local top root rel
  top="$(board_git rev-parse --show-toplevel)"
  root="$(repo_root_commit "$DIR")"
  # A SHALLOW clone has no root commit to find: the commit it checked out has no parent locally, so
  # `rev-list --max-parents=0 HEAD` answers with that commit — a different one after every push. An
  # identity computed from it would make each CI run look like a different board and refuse the
  # tracker its predecessor had just written. Say so instead of guessing; the workflow this skill
  # installs checks out full history for exactly this reason.
  if [ "$(board_git rev-parse --is-shallow-repository 2> /dev/null)" = true ]; then
    die "this board is a shallow clone, so it has no stable identity — and one tracker is written by one board (ADR 0017). Check it out with full history (git fetch --unshallow, or fetch-depth: 0 in CI) and run this again. Nothing was sent."
  fi
  if [ -n "$top" ] && [ -n "$root" ]; then
    rel="$(python3 -c 'import os,sys; print(os.path.relpath(os.path.realpath(sys.argv[1]), os.path.realpath(sys.argv[2])))' "$DIR" "$top")"
    printf '%s:%s' "$root" "$rel"
  else
    printf 'path:%s' "$(cd "$DIR" && pwd -P)"
  fi | shasum -a 256 | cut -c1-12
}

# One board mirrors into a tracker (ADR 0017). Reads a tracker listing and returns it with every
# pre-identity marker ADOPTED for this board, or exits 4 naming the boards that already own issues
# there. An adopted row keeps its old body in the tracker and carries _legacy, which mirror_plan
# treats as never `same`, so the next update rewrites the marker in the issue itself.
mirror_claim_tracker() { # existing-json -> normalized json; exit 4 with foreign ids on stderr
  python3 - "$1" "$BOARD_ID" << 'PY'
import json, re, sys
existing = json.loads(sys.argv[1] or "[]")
bid = sys.argv[2]
ours = re.compile(r"^[0-9a-f]{12}/")
foreign = set()
for i in existing:
    m = re.search(r"<!-- handoff:(.*?) -->", i.get("body", ""))
    if not m:
        continue
    marker = m.group(1)
    if ours.match(marker):
        if marker[:12] != bid:
            foreign.add(marker[:12])
        continue
    i["body"] = i["body"].replace(m.group(0), "<!-- handoff:%s/%s -->" % (bid, marker))
    i["_legacy"] = True
if foreign:
    sys.stderr.write(" ".join(sorted(foreign)))
    raise SystemExit(4)
print(json.dumps(existing))
PY
}

# --- the external tracker, levels 2 and 3 (ADR 0011) -------------------------------------------------
# Every tracker is reached through an ADAPTER: `scripts/tracker-<system>.sh`, one operation as $1, a
# JSON request on stdin, a JSON reply on stdout. The CLI never talks to a tracker's API itself and
# never holds a credential — the GitHub adapter uses `gh`, which carries its own auth. Tests and
# other trackers swap one in with $HANDOFF_TRACKER_ADAPTER.
tracker_adapter() { # -> path of the adapter script; dies naming what is missing
  if [ -n "${HANDOFF_TRACKER_ADAPTER:-}" ]; then
    [ -f "$HANDOFF_TRACKER_ADAPTER" ] || die "HANDOFF_TRACKER_ADAPTER points at $HANDOFF_TRACKER_ADAPTER, which does not exist."
    printf '%s' "$HANDOFF_TRACKER_ADAPTER"
    return
  fi
  local system f
  system="$(tracker_setting system)"
  [ -n "$system" ] || die "this board's external tracker names no system (external.system in $DIR/handoff.json), so there is no adapter to use."
  case "$system" in *[!a-z0-9-]*) die "external.system '$system' is not an adapter name (lowercase letters, digits, dashes)." ;; esac
  for f in "$DIR/scripts/tracker-$system.sh" "$_self_dir/tracker-$system.sh" "$_self_dir/scripts/tracker-$system.sh"; do
    [ -f "$f" ] && {
      printf '%s' "$f"
      return
    }
  done
  die "no adapter for tracker system '$system' — expected $DIR/scripts/tracker-$system.sh. Re-run setup-handoff to install the adapters it ships."
}

tracker_call() { # op request-json -> reply json on stdout; dies when the adapter fails
  local adapter reply
  adapter="$(tracker_adapter)" || exit 3
  reply="$(printf '%s' "$2" | bash "$adapter" "$1")" || die "the tracker adapter failed on '$1' — nothing further was sent. See its message above."
  printf '%s' "$reply"
}

# The configuration every tracker operation needs, checked in one place. `kind` decides the rest:
# a sprint tool is never mirrored (it IS the planning surface; a mirror would be a second backlog),
# and an issue tracker needs to know which repository the issues belong in.
require_tracker() { # purpose(mirror|delegate) -> prints the target repo
  local kind repo
  [ -f "$DIR/handoff.json" ] || die "this board declares no tracker (no trackers or external block in handoff.json)."
  kind="$(tracker_setting kind)"
  [ -n "$kind" ] || die "no tracker is declared for ${CUR_TRACKER:-this board} in $DIR/handoff.json (ADR 0017)."
  if [ "$1" = mirror ] && [ "$kind" = sprints ]; then
    die "this board's tracker is a sprint tool (external.kind: sprints). A sprint tool is the planning surface, and a mirror into it would be a second backlog — it is never mirrored (ADR 0011)."
  fi
  repo="$(tracker_setting repo)"
  [ -n "$repo" ] || die "the tracker for ${CUR_TRACKER:-this board} names no repo in $DIR/handoff.json (external.repo on a single-repository board) — name the repository the issues belong in (owner/name)."
  printf '%s' "$repo"
}

# ADR 0013 — a public repository is published to only by double opt-in: the BOARD (external.allowPublic
# in its committed handoff.json, never a local file or the environment) and each DOCUMENT
# (`share: public`). Visibility is asked on every run and never cached; a tracker that cannot say,
# or a failed call, counts as public. `internal` is behind an organisation's login and counts as
# private, like `private`.
tracker_is_public() { # repo -> 0 when the audience may be the public
  local adapter vis
  adapter="$(tracker_adapter)" || exit 3
  vis="$(printf '{"repo": "%s"}' "$1" | bash "$adapter" visibility 2> /dev/null \
    | python3 -c 'import json, sys
try: print(str(json.load(sys.stdin).get("visibility", "")).lower())
except Exception: print("")' 2> /dev/null)"
  case "$vis" in private | internal) return 1 ;; *) return 0 ;; esac
}

# Per tracker since ADR 0017: publishing to one public repository is a decision about THAT
# repository, never a board-wide switch. Still read only from the board's committed handoff.json.
board_allows_public() { # -> 0 when CUR_TRACKER's tracker sets allowPublic: true
  local e
  e="$(tracker_entry "$CUR_TRACKER")"
  [ -n "$e" ] || return 1
  printf '%s' "$e" | python3 -c 'import json,sys
raise SystemExit(0 if json.load(sys.stdin).get("allowPublic") is True else 1)'
}

public_refusal() { # repo what -> the refusal sentence
  printf '%s is public (or its visibility could not be confirmed), and this board does not allow publishing there — %s would make it readable by anyone, permanently. To publish on purpose, set allowPublic: true on this tracker (trackers.%s, or external on a single-repository board) in %s and mark each doc with share: public (ADR 0013).' \
    "$1" "$2" "${CUR_TRACKER:-ALIAS}" "$DIR/handoff.json"
}

# `export <id> --to-issue` (ADR 0011, level 2). The brief is rendered exactly as `export` renders it —
# same restricted refusal, same outbound secret scan, same claim — and then opened as an issue, so
# someone with no board access can pick it up. The issue number becomes the doc's external_ref.
# `export <bundle> --to-issue` (ADR 0015). The file-based bundle export has rendered a cover plus one
# brief per child since ADR 0011, and ADR 0014 taught the mirror to project a bundle as a parent
# issue with its children linked beneath it. Only this entry point still refused, so handing a
# planned feature to a contractor meant exporting each child separately and throwing away the
# sequencing and the `depends_on` edges that made it a bundle.
#
# One issue per child, not one issue holding every brief: a child is claimed, answered and reviewed
# on its own, and a single issue cannot carry N results.
#
# RESUMED, NOT ROLLED BACK. Opening N+1 issues is a multi-write operation and the tracker can fail
# part-way. There is no transaction to roll back to — an issue that exists has been seen — so a
# failed run leaves what it made and `external_ref` makes the re-run idempotent, exactly as the
# hidden marker does for the mirror. Every doc that already carries one is skipped, and a run with
# nothing left to open says so rather than erroring.
export_bundle_to_issue() { # id doc outdir branch do_claim force-secret
  local id="$1" f="$2" outdir="$3" branch="$4" do_claim="$5" force_secret="${6:-}"
  local repo ref_style kids kid kf kbrief kn parent_num reply body title
  local made=0 skipped=0 child_nums=""
  # ADR 0017 — a document reaches the tracker of its home, and nowhere else.
  CUR_TRACKER="$(meta "$f" home)"
  # A parent issue and its children live in ONE tracker: the link pass resolves a child's issue by
  # number inside the tracker it is listing, and the adapter's request names children by number
  # alone. A child homed elsewhere would be silently unlinked, so say so instead and send nothing.
  if [ "$(tracker_mode)" = trackers ]; then
    local away="" akid akf
    while IFS= read -r akid; do
      [ -n "$akid" ] || continue
      akf="$(doc_of "$akid" 2> /dev/null)" || continue
      [ "$(meta "$akf" home)" = "$CUR_TRACKER" ] || away="${away:+$away, }$akid (home $(meta "$akf" home))"
    done <<< "$(children_of "$f")"
    [ -z "$away" ] \
      || die "$id is homed at ${CUR_TRACKER:-nothing}, but these children belong to other trackers: $away. A delegated bundle is one tracker's parent and children (ADR 0017) — export those children on their own. Nothing was sent."
  fi

  # The file path refuses this rather than pretending one branch name could apply to N independent
  # children; the issue path inherits the same answer.
  [ -n "$branch" ] \
    && die "--branch is not supported for a bundle export — each child gets its own default branch (fix/<child-id>)"

  repo="$(require_tracker delegate)" || exit 3
  tracker_adapter > /dev/null || exit 3
  host_account_guard
  kids="$(children_of "$f")"
  [ -n "$kids" ] \
    || die "$id has no children — a bundle with no units is nothing to delegate. Add them with 'handoff children add $id <child>'."

  # --- every refusal first, before one issue is opened ------------------------------------
  # A restricted CHILD refuses the whole bundle, matching both the file export and the mirror.
  # cmd_export already refused a restricted parent. Sending the other briefs and holding this one
  # back would hand an executor a cover naming a unit they were never given.
  local restricted=""
  while IFS= read -r kid; do
    [ -n "$kid" ] || continue
    kf="$(doc_of "$kid" 2> /dev/null || true)"
    [ -n "$kf" ] && [ -f "$kf" ] || continue
    is_restricted "$kf" && restricted="${restricted:+$restricted }$kid"
  done <<< "$kids"
  [ -z "$restricted" ] \
    || die "cannot export bundle $id — restricted child(ren):$restricted. A restricted unit is never handed to an external executor. Nothing was sent; split it out of the bundle, or do the whole bundle in a session with board access."

  # ADR 0013, applied to every doc that would become an issue. The parent's cover names each child,
  # so a public parent with a child nobody marked would publish that child's title regardless.
  if tracker_is_public "$repo"; then
    board_allows_public || die "$(public_refusal "$repo" "opening $id and its children as issues")"
    [ "$(meta "$f" share)" = public ] \
      || die "$repo is public and $id is not marked share: public — only docs marked for public sharing are delegated there. Nothing was sent."
    local unshared=""
    while IFS= read -r kid; do
      [ -n "$kid" ] || continue
      kf="$(doc_of "$kid" 2> /dev/null || true)"
      [ -n "$kf" ] && [ -f "$kf" ] || continue
      [ "$(meta "$kf" share)" = public ] || unshared="${unshared:+$unshared }$kid"
    done <<< "$kids"
    [ -z "$unshared" ] \
      || die "$repo is public and these children are not marked share: public:$unshared. The bundle cover names every child, so a partial bundle would publish them anyway. Nothing was sent."
  fi

  # Decided before anything is created, so a pattern that cannot hold an issue number refuses here
  # instead of leaving N orphaned issues behind.
  if printf '#1\n' | grep -Eqx -- "$(tracker_setting refPattern)" 2> /dev/null; then
    ref_style="#"
  elif printf '1\n' | grep -Eqx -- "$(tracker_setting refPattern)" 2> /dev/null; then
    ref_style=""
  else
    die "the refPattern of this handoff's tracker ($(tracker_setting refPattern)) would not accept an issue number as external_ref — fix the pattern before delegating to an issue."
  fi

  # Renders the cover and every child brief, and runs its own pre-flight for foreign leases. Local
  # writes only — nothing has been sent yet, so its refusals still leave the tracker untouched.
  export_bundle "$id" "$f" "issue" "$outdir" "$do_claim" "$force_secret" > /dev/null || exit 3

  # The PARENT first: a child cannot be linked under an issue that does not exist yet.
  parent_num="$(meta "$f" external_ref)"
  parent_num="${parent_num#\#}"
  if [ -z "$parent_num" ]; then
    local cover
    cover="$(meta "$f" brief)"
    case "$cover" in /*) ;; *) cover="${REPO_DIR:+$REPO_DIR/}$cover" ;; esac
    [ -f "$cover" ] || die "the bundle cover for $id was not written — nothing was sent."
    # No return footer on the cover: the parent is an index, and a result is imported against the
    # child that did the work (never against the bundle).
    body="$(cat "$cover")
---
**This is a bundle.** Each unit below has its own issue; claim, answer and return each one there. Nothing is reported against this issue."
    title="$(meta "$f" title)"
    reply="$(tracker_call create "$(python3 -c 'import json, sys
print(json.dumps({"repo": sys.argv[1], "title": sys.argv[2], "body": sys.argv[3], "labels": ["handoff-delegation"]}))' "$repo" "$title" "$body")")" || exit 3
    parent_num="$(printf '%s' "$reply" | python3 -c 'import json, sys; print(json.load(sys.stdin).get("number", ""))')"
    [ -n "$parent_num" ] || die "the tracker did not return an issue number for the bundle — check $repo before retrying."
    set_field "$f" external_ref "${ref_style}${parent_num}"
    set_field "$f" delegated_to "issue #$parent_num"
    log_activity "$f" "bundle delegated as parent issue #$parent_num in $repo by $(whoami_id)."
    made=$((made + 1))
    echo "Opened parent issue #$parent_num in $repo for bundle $id."
  else
    # export_bundle above re-rendered every brief and re-stamped `delegated_to` with the bare
    # recipient ("issue"), wiping the issue NUMBER a previous run recorded. Restore it: that field
    # is what `import --result --from-issue` matches on, so leaving the bare value would make a
    # resume silently break the return path on every unit that was already out there.
    set_field "$f" delegated_to "issue #$parent_num"
    echo "Bundle $id is already linked to #$parent_num — resuming into it."
  fi

  while IFS= read -r kid; do
    [ -n "$kid" ] || continue
    kf="$(doc_of "$kid" 2> /dev/null || true)"
    if [ -z "$kf" ] || [ ! -f "$kf" ]; then
      echo "⚠️  child $kid has no doc on this board — skipped" >&2
      continue
    fi
    kn="$(meta "$kf" external_ref)"
    kn="${kn#\#}"
    if [ -n "$kn" ]; then
      # Already out there from an earlier run. Its `delegated_to` was just flattened to "issue" by
      # the re-render above, so put the number back for the same reason as the parent. Still
      # collected for the link set, or a resumed run would drop the children it did not open.
      set_field "$kf" delegated_to "issue #$kn"
      child_nums="${child_nums:+$child_nums }$kn"
      skipped=$((skipped + 1))
      continue
    fi
    kbrief="$(meta "$kf" brief)"
    case "$kbrief" in /*) ;; *) kbrief="${REPO_DIR:+$REPO_DIR/}$kbrief" ;; esac
    [ -f "$kbrief" ] || die "the brief for child $kid was not written — issues already opened for this bundle are kept; re-run to resume."
    body="$(cat "$kbrief")
$(issue_result_footer)"
    reply="$(tracker_call create "$(python3 -c 'import json, sys
print(json.dumps({"repo": sys.argv[1], "title": sys.argv[2], "body": sys.argv[3], "labels": ["handoff-delegation"]}))' "$repo" "$(meta "$kf" title)" "$body")")" || exit 3
    kn="$(printf '%s' "$reply" | python3 -c 'import json, sys; print(json.load(sys.stdin).get("number", ""))')"
    [ -n "$kn" ] || die "the tracker did not return an issue number for child $kid — issues already opened for this bundle are kept; re-run to resume."
    set_field "$kf" external_ref "${ref_style}${kn}"
    set_field "$kf" delegated_to "issue #$kn"
    log_activity "$kf" "delegated as issue #$kn in $repo (child of bundle $id, issue #$parent_num) by $(whoami_id)."
    child_nums="${child_nums:+$child_nums }$kn"
    made=$((made + 1))
    echo "Opened issue #$kn in $repo for $kid."
  done <<< "$kids"

  # Links LAST, once every number is known — the same ordering cmd_mirror uses, and for the same
  # reason. `owned` names the issues this board opened, so a sub-issue someone attached by hand is
  # never reconciled away (ADR 0014, Decision 4). An adapter with no link support reports none and
  # is simply never asked again; the cover's Units list is the portable form.
  if [ -n "$child_nums" ]; then
    local lreq
    lreq="$(python3 -c 'import json, sys
kids = [int(n) for n in sys.argv[3].split()]
print(json.dumps({"repo": sys.argv[1], "number": int(sys.argv[2]), "children": kids,
                  "owned": sorted(set(kids) | {int(sys.argv[2])})}))' "$repo" "$parent_num" "$child_nums")"
    tracker_call update "$lreq" > /dev/null || exit 3
  fi

  cmd_index > /dev/null
  if [ "$made" -eq 0 ]; then
    echo "Nothing left to open — every unit of $id is already on $repo ($skipped child(ren) linked)."
  else
    echo "Bundle $id is on $repo as #$parent_num with $(printf '%s' "$child_nums" | wc -w | tr -d ' ') child issue(s)${skipped:+, $skipped already there}."
  fi
  echo "Each child returns on its own issue: handoff import --result --from-issue <child-id>"
}

# The instruction that turns an issue into a return path. Shared by the single-doc and the bundle
# export so an executor reads the same sentence whichever way the work reached them — two spellings
# of "how to answer" is exactly how one of them ends up subtly wrong.
issue_result_footer() {
  printf '%s' "
---
**Returning this result:** post ONE comment containing a line \`result_status: done\` (or \`partial\` / \`blocked\`) and the filled-in Result block, between the \`handoff:result:begin\` and \`handoff:result:end\` markers above. The board imports the most recent such comment for review; it never marks the work done on your word alone."
}

export_to_issue() { # id doc outdir branch do_claim force-secret
  local id="$1" f="$2" repo existing ref_style reply number brief body title
  # ADR 0017 — a document reaches the tracker of its home, and nowhere else.
  CUR_TRACKER="$(meta "$f" home)"
  existing="$(meta "$f" external_ref)"
  [ -z "$existing" ] || die "$id is already linked to $existing — it is not delegated to a second ticket. Nothing was sent."
  repo="$(require_tracker delegate)" || exit 3
  tracker_adapter > /dev/null || exit 3
  host_account_guard
  # The publication gate, before the brief is rendered or the lease taken — a refusal leaves nothing.
  if tracker_is_public "$repo"; then
    board_allows_public || die "$(public_refusal "$repo" "opening $id as an issue")"
    [ "$(meta "$f" share)" = public ] || die "$repo is public and $id is not marked share: public — only docs marked for public sharing are delegated there. Nothing was sent."
  fi
  # Decide how the issue number will be written BEFORE anything is created, so a pattern that
  # cannot hold it refuses here instead of leaving an orphaned issue behind.
  if printf '#1\n' | grep -Eqx -- "$(tracker_setting refPattern)" 2> /dev/null; then
    ref_style="#"
  elif printf '1\n' | grep -Eqx -- "$(tracker_setting refPattern)" 2> /dev/null; then
    ref_style=""
  else
    die "the refPattern of this handoff's tracker ($(tracker_setting refPattern)) would not accept an issue number as external_ref — fix the pattern before delegating to an issue."
  fi

  export_one "$id" "$f" "issue" "$3" "$4" "$5" "$6" > /dev/null || exit 3
  brief="$(meta "$f" brief)"
  case "$brief" in /*) ;; *) brief="${REPO_DIR:+$REPO_DIR/}$brief" ;; esac
  [ -f "$brief" ] || die "the brief for $id was not written — nothing was sent."
  body="$(cat "$brief")
$(issue_result_footer)"
  title="$(meta "$f" title)"
  reply="$(tracker_call create "$(python3 -c 'import json, sys
print(json.dumps({"repo": sys.argv[1], "title": sys.argv[2], "body": sys.argv[3], "labels": ["handoff-delegation"]}))' "$repo" "$title" "$body")")" || exit 3
  number="$(printf '%s' "$reply" | python3 -c 'import json, sys; print(json.load(sys.stdin).get("number", ""))')"
  [ -n "$number" ] || die "the tracker did not return an issue number — check $repo before retrying."
  set_field "$f" external_ref "${ref_style}${number}"
  set_field "$f" delegated_to "issue #$number"
  log_activity "$f" "delegated as issue #$number in $repo by $(whoami_id)."
  cmd_index > /dev/null
  echo "Opened issue #$number in $repo for $id. The reply comes back with: handoff import --result --from-issue $id"
}

# `import --result --from-issue <id>` — the return half. The executor answers in a COMMENT; the most
# recent comment carrying a result block is spliced into the brief this board rendered, with the
# commenter as result_by, and the existing `import --result` does the rest. Every refusal it makes
# (repo identity, empty result, secret scan, never delegated) applies unchanged, and it still never
# writes `status`.
import_result_from_issue() { # id [--force-repo] [--force-secret REASON]
  local id="${1:?usage: handoff import --result --from-issue <id> [--force-repo] [--force-secret REASON]}"
  shift
  local raw_id="$id" f ref number repo brief comments picked status author at block bf
  id="$(resolve_id "$id")" || die "unusable id: '$raw_id' (needs at least one letter or digit)"
  f="$(doc_of "$id")" || no_such "$id"
  # ADR 0017 — a document reaches the tracker of its home, and nowhere else.
  CUR_TRACKER="$(meta "$f" home)"
  case "$(meta "$f" delegated_to)" in
    "issue #"*) ;;
    *) die "$id was not delegated to an issue (delegated_to: $(meta "$f" delegated_to)) — use handoff import --result <brief-file>." ;;
  esac
  ref="$(meta "$f" external_ref)"
  number="${ref#\#}"
  case "$number" in '' | *[!0-9]*) die "$id's external_ref ($ref) is not an issue number." ;; esac
  repo="$(require_tracker delegate)" || exit 3
  brief="$(meta "$f" brief)"
  case "$brief" in /*) ;; *) brief="${REPO_DIR:+$REPO_DIR/}$brief" ;; esac
  [ -f "$brief" ] || die "the brief $brief is missing, so there is nothing to splice the result into."

  comments="$(tracker_call comments "{\"repo\": \"$repo\", \"number\": $number}")" || exit 3
  picked="$(printf '%s' "$comments" | python3 -c 'import json, re, shlex, sys
found = None
for c in json.load(sys.stdin):
    body = c.get("body", "")
    m = re.search(r"<!-- handoff:result:begin -->(.*?)<!-- handoff:result:end -->", body, re.S)
    s = re.search(r"^result_status:\s*(\S+)\s*$", body, re.M)
    if m and s:
        found = (c.get("author", ""), c.get("created_at", ""), s.group(1), m.group(1).strip("\n"))
if found:
    print("author=%s at=%s status=%s block=%s" % tuple(shlex.quote(v) for v in found))')"
  [ -n "$picked" ] || die "no result has been posted on issue #$number yet — a result comment carries a result_status line and the result block."
  # Tracker text arrives as shlex-quoted assignments, so a comment can never become shell syntax.
  # Keep every value inside shlex.quote above; an unquoted one would make this eval an injection.
  eval "$picked"

  # Written into the brief this board rendered, then read back by the ordinary import — so the one
  # file import_result trusts (the doc's own brief:) is the file that carries the result.
  set_field "$brief" result_status "$(fold_colons "$status")"
  set_field "$brief" result_by "$(fold_colons "$author")"
  set_field "$brief" result_at "$(fold_colons "$at")"
  splice_result "$brief" "$block"
  import_result "$brief" "$@"
}

# Classify every document for one mirror run: what travels (appended to `desired` as a rendered
# request), what must be closed out there (`gone`, with the reason a reader will see), and which
# issue numbers this board opened itself (`ownrefs`). Split out of cmd_mirror because
# `list --tracker` has to reach exactly this verdict and must not reach a different one — the
# sensitivity rules, the ADR 0013 share gate and the secret scan all live here, in the shell where
# the board's own rules are. Progress goes to stdout, so a caller that wants only the verdict
# discards it.
mirror_survey() { # desired-file gone-file ownrefs-file public(0|1) -> non-zero when a doc was refused
  local desired="$1" gone="$2" ownrefs="$3" public="$4" f base rendered hits refused=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    base="$(basename "$f" .md)"
    # ADR 0017 — a pass sees only the documents homed at its tracker. Everything the plan decides
    # (create, update, close) is built from this subset, so a pass can never close another
    # repository's issue: that issue's document is not in the set it reasons about.
    if [ "${MIRROR_MODE:-}" = trackers ] && [ "$(meta "$f" home)" != "$CUR_TRACKER" ]; then
      continue
    fi
    if is_standalone "$f"; then
      printf 'skip %s — standalone\n' "$base"
      continue
    fi
    if is_restricted "$f"; then
      printf 'skip %s — restricted\n' "$base"
      printf '%s\tno longer shared\n' "$base" >> "$gone"
      continue
    fi
    if is_orchestrator "$f" && [ -n "$(mirror_restricted_child "$f")" ]; then
      printf 'skip %s — restricted child\n' "$base"
      printf '%s\tno longer shared\n' "$base" >> "$gone"
      continue
    fi
    if [ "$public" = 1 ] && [ "$(meta "$f" share)" != public ]; then
      printf 'skip %s — not marked share: public\n' "$base"
      printf '%s\tno longer shared publicly — this issue stays visible\n' "$base" >> "$gone"
      continue
    fi
    if [ -n "$(meta "$f" external_ref)" ]; then
      printf 'skip %s — linked elsewhere (%s)\n' "$base" "$(meta "$f" external_ref)"
      printf '%s\tlinked to its own ticket\n' "$base" >> "$gone"
      # The board's own record that it opened this issue, kept whether or not the doc is still in
      # some bundle's roster (ADR 0014, Decision 4: marker OR external_ref).
      printf '%s\n' "$(meta "$f" external_ref)" | tr -cd '0-9\n' >> "$ownrefs"
      continue
    fi
    # ADR 0020 — always, not gated on this board's own remote: a tracker is off-machine by
    # definition, and before the secret scan so a rewritten path can never itself trip it.
    rendered="$(mirror_render "$f" "$public" "$(tracker_setting projection)" | machine_refs_filter)"
    if hits="$(printf '%s' "$rendered" | scan_secrets)"; then
      printf 'refuse %s — looks like it contains a credential (%s); nothing of it was sent\n' "$base" "$(printf '%s' "$hits" | tr '\n' ' ' | sed 's/ $//')"
      refused=1
      printf '%s\t\n' "$base" >> "$gone" # held: neither updated nor closed while it carries a secret
      continue
    fi
    printf '%s\n' "$rendered" >> "$desired"
  done < <(each_doc)
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    base="$(basename "$f" .md)"
    # ADR 0017 — a pass sees only the documents homed at its tracker. Everything the plan decides
    # (create, update, close) is built from this subset, so a pass can never close another
    # repository's issue: that issue's document is not in the set it reasons about.
    if [ "${MIRROR_MODE:-}" = trackers ] && [ "$(meta "$f" home)" != "$CUR_TRACKER" ]; then
      continue
    fi
    if [ -n "$(meta "$f" moved_to)" ]; then
      printf '%s\tmoved to another board\n' "$base" >> "$gone"
    else
      printf '%s\tclosed on the board as done\n' "$base" >> "$gone"
    fi
  done < <(each_archive)
  return "$refused"
}

# The drift report is GENERATED, like INDEX.md, and carries NO timestamp on purpose. The mirror is
# built to run unattended, and a file whose bytes changed on every run would make a scheduled job
# commit noise forever. It is written only when the set of diverging handoffs actually changes, and
# it is REMOVED the moment nothing diverges — so "no file" is the normal, quiet state, and its mere
# presence is the signal `list` and the session banner read.
write_drift_report() { # rows-file: marker<TAB>number<TAB>board-status<TAB>tracker-state
  local out new marker number status state
  out="$(drift_file)"
  if [ ! -s "$1" ]; then
    [ -f "$out" ] || return 0
    rm -f "$out"
    printf 'Removed %s — nothing diverges from the tracker any more.\n' "$out"
    return 0
  fi
  new="$(mktemp)" || die "mktemp failed"
  {
    echo "<!-- GENERATED by ./handoff mirror — do not edit by hand. -->"
    if grouped; then echo "# Tracker drift — $GROUP"; else echo "# Tracker drift"; fi
    echo
    echo "Issues that disagree with this board. Drift is **reported, never reconciled** (ADR 0014):"
    echo "a close made in the tracker never becomes \`done\` here — status changes on the board, with"
    echo "evidence (ADR 0011) — and the mirror neither reopens these issues nor sends them anything."
    echo
    echo "Resolve it on the board — \`handoff release <id> --status done --verified-by \"…\"\` once you"
    echo "have checked the live code — or reopen the issue in the tracker if it was closed by mistake."
    echo "Either way the next mirror run rewrites this file."
    echo
    echo "| Handoff | Issue | On the board | On the tracker |"
    echo "| --- | --- | --- | --- |"
    sort "$1" | while IFS=$'\t' read -r marker number status state; do
      [ -n "$marker" ] || continue
      # The marker is section-qualified; the table names the handoff by the id a reader would type.
      printf '| %s | #%s | %s | %s |\n' "${marker##*/}" "$number" "$status" "$state"
    done
  } > "$new"
  if [ -f "$out" ] && cmp -s "$new" "$out"; then
    rm -f "$new"
    return 0
  fi
  mkdir -p "$(dirname "$out")"
  cat "$new" > "$out"
  rm -f "$new"
  printf 'Wrote %s — %s handoff(s) diverge from the tracker.\n' "$out" "$(grep -c . "$1")"
}

# The live check behind `list --tracker`: the same verdict the mirror reaches, computed now against
# the tracker instead of read from the last run's report. It writes nothing — the report on disk
# still describes the last real mirror run, which is what makes the two readings comparable.
drift_live() { # -> rows from every pass, id<TAB>number<TAB>board-status<TAB>tracker-state
  local alias rc=0
  MIRROR_MODE="$(tracker_mode)"
  [ "$MIRROR_MODE" != none ] || return 1
  while IFS= read -r alias; do
    CUR_TRACKER="$alias"
    drift_live_pass || rc=1
  done <<< "$(tracker_aliases)"
  return "$rc"
}

drift_live_pass() { # -> this tracker's rows
  local repo existing desired gone ownrefs public=0
  repo="$(require_tracker mirror)" || return 1
  tracker_adapter > /dev/null || return 1
  if tracker_is_public "$repo" && ! board_allows_public; then
    echo "handoff: $repo reads as public and this board does not allow publishing to it, so the" >&2
    echo "         mirror would refuse the run outright — there is no drift to report (ADR 0013)." >&2
    return 1
  fi
  existing="$(tracker_call list "{\"repo\": \"$repo\"}")" || return 1
  BOARD_ID="$(board_identity)" || return 1
  existing="$(mirror_claim_tracker "$existing" 2> /dev/null)" || {
    echo "handoff: $repo is mirrored by another board, so this board has no drift to report there (ADR 0017)." >&2
    return 1
  }
  tracker_is_public "$repo" && public=1
  desired="$(mktemp)" || return 1
  gone="$(mktemp)" || return 1
  ownrefs="$(mktemp)" || return 1
  # The survey's progress lines are the mirror's narration, not this command's output.
  mirror_survey "$desired" "$gone" "$ownrefs" "$public" > /dev/null
  mirror_plan "$existing" "$desired" "$gone" | python3 -c 'import json, sys
for line in sys.stdin:
    parts = line.rstrip("\n").split("\t")
    if len(parts) == 4 and parts[0] == "drift":
        d = json.loads(parts[3])
        print("%s\t%s\t%s\t%s" % (parts[2].rsplit("/", 1)[-1], parts[1],
                                   d.get("status", "open"), d.get("state", "closed")))'
  rm -f "$desired" "$gone" "$ownrefs"
}

# One row's drift marker for a listing, or nothing. Matched on the document's own `id`, which is
# what the marker carries — a prefix-layout board's FILENAME also carries its section, and matching
# on that would silently find nothing.
drift_note() { # rows doc-path base -> "  ⚠️ tracker #N closed", or empty
  # No drift is the normal state, and this runs once per listed row: leave before reading anything.
  [ -n "$1" ] || return 0
  local id
  id="$(meta "$2" id)"
  [ -n "$id" ] || id="$3"
  printf '%s\n' "$1" | awk -F'\t' -v id="$id" '$1 == id { printf "  ⚠️ tracker #%s %s", $2, $4; exit }'
}

# The handoffs this section's drift report names, one `id<TAB>number<TAB>board-status<TAB>state`
# per line. Reads the generated file and nothing else, so it is offline and costs a single `sed`.
drift_rows() { # -> rows, or nothing when the file is absent (the quiet, normal state)
  local out
  out="$(drift_file)"
  [ -f "$out" ] || return 0
  sed -n 's/^| \([^ |][^|]*\) | #\([0-9]*\) | \([^|]*\) | \([^|]*\) |$/\1\t\2\t\3\t\4/p' "$out" \
    | sed 's/[[:space:]]*\t/\t/g; s/[[:space:]]*$//'
}

# `handoff mirror [--dry-run]` (ADR 0011, level 3). A ONE-WAY projection of this section's open work
# into the board's issue tracker, so teammates without board access can follow it. It never writes to
# the board: issues are found by a hidden marker, not by a stored number, and edits made in the
# tracker are overwritten on the next run.
# One tracker's pass: list, claim, survey this home's documents, plan, act, link. The preflight in
# cmd_mirror has already refused a public tracker that does not allow publishing, so this pass only
# needs to know WHETHER it is public, to send just the documents marked share: public.
mirror_pass() { # dry(0|1) drift-rows-file -> 0, or 1 when a document was refused
  local dry="$1" drift_all="$2"
  local repo existing plan desired="" gone="" refused=0
  repo="$(require_tracker mirror)" || exit 3
  [ "${MIRROR_MODE:-}" = trackers ] && echo "— ${CUR_TRACKER} → $repo"
  tracker_adapter > /dev/null || exit 3
  # No label filter: on GitHub a label-filtered listing lags a create, so a run right after another
  # could not see the issue it had just opened and made a second one (found in a live run). Issues
  # are matched by their hidden marker alone, which is part of the issue's own body.
  existing="$(tracker_call list "{\"repo\": \"$repo\"}")" || exit 3
  BOARD_ID="$(board_identity)" || exit 3
  local claim_err owners
  claim_err="$(mktemp)" || die "mktemp failed"
  if ! existing="$(mirror_claim_tracker "$existing" 2> "$claim_err")"; then
    owners="$(cat "$claim_err")"
    rm -f "$claim_err"
    die "$repo already carries issues mirrored by another board ($owners) — one board mirrors into a tracker (ADR 0017), and this one is $BOARD_ID. Nothing was sent. Mirror from that board, or move these handoffs onto it."
  fi
  rm -f "$claim_err"
  local public=0
  tracker_is_public "$repo" && public=1
  desired="$(mktemp)" || die "mktemp failed"
  gone="$(mktemp)" || die "mktemp failed"
  local ownrefs
  ownrefs="$(mktemp)" || die "mktemp failed"

  # Decide per document, in the shell where the board's own rules live (sensitivity, types, the
  # secret scanner). A rendered body is scanned before it can be planned.
  mirror_survey "$desired" "$gone" "$ownrefs" "$public" || refused=1

  plan="$(mirror_plan "$existing" "$desired" "$gone")"
  rm -f "$gone"
  # marker -> issue number, and the markers created in THIS run. The link pass needs both, and a
  # create's number is only knowable from its reply, so the reply is no longer thrown away.
  local nummap created drift
  nummap="$(mktemp)" || die "mktemp failed"
  created="$(mktemp)" || die "mktemp failed"
  drift="$(mktemp)" || die "mktemp failed"
  printf '%s' "$existing" | python3 -c 'import json, re, sys
for i in sorted(json.load(sys.stdin), key=lambda i: i["number"]):
    m = re.search(r"<!-- handoff:(.*?) -->", i.get("body", ""))
    if m:
        print("%s\t%d" % (m.group(1), i["number"]))' > "$nummap"
  local action number marker payload reply dstatus dstate
  while IFS=$'\t' read -r action number marker payload; do
    [ -n "$action" ] || continue
    [ "$action" = same ] && continue
    [ "$number" = - ] && number=""
    if [ "$action" = drift ]; then
      # Reported in both modes and acted on in neither — a dry run and a real run see the same
      # divergence, and neither sends the issue anything (ADR 0014).
      IFS=$'\t' read -r dstatus dstate <<< "$(printf '%s' "$payload" | python3 -c 'import json, sys
d = json.load(sys.stdin)
print("%s\t%s" % (d.get("status", "open"), d.get("state", "closed")))')"
      printf 'drift %s (#%s) — %s on the tracker, %s on the board\n' "${marker##*/}" "$number" "$dstate" "$dstatus"
      printf '%s\t%s\t%s\t%s\n' "$marker" "$number" "$dstatus" "$dstate" >> "$drift"
      continue
    fi
    if [ "$dry" = 1 ]; then
      printf '%s %s%s\n' "$action" "${marker##*/}" "${number:+ (#$number)}"
      continue
    fi
    case "$action" in
      create)
        reply="$(tracker_call create "$payload")" || exit 3
        number="$(printf '%s' "$reply" | python3 -c 'import json, sys; print(json.load(sys.stdin).get("number", ""))')"
        printf '%s\n' "$marker" >> "$created"
        printf '%s\t%s\n' "$marker" "$number" >> "$nummap"
        ;;
      update) tracker_call update "$payload" > /dev/null || exit 3 ;;
      close) tracker_call close "$payload" > /dev/null || exit 3 ;;
    esac
    printf '%s %s%s\n' "$action" "${marker##*/}" "${number:+ (#$number)}"
  done <<< "$plan"

  # Links last, once every marker's number is known (ADR 0014).
  local lnum lmarker lreq skipped
  while IFS=$'\t' read -r lnum lmarker lreq; do
    [ -n "$lnum" ] || continue
    if [ "$dry" = 1 ]; then
      printf 'link %s (#%s)\n' "${lmarker##*/}" "$lnum"
      continue
    fi
    reply="$(tracker_call update "$lreq")" || exit 3
    skipped="$(printf '%s' "$reply" | python3 -c 'import json, sys
try: print(json.load(sys.stdin).get("skipped") or "")
except Exception: print("")')"
    printf 'link %s (#%s)\n' "${lmarker##*/}" "$lnum"
    [ -n "$skipped" ] && [ "$skipped" != 0 ] && printf 'note %s — %s child issue(s) past the tracker cap stay in the checklist only\n' "${lmarker##*/}" "$skipped"
  done <<< "$(mirror_links "$existing" "$desired" "$nummap" "$created" "$ownrefs" "$drift")"
  # A dry run reports the divergence and leaves the report alone: it writes nothing, here as
  # everywhere else, so the file on disk still describes the last real run.
  cat "$drift" >> "$drift_all"
  rm -f "$desired" "$nummap" "$created" "$ownrefs" "$drift"
  return "$refused"
}

# ADR 0013 per tracker: every tracker a run will touch is asked for its visibility BEFORE any pass
# sends anything, so a public tracker without allowPublic refuses the whole run instead of stopping
# it half-way through. The listing of already-mirrored issues is kept, for the person who decides.
mirror_preflight() { # aliases -> 0, or dies
  local alias repo existing already proj
  # ADR 0018 — the board's own remote first, before any tracker (ADR 0013) is even asked, then the
  # host account — before any tracker's config is even read, let alone asked for anything.
  board_visibility_gate "$DIR"
  host_account_guard
  while IFS= read -r alias; do
    CUR_TRACKER="$alias"
    repo="$(require_tracker mirror)" || exit 3
    tracker_adapter > /dev/null || exit 3
    tracker_is_public "$repo" || continue
    # ADR 0020 — `complete` carries the whole record (Decisions, Ruled out, Evidence) and stays
    # private, full stop: refused on a public tracker even when allowPublic is set and every doc is
    # share: public. Checked here, in the same preflight and before board_allows_public, so a public
    # complete tracker never gets as far as ADR 0013's opt-in.
    proj="$(tracker_setting projection)"
    if [ "$proj" = complete ]; then
      die "trackers.${alias:-external} ($repo) is public (or its visibility could not be confirmed), and projection: complete never leaves this board on a public tracker (ADR 0020) — this holds even with allowPublic set. Set projection to full or summary for $repo, or move this tracker to a private repository. Nothing was sent."
    fi
    board_allows_public && continue
    # Refuse the WHOLE run, before any create, update or close — and list what is already out
    # there, because closing an issue hides nothing and a person has to decide what to do with it.
    existing="$(tracker_call list "{\"repo\": \"$repo\"}")" || exit 3
    already="$(printf '%s' "$existing" | python3 -c 'import json, re, sys
rows = ["#%d (%s) %s" % (i["number"], i.get("state", ""), i.get("title", ""))
        for i in json.load(sys.stdin) if re.search(r"<!-- handoff:.*? -->", i.get("body", ""))]
print(chr(10).join("         " + r for r in rows))')"
    die "$(public_refusal "$repo" "mirroring this board")${already:+
       Issues this mirror has already put there, for review (nothing was closed or deleted):
$already}"
  done <<< "$1"
}

# Documents no pass will carry, named so a run never drops one silently (ADR 0017).
mirror_report_homeless() { # aliases
  local f h a found
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    is_standalone "$f" && continue
    h="$(meta "$f" home)"
    if [ -z "$h" ]; then
      printf 'skip %s — no home; set one to mirror it\n' "$(basename "$f" .md)"
      continue
    fi
    found=0
    while IFS= read -r a; do [ "$a" = "$h" ] && found=1; done <<< "$1"
    [ "$found" = 1 ] || printf 'skip %s — home %s has no issue tracker\n' "$(basename "$f" .md)" "$h"
  done < <(each_doc)
}

# `handoff mirror [--dry-run] [--repo ALIAS]` — ADR 0011 level 3, routed per repository by ADR 0017.
# A preflight over every tracker, then one pass per tracker, then one drift report for the run.
cmd_mirror() {
  local dry=0 only=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run)
        dry=1
        shift
        ;;
      --repo)
        require_value --repo "$#" "${2:-}"
        only="$2"
        shift 2
        ;;
      *) die "unknown flag: $1 (usage: handoff mirror [--dry-run] [--repo ALIAS])" ;;
    esac
  done
  if board_is_grouped && [ -z "$GROUP" ]; then
    die "this board is sectioned ($BOARD_GROUPS); mirror one section at a time: HANDOFF_GROUP=<section> handoff mirror"
  fi
  MIRROR_MODE="$(tracker_mode)"
  [ "$MIRROR_MODE" != none ] || die "this board declares no tracker (no trackers block in $DIR/handoff.json; a single-repository board may use external) — nothing to mirror into."
  tracker_rules_reject_public
  local aliases a known
  aliases="$(tracker_aliases)"
  if [ "$MIRROR_MODE" = trackers ]; then
    [ "$(board_schema)" -ge 4 ] \
      || die "this board is schema $(board_schema); routing by home needs schema 4 — run './handoff migrate' first (ADR 0017)."
    trackers_trust_check
    if [ -n "$only" ]; then
      known=0
      while IFS= read -r a; do [ "$a" = "$only" ] && known=1; done <<< "$aliases"
      [ "$known" = 1 ] || die "--repo $only has no issue tracker on this board (issue trackers: $(printf '%s' "$aliases" | tr '\n' ' ' | sed 's/ $//'))."
      aliases="$only"
    fi
    if [ -z "$aliases" ]; then
      echo "This board declares no issue trackers — nothing to mirror."
      return 0
    fi
    mirror_report_homeless "$aliases"
  else
    [ -z "$only" ] || die "--repo needs a board with per-repository trackers (ADR 0017)."
  fi
  mirror_preflight "$aliases"
  local drift_all refused=0 alias
  drift_all="$(mktemp)" || die "mktemp failed"
  while IFS= read -r alias; do
    CUR_TRACKER="$alias"
    mirror_pass "$dry" "$drift_all" || refused=1
  done <<< "$aliases"
  # One drift file per run, from every pass: a handoff has one home, so its #N is unambiguous.
  [ "$dry" = 1 ] || write_drift_report "$drift_all"
  rm -f "$drift_all"
  [ "$dry" = 1 ] && echo "(dry run — nothing was sent)"
  [ "$refused" = 0 ] || {
    echo "handoff mirror: one or more documents were refused (see above) — redact them and re-run." >&2
    return 1
  }
  return 0
}

mirror_restricted_child() { # orchestrator-path -> the first restricted child id, or nothing
  local c cf
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    cf="$(doc_of "$c" 2> /dev/null)" || continue
    is_restricted "$cf" && {
      printf '%s' "$c"
      return
    }
  done <<< "$(children_of "$1")"
}

# One document -> one JSON object: its marker, and the exact create/update request. Only the parts a
# teammate needs travel: Current state, Context and Verify for work, the Bundle prose and a child
# checklist for a bundle. Template guidance comments are stripped; the footer says who owns the text.
mirror_render() { # doc-path public(0|1) projection(summary|full) -> JSON line
  local f="$1" public="${2:-0}" projection="${3:-summary}" kids="" c cf
  if is_orchestrator "$f"; then
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      if cf="$(doc_of "$c" 2> /dev/null)"; then
        kids="${kids}$(meta "$cf" status)"$'\t'"$(meta "$cf" title)"$'\t'"$c"$'\t'"$(meta "$cf" share)"$'\t'"$(meta "$cf" external_ref)"$'\n'
      else
        kids="${kids}missing"$'\t'$'\t'"$c"$'\t'$'\t'$'\n'
      fi
    done <<< "$(children_of "$f")"
  fi
  python3 - "$f" "${GROUP:-}" "$kids" "$(doc_type "$f")" "$(doc_env "$f")" "$public" "$BOARD_ID" "$projection" << 'PY'
import json, re, sys

path, group, kids, dtype, env, public, bid, projection = sys.argv[1:9]
text = open(path).read()
fm, _, body = text.partition("\n---\n") if text.startswith("---\n") else ("", "", text)
meta = {}
for line in fm.splitlines()[1:]:
    k, sep, v = line.partition(":")
    if sep:
        meta[k.strip()] = v.strip().strip('"')


def section(name):
    m = re.search(r"^## %s\s*$(.*?)(?=^## |\Z)" % re.escape(name), body, re.M | re.S)
    if not m:
        return ""
    s = re.sub(r"<!--.*?-->", "", m.group(1), flags=re.S)
    return re.sub(r"\n{3,}", "\n\n", s).strip()


doc_id = meta.get("id") or path.rsplit("/", 1)[-1][:-3]
# ADR 0017 — BOARD/SECTION/ID: the board identity first, so a second board can see it is not its own.
marker = "%s/%s%s" % (bid, group + "/" if group else "", doc_id)
parts = []
linkable, child_refs = [], {}
if dtype == "orchestrator":
    if section("Bundle"):
        parts.append("## Bundle\n\n" + section("Bundle"))
    rows, hidden = [], 0
    for row in kids.splitlines():
        status, title, cid, share, ref = (row.split("\t") + ["", "", "", "", ""])[:5]
        # On a public repository a child that is not itself marked public is COUNTED, never named:
        # its id is a slug of its title, so even the id would leak what nobody chose to publish.
        if public == "1" and share != "public":
            hidden += 1
            continue
        if status == "missing":
            rows.append("- [ ] %s (not filed yet)" % cid)
        else:
            rows.append("- [%s] %s (`%s`)" % ("x" if status == "done" else " ", title or cid, cid))
            # Linkable children are exactly the ones the checklist may name (ADR 0014). Computing
            # this here rather than in the link pass is deliberate: the public share gate above is
            # the only copy, so a second pass cannot diverge from it and leak a link.
            linkable.append(cid)
            # A child DELEGATED as an issue is skipped by the mirror (it is "linked elsewhere"), so
            # it never gets a marker and no marker lookup can find it. Its issue number is on the
            # child's own doc, as external_ref -- the second lookup key (Decision 6), which is what
            # lets one bundle issue hold a mix of mirrored and delegated children.
            r = ref.lstrip("#")
            if r.isdigit():
                child_refs[cid] = int(r)
    if hidden:
        rows.append("- and %d more item%s not shared publicly" % (hidden, "" if hidden == 1 else "s"))
    parts.append("## Children\n\n" + "\n".join(rows))
else:
    # ADR 0017 — a summary unless the tracker opted into more; ADR 0020 — `complete` adds Decisions,
    # Ruled out and Evidence on top of `full`. Never Activity (it gains a line on every checkpoint,
    # which would rewrite the issue body and notify every watcher on every run) and never `note`.
    if projection == "complete":
        names = ("Current state", "Context", "Verify", "Decisions", "Ruled out")
    elif projection == "full":
        names = ("Current state", "Context", "Verify")
    else:
        names = ("Current state",)
    for name in names:
        if section(name):
            parts.append("## %s\n\n%s" % (name, section(name)))
    if projection == "complete" and meta.get("verified_by"):
        parts.append("## Evidence\n\n%s" % meta["verified_by"])
parts.append("---\n_Managed by the handoff mirror from `%s` — edits made here are overwritten on the next run._\n\n<!-- handoff:%s -->" % (marker, marker))
labels = ["handoff-mirror", "status:%s" % meta.get("status", "open")]
if dtype == "orchestrator":
    labels.append("type:bundle")
else:
    if meta.get("severity"):
        labels.append("severity:%s" % meta["severity"])
    labels.append("env:%s" % env)
    # Who acts next, as a label: an audience flip relabels this issue and never moves it (ADR 0017).
    if meta.get("audience"):
        labels.append("audience:%s" % meta["audience"])
    # ADR 0015. The DOCUMENT is the source of truth and the label is a projection, exactly as
    # `status:` and `type:` are -- so a teammate reading the tracker can see how a piece of work is
    # being executed without opening the board. Only when the doc states a kind: a doc that was
    # never handed out has none, and inventing one here would assert something nobody decided.
    if meta.get("executed_by") in ("hitl", "afk"):
        labels.append("mode:%s" % meta["executed_by"])
if group:
    labels.append("section:%s" % group)
# The reviewer pointer, projected as the tracker's assignee -- the only mechanism in this system
# that actually reaches a PERSON (a `status:` label reaches whoever is already looking). It is a
# list because trackers model assignment as one, not because the board has more than one reviewer.
#
# There is no public-share test here ON PURPOSE. `mirror_survey` already drops any doc that is not
# `share: public` before it is rendered on a public repository (ADR 0013), so a handle cannot reach
# a public tracker through this line. A second copy of that gate could only diverge from the first,
# and the divergence would leak a login -- the same reason `linkable` above computes the child gate
# exactly once.
assignees = [meta["reviewer"]] if meta.get("reviewer") else []
print(json.dumps({"marker": marker, "id": doc_id, "title": meta.get("title", doc_id),
                  "body": "\n\n".join(parts) + "\n", "labels": labels, "children": linkable,
                  "child_refs": child_refs, "assignees": assignees}))
PY
}

# Reconcile what the tracker holds against what the board wants. Pure: reads JSON, prints actions
# "action<TAB>number<TAB>marker<TAB>request-json". The shell executes them (or prints them on
# --dry-run). An issue is matched ONLY by its hidden marker — the delegation issues and anything a
# person filed carry none, so the mirror cannot touch them.
mirror_plan() { # existing-json desired-file gone-file
  python3 - "$1" "$2" "$3" "$(tracker_setting repo)" "${GROUP:-}" "$BOARD_ID" << 'PY'
import json, re, sys

existing = json.loads(sys.argv[1] or "[]")
desired = [json.loads(l) for l in open(sys.argv[2]) if l.strip()]
gone = {}
for line in open(sys.argv[3]):
    doc, _, reason = line.rstrip("\n").partition("\t")
    gone[doc] = reason
repo, group, bid = sys.argv[4], sys.argv[5], sys.argv[6]
# This board's markers in this section: BID/SECTION/ID, or BID/ID on an unsectioned board.
prefix = bid + "/" + (group + "/" if group else "")
# The label prefixes mirror_render writes. Only these are compared, and the adapter is told to
# reconcile only these, so a label a person added by hand survives every run.
MANAGED = ["handoff-", "status:", "severity:", "env:", "section:", "type:", "mode:", "audience:"]

by_marker = {}
out = []
for i in sorted(existing, key=lambda i: i["number"]):
    m = re.search(r"<!-- handoff:(.*?) -->", i.get("body", ""))
    if not m:
        continue
    kept = by_marker.get(m.group(1))
    if kept is None:
        by_marker[m.group(1)] = i  # the lowest-numbered issue for a marker is the one that stays
    elif i.get("state") == "open":
        out.append(("close", str(i["number"]), m.group(1), {
            "repo": repo, "number": i["number"],
            "comment": "Closed by the handoff mirror: duplicate of #%d." % kept["number"]}))

wanted = set()
for d in desired:
    wanted.add(d["marker"])
    req = {"repo": repo, "title": d["title"], "body": d["body"], "labels": d["labels"]}
    have = by_marker.get(d["marker"])
    if have is None:
        # Assigned on CREATE and never afterwards, which is ADR 0014's existing rule for links
        # applied to the assignee for the same reason: reassigning in the tracker is a legitimate
        # human act -- the reviewer is on leave, the team rotates -- and a board that reconciled it
        # would fight the person every run and always win. Note what follows from that: `assignees`
        # is absent from the `same` comparison below, so a reassignment is not drift and does not
        # even mark the issue as needing an update.
        out.append(("create", "", d["marker"],
                    dict(req, assignees=d["assignees"]) if d.get("assignees") else req))
        continue
    same = (have.get("state") == "open" and have.get("title") == d["title"]
            and have.get("body", "").strip() == d["body"].strip()
            and sorted(l for l in have.get("labels", []) if l.startswith(tuple(MANAGED)))
            == sorted(d["labels"])
            and not have.get("_legacy"))
    if same:
        out.append(("same", str(have["number"]), d["marker"], {}))
        continue
    if have.get("state") != "open":
        # TRACKER DRIFT (ADR 0014). The board still wants this work and the tracker says it is
        # finished. The mirror neither reopens the issue nor sends it anything: a close made in the
        # tracker is a person's judgement, and a `done` on the board needs evidence (ADR 0011).
        # It is reported, and the run still exits zero.
        status = next((l.split(":", 1)[1] for l in d["labels"] if l.startswith("status:")), "open")
        out.append(("drift", str(have["number"]), d["marker"],
                    {"status": status, "state": have.get("state", "closed")}))
        continue
    req = dict(req, number=have["number"], managed=MANAGED)
    out.append(("update", str(have["number"]), d["marker"], req))

for marker, i in sorted(by_marker.items()):
    if marker in wanted or not marker.startswith(prefix) or "/" in marker[len(prefix):]:
        continue
    if i.get("state") != "open":
        continue
    doc = marker[len(prefix):]
    reason = gone.get(doc, "no longer on the board")
    if doc in gone and gone[doc] == "":
        continue  # held while it carries a secret: not updated, not closed
    out.append(("close", str(i["number"]), marker, {"repo": repo, "number": i["number"],
                                                     "comment": "Closed by the handoff mirror: %s." % reason}))
for action, number, marker, req in out:
    # "-" for no number: `read` collapses consecutive tabs, so an empty field would shift the rest.
    print("%s\t%s\t%s\t%s" % (action, number or "-", marker, json.dumps(req)))
PY
}

# A bundle's parent/child relationship in the tracker's own native form (ADR 0014). This runs AFTER
# the create/update/close loop, and it has to: `mirror_plan` builds every request before any action
# executes, so a parent's request cannot name a child issue number that does not exist yet. On a
# first run none of them do.
#
# The board speaks issue NUMBERS end to end. Resolving a number to whatever identifier an API wants
# is the adapter's business -- GitHub's sub-issue endpoints name the child by its internal database
# id, which nothing on the board ever holds.
#
# Whether an adapter supports links at all is read from its `list` reply: a row carrying "children"
# can be linked, one without it cannot, so there is no capability probe. A parent CREATED in this
# run has no row to read, so its links are sent once regardless.
mirror_links() { # existing-json desired-file nummap-file created-file ownrefs-file drift-file
  python3 - "$1" "$2" "$3" "$4" "$5" "$(tracker_setting repo)" "$6" << 'PYLINKS'
import json, re, sys

existing = json.loads(sys.argv[1] or "[]")
desired = [json.loads(l) for l in open(sys.argv[2]) if l.strip()]
num = {}
for line in open(sys.argv[3]):
    marker, _, n = line.rstrip("\n").partition("\t")
    if n:
        # setdefault, over input sorted by number: a marker with a DUPLICATE issue links the one
        # that is kept -- the lowest-numbered -- and never the duplicate the run is closing.
        num.setdefault(marker, int(n))
created = {l.strip() for l in open(sys.argv[4]) if l.strip()}
own_refs = {int(l) for l in (x.strip() for x in open(sys.argv[5])) if l.isdigit()}
repo = sys.argv[6]
# A parent whose own issue is closed in the tracker has DRIFTED (ADR 0014): the mirror sends it
# nothing at all, and a link is something sent. Its children keep whatever links they already have.
drifted = {l.split("\t")[0] for l in open(sys.argv[7]) if l.strip()}
MANAGED = ["handoff-", "status:", "severity:", "env:", "section:", "type:", "mode:", "audience:"]

# Rows by marker, and the numbers of issues the mirror itself made. A link to anything outside that
# set belongs to a person: never counted as drift, never removed (Decision 4).
rows, ours = {}, set()
for i in sorted(existing, key=lambda i: i["number"]):
    m = re.search(r"<!-- handoff:(.*?) -->", i.get("body", ""))
    if not m:
        continue
    ours.add(i["number"])
    rows.setdefault(m.group(1), i)
# An issue this board delegated is also the mirror's to link and unlink, even though it carries no
# marker -- a doc's external_ref is the board's own record of having opened it (Decision 4 reads
# "marker OR external_ref"). Board-wide, not per-roster: a child dropped from a bundle must still be
# recognised as ours, or its link could never be taken down. An issue named by neither belongs to a
# person and is never touched.
ours.update(own_refs)

for d in desired:
    if d["marker"] in drifted:
        continue
    kids = d.get("children") or []
    refs = d.get("child_refs") or {}
    parent = num.get(d["marker"])
    if parent is None:
        continue
    prefix = d["marker"][: len(d["marker"]) - len(d["id"])]
    # Hidden marker first, then external_ref (Decision 6).
    want = sorted(n for n in (num.get(prefix + c, refs.get(c)) for c in kids) if n is not None)
    have = rows.get(d["marker"])
    if d["marker"] not in created:
        if have is None or "children" not in have:
            continue  # this adapter does not report links, so it is never asked to make them
        # Compare only against links the mirror owns, or a hand-attached child reads as drift and
        # every run sends a pointless update.
        if want == sorted(n for n in have.get("children", []) if n in ours):
            continue
    elif not want:
        continue  # a brand-new parent with nothing to link needs no call at all
    # "owned" is every issue the mirror itself made, so the adapter knows which links are its to
    # remove without re-deriving it from bodies or labels. Same principle as "managed" for labels:
    # the CLI holds the rule, the adapter is told it on every call.
    print("%d\t%s\t%s" % (parent, d["marker"],
                           json.dumps({"repo": repo, "number": parent, "children": want,
                                       "owned": sorted(ours), "managed": MANAGED})))
PYLINKS
}

validate_external_ref() { # ref -> prints the ref as stored; non-zero with a message when refused
  local ref pat
  ref="$(fold_colons "$1")"
  pat="$(tracker_setting refPattern)"
  # No home resolves a tracker for a standalone doc, which carries none (ADR 0017) — but a reference
  # is a pointer, not a projection, so it is checked against EVERY tracker the board declares and
  # accepted if any of them would take it. Refusing here would take level 1 away from reference docs
  # on a per-repository board, which nothing in ADR 0011 or 0017 intends.
  if [ -z "$pat" ] && [ "$(tracker_mode)" = trackers ]; then
    local alias
    while IFS= read -r alias; do
      [ -n "$alias" ] || continue
      pat="$(CUR_TRACKER="$alias" tracker_setting refPattern)"
      [ -n "$pat" ] && printf '%s\n' "$ref" | grep -Eqx -- "$pat" && {
        printf '%s' "$ref"
        return 0
      }
    done <<< "$(tracker_aliases_all)"
    if [ -n "$(tracker_aliases_all)" ]; then
      echo "handoff: --ref '$ref' does not match the refPattern of any tracker this board declares ($(tracker_aliases_all | tr '\n' ' ' | sed 's/ $//'))." >&2
      return 1
    fi
  fi
  if [ -z "$pat" ]; then
    echo "handoff: this board attaches no external tracker for ${CUR_TRACKER:-it} (no refPattern in $DIR/handoff.json), so --ref has nothing to point into." >&2
    return 1
  fi
  # -x: the WHOLE reference must match. A substring match would accept "see ABC-12 please".
  if ! printf '%s\n' "$ref" | grep -Eqx -- "$pat"; then
    echo "handoff: --ref '$ref' does not match the refPattern of the tracker for ${CUR_TRACKER:-this board} ($pat)." >&2
    return 1
  fi
  printf '%s' "$ref"
}

# A reviewer handle, validated rather than folded. Every other free-text frontmatter value goes
# through fold_colons, which turns a `:` into an em dash so the unquoted YAML stays parseable — the
# right answer for prose, and the wrong one here. A handle is an IDENTIFIER: it is projected as a
# tracker assignee, so a silently mangled one is not a cosmetic blemish but an assignment to a user
# that does not exist, reported once by the adapter and then invisible. Refuse instead, and say so.
#
# The shape is deliberately permissive about WHICH tracker: the board declares that, and a handle
# that is legal on one system is not on another. What it refuses is what no tracker accepts and what
# would break the frontmatter — whitespace, a colon, a quote, a comma, a bracket. A leading `@` is
# accepted and stripped, because that is how people write handles and storing both spellings would
# make two docs naming one person compare unequal.
validate_reviewer() { # handle -> prints the handle as stored; non-zero with a message when refused
  local h="${1#@}"
  if [ -z "$h" ]; then
    echo "handoff: --reviewer needs a tracker handle (the login the work is assigned to), not an empty value." >&2
    return 1
  fi
  case "$h" in
    *[[:space:]]* | *:* | *\"* | *\'* | *,* | *\[* | *\]* | *'#'*)
      echo "handoff: --reviewer '$1' is not a usable handle — no whitespace, colons, quotes, commas, brackets or '#'." >&2
      echo "         It is stored verbatim and projected as a tracker assignee, so it is refused rather than reshaped." >&2
      return 1
      ;;
  esac
  # Leading punctuation is the one shape worth calling out separately: `-alice` is a plausible typo
  # for `alice` and GitHub rejects it, so catching it here beats learning from the adapter.
  case "$h" in
    [!A-Za-z0-9]*)
      echo "handoff: --reviewer '$1' must start with a letter or digit." >&2
      return 1
      ;;
  esac
  printf '%s' "$h"
}

# ADR 0011 — a progress checkpoint. Progress used to reach the team only at `release`, and `touch`
# extends a lease without carrying any, so a long piece of work was invisible until it ended. This
# rewrites `## Current state` (or, with no text, takes the doc as the holder already edited it),
# commits and pushes like a release, and KEEPS the lease: the work is still yours.
#
# Only the live holder may checkpoint, proven by session id exactly as lease_is_mine proves it. The
# edit gate already stops a non-holder editing the doc; a checkpoint that pushed someone else's
# lease-protected doc would walk straight around it.
cmd_checkpoint() { # <id> [current-state text] [--force-secret REASON]
  local id="${1:?usage: handoff checkpoint <id> [\"current state\"] [--force-secret REASON]}"
  shift
  local raw_id="$id" text="" force_secret=""
  id="$(resolve_id "$id")" || die "unusable id: '$raw_id' (needs at least one letter or digit)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --force-secret)
        require_value --force-secret "$#" "${2:-}"
        force_secret="$2"
        shift 2
        ;;
      *)
        reject_unknown_flag "$1" "the Current state text is a trailing positional, not a flag"
        text="${text:+$text }$1"
        shift
        ;;
    esac
  done
  local f
  f="$(doc_of "$id")" || no_such "$id"
  require_writable "$f" "$id"
  is_standalone "$f" && die "$id is a standalone handoff — there is no lease to keep; edit it and commit."
  is_orchestrator "$f" && die "$id is an orchestrator — its state is derived from its children; checkpoint a child."
  [ "$(meta "$f" status)" = "done" ] && die "$id is done — nothing to checkpoint"
  local kind owner exp
  IFS='|' read -r kind owner exp <<< "$(lock_state "$(lock_key "$id")")"
  [ "$kind" = "free" ] && die "$id is not claimed — claim it first: handoff claim $id"
  lease_is_mine "$id" || die "this session does not hold the lease on $id (held by ${owner:-unknown}, $kind). Only the holder can checkpoint it.$(advisory_hint)"

  # Build what will be published first, then scan ALL of it. A checkpoint pushes the whole doc, so
  # scanning only the new text let a credential pasted into the doc by hand ride along — and a
  # text-less checkpoint, which exists to publish hand edits, scanned nothing at all.
  local t tf hits=""
  t="$(mktemp)" || die "mktemp failed"
  if [ -n "$text" ]; then
    tf="$(mktemp)" || die "mktemp failed"
    printf '%s\n' "$text" > "$tf"
    # Body read from a file with getline, never passed through `awk -v` (see set_field): the text is
    # free-form and must land byte-for-byte. A doc that predates the section gets one above Context.
    awk -v tf="$tf" '
      function body() { print ""; while ((getline line < tf) > 0) print line; close(tf); print "" }
      /^## Current state$/ { print; body(); skip = 1; done = 1; next }
      skip && /^## / { skip = 0 }
      !done && /^## Context$/ { print "## Current state"; body(); done = 1 }
      !skip { print }
    ' "$f" > "$t"
    rm -f "$tf"
  else
    cat "$f" > "$t"
  fi
  if hits="$(scan_secrets < "$t")" && [ -z "$force_secret" ]; then
    rm -f "$t"
    die_on_secret "the checkpoint of $id" "$hits"
  fi
  cat "$t" > "$f"
  rm -f "$t"
  set_field "$f" updated "$(today)"
  if [ -n "$force_secret" ] && [ -n "$hits" ]; then
    log_secret_override "$f" "checkpoint secret-scan OVERRIDDEN" "$hits" "$force_secret"
  fi
  log_activity "$f" "checkpoint by $(whoami_id) — lease kept."
  # ADR 0020 — after the doc is fully updated, before it is committed/pushed below.
  [ -n "$(board_remote)" ] && machine_refs_file "$f"
  lease_index > /dev/null
  release_commit_push "handoff: checkpoint $id" "$f"
  echo "Checkpointed $id — Current state published, lease kept."
}

# Every release path ends the same way: drop the lease, then regenerate the index. It is a helper
# rather than three copies because the standalone and orchestrator branches `return` early and used
# to skip the `clear_lock` at the function's end — stranding any lease held on a doc that was
# reclassified into one of those types after being claimed (`claim` refuses both types, so that
# conversion is the only way a lease gets onto one). The lease then survived until the TTL reap,
# and neither `release` nor `claim` could clear it: the board read as work-in-progress for hours.
finish_release() { # id status
  clear_lock "$(lock_key "$1")"
  _release_subject="handoff: release $1 ($2)"
  # A closed handoff is no longer awaiting review; leaving `review: pending` set would make a
  # reopened doc read as pending against a review that already happened. doc_of searches active
  # THEN archive, so this reaches the doc whether or not a `done` release above already moved it.
  #
  # Cleared ONLY on a `done` release. `review: pending` means "an outsider's claim is sitting here
  # unreviewed"; only `done` means a human actually looked at it. `open`/`blocked` release the
  # lease without reviewing anything — clearing the marker on those releases (the previous
  # behavior, which checked only that a review WAS pending, not what kind of release this is) let
  # an orchestrator import a result, then release --status open to hand review to someone else, and
  # have that very release erase the "needs a reviewer" signal it was trying to hand off. Also
  # never stamp on an ACTUAL absent field (no review field, or mid-delegation with no result
  # imported yet) — stamping those as reviewed too would silently hide the delegation marker in
  # `list` for work that was never looked at.
  local rf
  rf="$(doc_of "$1" 2> /dev/null)"
  [ "${2:-}" = "done" ] && [ -n "$rf" ] && [ "$(meta "$rf" review)" = "pending" ] && set_field "$rf" review done
  # ADR 0020 — every release path (coordination, standalone, orchestrator) funnels through here,
  # so this one call covers all of them: after the doc is fully updated, before it is
  # committed/pushed below. Runs whether the doc is still live or was just archived — $rf already
  # points wherever it landed.
  [ -n "$rf" ] && [ -n "$(board_remote)" ] && machine_refs_file "$rf"
  lease_index
  # Optimistic by design: this records something that already happened, so a failure to reach the
  # remote is a warning and the release still stands. See release_commit_push.
  release_commit_push "$_release_subject" "$rf"
}

cmd_release() {
  local id="${1:?usage: handoff release <id> --status open|blocked|done [--for-review] [--reviewer HANDLE] [--verified-by \"...\"] [--blocked-on \"...\"] [--ruled-out \"approach — why — evidence\"] [--run-verify] [--force-secret REASON] [note]}"
  shift
  local raw_id="$id"
  id="$(resolve_id "$id")" || die "unusable id: '$raw_id' (needs at least one letter or digit)"
  local status='' note='' verified_by='' blocked_on='' ruled_out='' run_verify=0 force_secret='' for_review=0
  local reviewer='' reviewer_set=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force-secret)
        require_value --force-secret "$#" "${2:-}"
        force_secret="$2"
        shift 2
        ;;
      --status)
        status="${2:?}"
        shift 2
        ;;
      --verified-by)
        verified_by="${2:?}"
        shift 2
        ;;
      --blocked-on)
        blocked_on="${2:?}"
        shift 2
        ;;
      --ruled-out)
        require_value --ruled-out "$#" "${2:-}"
        ruled_out="$2"
        shift 2
        ;;
      --run-verify)
        run_verify=1
        shift
        ;;
      --for-review)
        for_review=1
        shift
        ;;
      --reviewer)
        require_value --reviewer "$#" "${2:-}"
        reviewer="$2"
        reviewer_set=1
        shift 2
        ;;
      *)
        reject_unknown_flag "$1" "the note is a trailing positional, not a flag"
        note="$note $1"
        shift
        ;;
    esac
  done
  # `--for-review` says the work is finished as far as the executor can tell and a reviewer acts
  # next, so it implies the one status that can carry that: the doc is still live work. It is a flag
  # on `open` rather than a fourth status because `status` is the lifecycle and review is orthogonal
  # to it — which is why `review` is already its own field (ADR 0015).
  [ "$for_review" = 1 ] && [ -z "$status" ] && status=open
  [ -n "$status" ] || die "release needs --status open|blocked|done"
  case "$status" in open | blocked | done) ;; *) die "bad status: $status" ;; esac
  # Contrary instructions, refused rather than silently resolved in either direction: one of them
  # archives the doc and the other exists to keep it on the board.
  if [ "$for_review" = 1 ] && [ "$status" = "done" ]; then
    die "--for-review hands work back for someone else to close; --status done closes it yourself. Pick one."
  fi
  # `--reviewer` names who acts next, which is only a thing a hand-back says. On a plain
  # open/blocked/done release there is no such moment: nobody is being asked to look, and recording
  # a reviewer there would leave a pointer at work that is not waiting on anyone. Refused rather
  # than ignored, so a mistyped hand-back does not silently lose the handle.
  if [ "$reviewer_set" = 1 ] && [ "$for_review" != 1 ]; then
    die "--reviewer names who reviews the work you are handing back, so it needs --for-review. To retarget a doc you are not handing back, edit its reviewer under your lease."
  fi
  [ "$reviewer_set" = 1 ] && { reviewer="$(validate_reviewer "$reviewer")" || exit 3; }

  local f
  f="$(doc_of "$id")" || no_such "$id"
  require_writable "$f" "$id"
  local me
  me="$(whoami_id)"

  # The write-path scanner (ADR 0005), before ANY branch below writes a field, archives a doc, or
  # touches a lease. `release` is the command that most often carries pasted output — an evidence
  # line is frequently a copied terminal session, and terminal sessions are where credentials
  # appear. Everything a release can put into the permanently-committed doc goes through here:
  # the evidence, the blocker, and the free-text note.
  local rel_hits=""
  if rel_hits="$(printf '%s\n%s\n%s\n%s\n' "$verified_by" "$blocked_on" "$ruled_out" "$note" | scan_secrets)"; then
    if [ -z "$force_secret" ]; then
      die_on_secret "the release of $id" "$rel_hits"
    fi
    log_secret_override "$f" "release secret-scan OVERRIDDEN" "$rel_hits" "$force_secret"
    echo "⚠️  Secret scan overridden — recorded on $id's activity log."
  fi

  # A bundle holds no work of its own and a standalone doc makes no attempt at any, so neither has an
  # approach to rule out. Refused before either branch writes anything.
  if [ -n "$ruled_out" ] && { is_orchestrator "$f" || is_standalone "$f"; }; then
    die "--ruled-out applies to coordination handoffs — $id is $(doc_type "$f") and has no work of its own to rule out"
  fi

  # Same reasoning, same place. A bundle's state is derived from its children, so there is nothing
  # on it for a reviewer to look at; a standalone doc carries no lease and makes no claim about live
  # code, so it never had a closer to hand anything back to.
  if [ "$for_review" = 1 ] && { is_orchestrator "$f" || is_standalone "$f"; }; then
    die "--for-review applies to coordination handoffs — $id is $(doc_type "$f") and has no work of its own to hand back"
  fi

  if is_orchestrator "$f"; then
    # An orchestrator carries no lease of its own. `done` is the one place the bundle relationship
    # is enforced: a bundle is finished exactly when every child is finished, so closing it while a
    # child is still open (or names no file at all) is refused. That check is what stops an
    # orchestrator from becoming the stale summary doc it exists to replace.
    local prog pdone ptotal pout
    prog="$(child_progress "$f")"
    pdone="${prog%%|*}"
    ptotal="$(printf '%s' "$prog" | cut -d'|' -f2)"
    pout="${prog#*|*|}"
    case "$status" in
      open)
        set_field "$f" status open
        set_field "$f" updated "$(today)"
        log_activity "$f" "updated (orchestrator, $pdone/$ptotal children done) by $me.${note}"
        echo "Updated orchestrator $id — $pdone/$ptotal children done.${pout:+ Outstanding: $pout}"
        ;;
      done)
        [ "$ptotal" -gt 0 ] || die "$id has no children — add them with 'handoff children add $id <child>' before closing the bundle"
        [ "$pdone" -eq "$ptotal" ] || die "$id still has outstanding children: $pout"
        set_field "$f" status done
        set_field "$f" updated "$(today)"
        set_field "$f" verified_at "$(today)"
        log_activity "$f" "bundle complete — all $ptotal children done. Closed by $me.${note}"
        if archive_doc "$f" "$id"; then
          echo "✅ Bundle $id complete ($ptotal/$ptotal children done) → archive/."
        else
          warn_archive_failed "$id"
        fi
        surface_unblocked "$id" # a doc may be blocked on this bundle landing
        ;;
      *) die "orchestrators support --status open|done (a bundle has no lease to block on)" ;;
    esac
    finish_release "$id" "$status"
    return
  fi

  if is_standalone "$f"; then
    # A standalone/reference doc carries no lease and makes no live-code claim, so `done`
    # just retires it (archive) with no --verified-by. Only open|done apply.
    case "$status" in
      open)
        set_field "$f" status open
        set_field "$f" updated "$(today)"
        log_activity "$f" "updated (standalone) by $me.${note}"
        echo "Updated standalone $id."
        ;;
      done)
        set_field "$f" status done
        set_field "$f" updated "$(today)"
        log_activity "$f" "retired (standalone) by $me.${note}"
        if archive_doc "$f" "$id"; then
          echo "✅ Retired standalone $id → archive/."
        else
          warn_archive_failed "$id"
        fi
        # Every path that closes a doc must announce its dependents. This branch is newer than the
        # unblock feature and originally skipped it, so anything blocked on a standalone deadlocked.
        surface_unblocked "$id"
        ;;
      *) die "standalone handoffs support --status open|done (there is no lease to block on)" ;;
    esac
    finish_release "$id" "$status"
    return
  fi

  if [ "$status" = "blocked" ]; then
    [ -n "$blocked_on" ] || die "release --status blocked needs --blocked-on <handoff-id|\"external: ...\"> — what is it waiting on?"
    # A handoff id blocker is canonicalized to its filename stem; "external: ..." is accepted
    # unvalidated (that prefix exists precisely for blockers outside the board, which cannot be
    # validated here) but is still colon-folded on the way in, since it lands in frontmatter as
    # unquoted YAML: "external: vendor ticket" is stored as "external — vendor ticket". The typed
    # spelling stays "external: ..." — that is what every doc and the usage string say — and the
    # em-dash spelling is accepted too, so either form round-trips. No reader depends on the colon:
    # the hooks take only the first word (${bo%% *} — "external", never an archived id),
    # surface_unblocked substring-matches the closed id, and list/INDEX only display the value.
    # A blocker names another doc on this board, so resolve it the same way as a claim target —
    # otherwise a legacy-named blocker would be recorded under a slug that matches no file.
    #
    # Then VALIDATE it. `blocked` is only meaningful if something can later close and release this
    # doc; an unvalidated blocker deadlocks silently — the doc sits blocked forever and is never
    # surfaced as unblocked, which is worse than refusing the release outright.
    case "$blocked_on" in
      external:* | 'external —'* | 'external -'*) blocked_on="$(fold_colons "$blocked_on")" ;;
      *)
        blocked_on="$(resolve_id "$blocked_on")" || die "unusable --blocked-on id: '$blocked_on'"
        [ "$blocked_on" = "$id" ] && die "$id cannot be blocked on itself — name the other handoff, or use --blocked-on \"external: ...\""
        # Section-aware: the blocker lives wherever THIS section's docs live. Building the path at
        # the board root instead (which this check used to do, from before boards had sections)
        # looks in a directory that holds no docs on a subfolder-layout board, so every blocker id
        # is rejected and `blocked` becomes unreachable on any grouped board.
        [ -f "$(doc_file "$blocked_on")" ] || [ -f "$(arch_file "$blocked_on")" ] \
          || die "no such handoff to block on: $blocked_on (file it first, or use --blocked-on \"external: ...\"). Nothing would ever close it."
        ;;
    esac
    set_field "$f" blocked_on "$blocked_on"
  fi

  if [ "$status" = "done" ]; then
    # Is the evidence just the executor's own words handed back? Asked ONCE here, and answered
    # against the spliced RESULT BLOCK — the executor's report — rather than the whole doc: a
    # reviewer who honestly re-ran the doc's own `## Verify` command and described it in the same
    # words is not copying anything, and that text lives outside the result block.
    #
    # This used to compare `--verified-by` against `result_claimed`, which holds the executor's
    # STATUS word (done/partial/blocked), not their evidence — so the check could only fire if
    # somebody typed `--verified-by "done"`. It was inert, and it read as though it were not.
    #
    # The haystack is the EXECUTOR's own account of the work. For delegated work that is the spliced
    # Result block. For work done on the board and handed back with `release --for-review` there is
    # no result block at all, so this check would have been inert in exactly the case ADR 0015
    # widened the gate to cover — `## Current state` is where that executor wrote the same account,
    # so it is the fallback rather than a second, differently-shaped check.
    local copied=0 evidence_src
    evidence_src="$(result_block "$f")"
    [ -n "$evidence_src" ] || evidence_src="$(doc_section "$f" "Current state")"
    if [ -n "$verified_by" ] && [ "$(meta "$f" review)" = "pending" ] \
      && [ -n "$evidence_src" ] && grep -Fq -- "$verified_by" <<< "$evidence_src"; then
      copied=1
    fi
    # A refusal rather than a warning when a SECOND PARTY reported — the executor is outside the
    # board and never runs `release`, so what is refused is not a person but the executor's own words
    # being used as the review. Closing on them stamps a verification date asserting somebody
    # checked, when nobody did.
    #
    # Keyed on `result_from` (somebody outside filed a report), NOT on `executed_by`. Since ADR 0015
    # that field answers a different question — whether a human was in the loop — and both of its
    # values can describe off-board work, so it can no longer stand in for "a second party's words
    # are in this doc". The legacy `delegate` value still counts, for docs written before the re-cut.
    local reported_by_other=0
    { [ -n "$(meta "$f" result_from)" ] || [ "$(meta "$f" executed_by)" = "delegate" ]; } && reported_by_other=1
    if [ "$copied" = 1 ] && [ "$reported_by_other" = 1 ]; then
      die "$id was executed by someone else and your --verified-by is word-for-word what they reported.
       That is the executor reviewing itself. Re-run the check and say what YOU observed, or
       release --status open and hand it to a reviewer."
    fi
    if [ "$reported_by_other" = 1 ] && [ "$(meta "$f" review)" = "pending" ]; then
      echo "NOTE: this handoff was executed by someone else and is awaiting review."
      echo "      Closing it records YOU as the reviewer — --verified-by must be what you checked yourself."
    fi
    # Evidence quality is advisory and is said HERE, at the moment of closing, because that is the
    # only moment anyone can still act on it: `done` archives the doc, so a later scan is talking to
    # nobody. Generous on purpose — no pattern can judge whether evidence is good, only whether it
    # names something a second person could go and look at.
    #
    # WHAT counts as something to go and look at depends on the executor kind (ADR 0015). An
    # infrastructure team acting on live systems answers with a change reference and an observation:
    # there is no diff to read and `Where` names a cluster, not a `file:line`. Demanding a command or
    # a commit there is asking for evidence that cannot exist, and a rule people cannot satisfy
    # honestly gets satisfied dishonestly. No pattern is ENFORCED either way (Decision 4) — the two
    # arms differ only in what they suggest.
    if [ "$(meta "$f" executed_by)" = "hitl" ]; then
      echo "NOTE: a person was in the loop on this one (executed_by: hitl)."
      echo "      Good evidence here is the change reference, what was observed, and when —"
      echo "      not a command, since there may be no diff to re-run."
    else
      case "$verified_by" in
        '' | *:[0-9]* | */*[a-z]* | *' -'[a-z-]* | *' --'[a-z-]* | *test* | *spec* | *commit* | *sha* | *exit* | *'()'*) ;;
        *)
          echo "⚠️  Your evidence names no command, file reference, or commit — nobody can re-check it."
          echo "    Nobody was watching this work (executed_by: $(meta "$f" executed_by)), so the evidence has to be"
          echo "    reproducible by someone who was not there. Closing anyway. Next time: what you ran,"
          echo "    or the file:line you read."
          ;;
      esac
    fi
    # done is a claim about the LIVE CODE, not about the doc. Require evidence.
    [ -n "$verified_by" ] || die "release --status done needs --verified-by \"<how you verified against live code>\" (e.g. a test run or file:line). Trust-closing is disabled."
    local vcmd
    vcmd="$(meta "$f" verify)"
    if [ -n "$vcmd" ]; then
      # SAFE BY DEFAULT: never auto-run a command from a doc (a cross-repo doc is
      # untrusted). Run only with BOTH an explicit flag AND the install-time opt-in,
      # and only for a doc whose origin is THIS repo.
      if [ "$run_verify" = 1 ] && [ "${HANDOFF_ALLOW_VERIFY_CMD:-0}" = 1 ] && doc_is_local "$f"; then
        echo "Running verify: $vcmd"
        if ! (cd "$(git rev-parse --show-toplevel 2> /dev/null || echo "$DIR")" && eval "$vcmd"); then
          die "verify command failed — not closing $id. Fix the code or the command."
        fi
        verified_by="$verified_by [verify: exit 0]"
      else
        echo "NOTE: this handoff carries a verify: command but it was NOT run"
        echo "      ($vcmd)"
        echo "      Run it yourself, or re-release with --run-verify (needs install opt-in HANDOFF_ALLOW_VERIFY_CMD=1 and a local doc)."
      fi
    fi
  fi

  # The non-delegated arm of the same question (`copied`, computed above). A warning rather than a
  # refusal here: without a delegate there is no second party whose words these are, so the
  # reviewer may legitimately have re-run the very same command and written it the same way.
  if [ "$status" = "done" ] && [ "${copied:-0}" = 1 ]; then
    echo "⚠️  Your --verified-by is identical to the reported evidence already in the doc."
    echo "    'done' means YOU verified against live code. If you re-ran it yourself, say so."
  fi

  # Last, after every check that can still refuse this release, so a refused release leaves the
  # section exactly as it was. Before `done` archives the doc, so the line travels with it.
  [ -n "$ruled_out" ] && append_ruled_out "$f" "$ruled_out"

  set_field "$f" status "$status"
  set_field "$f" updated "$(today)"
  if [ "$status" = "done" ]; then
    set_field "$f" verified_at "$(today)"
    # Persisted as a FIELD. It used to exist only as prose inside the activity log, which is why
    # across two live boards 144 documents carried a verification DATE and 2 carried retrievable
    # evidence: the date was a field and could be queried, the evidence was a sentence and could
    # not. A closure nobody can query is a closure nobody can audit.
    # QUOTED, not colon-folded — the second field in this file to need that treatment, and for a
    # sharper reason than `verify:`. Good evidence names a `file:line` or a `cmd --flag`, and
    # folding the colon turns `handoff:1855` into `handoff — 1855`: still readable, no longer a
    # location anything can resolve. The check that asks for a file reference would have been
    # mangling the very thing it asks for. Readers strip one surrounding quote pair (see meta()),
    # so the value round-trips; embedded double quotes become single ones because the frontmatter
    # is unquoted YAML and a nested `"` would end the value early.
    set_field "$f" verified_by "\"$(printf '%s' "$verified_by" | tr '"' "'")\""
    log_activity "$f" "done — verified against live code by $me: ${verified_by}.${note}"
    if archive_doc "$f" "$id"; then
      echo "✅ $id → done, moved to archive/. verified-by: $verified_by"
    else
      warn_archive_failed "$id"
      echo "    verified-by: $verified_by"
    fi
    echo "🔒 This doc is committed to git history — confirm no secrets/keys/passwords/PII remain."
    surface_unblocked "$id"
  elif [ "$for_review" = 1 ]; then
    # The SECOND writer of `review: pending` (ADR 0015). `import --result` is the first, for work
    # done off the board; this is the same hold for a collaborator who is on it. Setting the existing
    # field is the whole feature: every reader already keyed on it — the `⇤ review` marker in `list`,
    # the session banner, the copied-evidence check above — starts covering on-board work the moment
    # it is set, and nothing needed a new status or a new field to say so.
    #
    # `audience` is deliberately left alone. It names a REPO, not a person, so on a single-repo board
    # there is nobody to flip it to and on a cross-repo board the reviewer is usually in the repo
    # that already owns the doc. `import --result` refuses to change it for the same reason, and the
    # two writers of this field must not disagree about what else they touch.
    set_field "$f" review pending
    # Optional, and only when stated. A hand-back with no handle is the ordinary case — "somebody
    # should look at this" — and stamping a guess would appoint someone who never agreed.
    [ -n "$reviewer" ] && set_field "$f" reviewer "$reviewer"
    log_activity "$f" "$status — handed back for review by $me${reviewer:+, to $reviewer}, who did the work.${note}"
    if [ -n "$reviewer" ]; then
      echo "Released $id → $status, awaiting review by $reviewer."
    else
      echo "Released $id → $status, awaiting review."
    fi
    echo "    It stays on the board until a reviewer closes it with --verified-by."
  else
    log_activity "$f" "$status — released by $me.${note}"
    echo "Released $id → $status."
  fi
  finish_release "$id" "$status"
}

# The effective `repos:` list — the inline flow list AND any block-list items on the lines after
# it, normalized to space-separated names. meta() only ever sees the key's own line, so a doc
# written in block style
#
#   repos:
#     - other-repo
#
# reads as EMPTY there, i.e. "unset", i.e. local — the gate below failing OPEN for exactly the
# foreign doc it exists to distrust. Returns nothing when the key is absent or its list is empty.
repos_of() { # path -> space-separated repo names
  awk '
    NR == 1 && $0 == "---" { infm = 1; next }
    infm && $0 == "---" { exit }
    infm && /^repos:/ {
      v = $0; sub(/^repos:[[:space:]]*/, "", v)
      gsub(/[][,]/, " ", v)
      printf "%s ", v
      inlist = 1; next
    }
    infm && inlist && /^[[:space:]]+-[[:space:]]*/ {
      v = $0; sub(/^[[:space:]]+-[[:space:]]*/, "", v)
      printf "%s ", v; next
    }
    infm && /^[^[:space:]]/ { inlist = 0 }
  ' "$1"
}

doc_is_local() { # a doc "belongs to" this repo when repos: is unset/empty or NAMES REPO_NAME
  local f="$1" repos
  # `repos: []` is what the doc template writes, and an empty list means "unset" — not "some
  # other repo's list". Testing the raw string treated the two characters "[]" as a foreign
  # list, which made --run-verify unreachable for every doc `new` creates.
  repos="$(repos_of "$f" | tr -s '[:space:]' ' ' | sed -e 's/^ //' -e 's/ $//')"
  [ -z "$repos" ] && return 0
  [ -z "$REPO_NAME" ] && return 0
  # Whole-name match, not substring: with REPO_NAME=api, a doc scoped to `[api-gateway]` is NOT
  # this repo's, and must not unlock auto-execution here.
  case " $repos " in *" $REPO_NAME "*) return 0 ;; *) return 1 ;; esac
}

surface_unblocked() { # closed_id -> print any open docs (in this section) blocked_on it
  local closed="$1" closed_lc found=0 g gb
  # Match case-insensitively. resolve_id returns whichever spelling the filesystem answered to:
  # the canonical lowercase slug where a case-insensitive filesystem let it match an uppercase
  # file, the file's own spelling where the legacy fallback found it. So a doc blocked on
  # ESBINT-285-handoff can carry either spelling depending on where it was written, and an exact
  # compare silently strands it — never resurfaced, which is the one thing `blocked` exists to do.
  closed_lc="$(printf '%s' "$closed" | tr '[:upper:]' '[:lower:]')"
  while IFS= read -r g; do
    [ -n "$g" ] || continue
    gb="$(basename "$g" .md)"
    case "$gb" in INDEX | README | handoff-doc-template | handoff-standalone-template | handoff-orchestrator-template) continue ;; esac
    [ "$(meta "$g" status)" = "blocked" ] || continue
    case "$(meta "$g" blocked_on | tr '[:upper:]' '[:lower:]')" in *"$closed_lc"*)
      [ "$found" = 0 ] && echo "Now unblocked (their blocker $closed is done):"
      found=1
      echo "  - $gb — $(meta "$g" title)"
      ;;
    esac
  done < <(each_doc)
  return 0
}

# --- migrate (ADR 0003) ----------------------------------------------------------------
# A whole-board rewrite pushed to a shared remote is an irreversible, outward-facing action that
# races everyone's in-flight work. So it is GATED, never silent, and never automatic.
#
# The gates, in the order they are checked:
#   1. the board is under version control       — without history there is no undo
#   2. no live lease in this section            — migrating under someone's feet rewrites the doc
#                                                 they are holding
#   3. a clean worktree, then fetch + fast-forward — so the rewrite starts from what everyone else
#                                                 can see, not from a stale local copy
#   4. one commit, pushed as a compare-and-swap — a rejected push aborts and leaves the board
#                                                 exactly as it was
#
# And the rule that shapes every step below: migration moves STRUCTURE. It adds, renames and moves
# keys. It never infers a value. A script that stamps a default sensitivity onto a document about a
# credential exposure writes an actively false claim, and no script can decide which entry of a
# forty-entry activity log is the current state. Judgment stays lazy-on-touch, and `verify` lists
# what is still missing.

# Who is holding a live lease in THIS section, as "id (owner), id (owner)" — empty when nobody is.
# Migration rewrites every document on the board, so a held lease is the one condition that makes it
# unrunnable right now; both the gate below and the write-path offer read it from here so they can
# never disagree about who counts.
held_leases_in_section() {
  local f held="" kind owner exp key
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    key="$(basename "$f" .md)"
    IFS='|' read -r kind owner exp <<< "$(lock_state "$key")"
    [ "$kind" = "held" ] && held="${held:+$held, }$key ($owner)"
  done < <(each_doc)
  printf '%s' "$held"
}

# Is this an interactive human, or a hook? A hook must never prompt (nothing is listening) and must
# never block (it would take the session down over a board upgrade). $HANDOFF_NONINTERACTIVE is the
# explicit override for CI.
migrate_can_prompt() {
  [ -z "${HANDOFF_NONINTERACTIVE:-}" ] || return 1
  [ -t 0 ] && [ -t 1 ]
}

# One document, schema 0 -> 1. Everything here is a key or a heading that the CURRENT template
# already writes; nothing gains a value that was not already true of it. `environment: dev` is the
# explicit spelling of what an absent environment has always meant, not a new claim.
migrate_doc_0_to_1() { # path -> 0 when it changed the file
  local f="$1" changed=0 t
  if [ -z "$(meta "$f" environment)" ] && ! is_standalone "$f"; then
    set_field "$f" environment dev
    changed=1
  fi
  if [ -z "$(meta "$f" depends_on)" ] && ! is_standalone "$f"; then
    set_field "$f" depends_on "[]"
    changed=1
  fi
  if is_standalone "$f" && [ -z "$(meta "$f" role)" ]; then
    # Absent has always READ as `reference`; writing it down asserts nothing new.
    set_field "$f" role reference
    changed=1
  fi
  # `## Current state` goes ABOVE `## Context`, empty. Left empty on purpose: seeding it from the
  # activity log would be exactly the inference this migration refuses to make.
  if ! is_standalone "$f" && ! grep -q '^## Current state' "$f"; then
    t="$(mktemp)" || return 1
    if grep -q '^## Context' "$f"; then
      awk '!done && /^## Context/ { print "## Current state"; print ""; print "<!-- REWRITABLE. Where this stands right now — overwrite it, do not append. -->"; print ""; done = 1 } { print }' "$f" > "$t"
    else
      # No Context heading to anchor to (an orchestrator, or a hand-written doc): append instead of
      # guessing at a position.
      cat "$f" > "$t"
      printf '\n## Current state\n\n<!-- REWRITABLE. Where this stands right now — overwrite it, do not append. -->\n' >> "$t"
    fi
    cat "$t" > "$f"
    rm -f "$t"
    changed=1
  fi
  set_field "$f" schema 1
  log_activity "$f" "migrated to schema 1 (structure only — no values were inferred)"
  return $((1 - changed))
}

# One document, schema 1 -> 2 (ADR 0011). Schema 2 adds `external_ref`, which is OPTIONAL: absent
# means "no ticket", so there is nothing to write into a doc but the stamp. The bump exists so a
# schema-1 CLI refuses to write a doc that may carry the field, instead of dropping it (ADR 0003).
migrate_doc_1_to_2() { # path
  set_field "$1" schema 2
  log_activity "$1" "migrated to schema 2 (structure only — external_ref is optional and never inferred)"
}

# One document, schema 2 -> 3. Schema 3 adds `reviewer`, an OPTIONAL pointer to the tracker handle
# that reviews this work. Absent means "nobody named", which is what every doc written before this
# change meant and still means, so there is nothing to write into a doc but the stamp — and nothing
# to infer. Inferring one WOULD be possible here (the last holder, the closer, the delegate) and is
# exactly what ADR 0003 forbids: a reviewer nobody appointed is a false claim about who is
# accountable, and it would be projected outward as a tracker assignment.
migrate_doc_2_to_3() { # path
  set_field "$1" schema 3
  log_activity "$1" "migrated to schema 3 (structure only — reviewer is optional and never inferred)"
}

# ADR 0017 — backfill `home`. A coordination doc takes its audience. An orchestrator takes the home
# its children share, read from each child's home or, not yet migrated, its audience — so the order
# docs are visited in cannot change the answer. Children that disagree, or no signal at all, leave
# it unset and say so: a guessed home would publish the doc into a repository nobody chose.
migrate_doc_3_to_4() { # path -> 0 when home was set or is not needed, 1 when it could not be resolved
  local f="$1" home="" c cf h mixed=0
  if ! is_standalone "$f" && [ -z "$(meta "$f" home)" ]; then
    if is_orchestrator "$f"; then
      while IFS= read -r c; do
        [ -n "$c" ] || continue
        cf="$(doc_of "$c" 2> /dev/null)" || continue
        h="$(meta "$cf" home)"
        [ -n "$h" ] || h="$(meta "$cf" audience)"
        [ -n "$h" ] || continue
        if [ -z "$home" ]; then home="$h"; elif [ "$home" != "$h" ]; then mixed=1; fi
      done <<< "$(children_of "$f")"
      [ "$mixed" = 0 ] || home=""
    else
      home="$(meta "$f" audience)"
    fi
    [ -n "$home" ] && set_field "$f" home "$home"
  fi
  set_field "$f" schema 4
  if ! is_standalone "$f" && [ -z "$(meta "$f" home)" ]; then
    log_activity "$f" "migrated to schema 4 — no home could be resolved; set one to mirror this handoff"
    return 1
  fi
  log_activity "$f" "migrated to schema 4${home:+ (home: $home)}"
  return 0
}

cmd_migrate() {
  local yes=0 dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes | -y)
        yes=1
        shift
        ;;
      --dry-run)
        dry=1
        shift
        ;;
      *) die "unknown arg: $1 (usage: handoff migrate [--yes] [--dry-run])" ;;
    esac
  done

  local from to
  from="$(board_schema)"
  to="$SCHEMA_VERSION"
  if [ "$from" -gt "$to" ]; then
    die "this board is schema $from and this CLI understands $to — it is NEWER than the tool.
       Update the payload first (re-run setup-handoff); migrating backward is not a thing."
  fi

  # Collect what would actually change BEFORE any gate complains, so a no-op board is told it is a
  # no-op rather than being sent to clean its worktree for nothing.
  local pending=0 f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ "$(doc_schema "$f")" -lt "$to" ] && pending=$((pending + 1))
  done < <(each_doc)

  # The archive is OUT OF SCOPE, and says so rather than being silently absent from the number.
  # An archived doc is closed: rewriting its frontmatter appends a post-closure activity entry and
  # an empty `## Current state` to a document nobody will open again, which is history churn for
  # no reader. `verify` counts these on their own line (board.schema.archive) for the same reason,
  # so the two halves agree — the earlier state, where the count included the archive and this
  # command did not, was advice that could not act on most of what it named. Tallied before the
  # no-op return so a board whose ONLY stale docs are archived is told why it has nothing to do.
  local archived_old=0 archive_note=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ "$(doc_schema "$f")" -lt "$to" ] && archived_old=$((archived_old + 1))
  done < <(each_archive)
  [ "$archived_old" -gt 0 ] \
    && archive_note="  ($archived_old archived doc(s) predate schema $to and are left alone — closed docs keep the shape they were closed in.)"

  if [ "$from" = "$to" ] && [ "$pending" = 0 ]; then
    echo "Board is already schema $to — nothing to migrate."
    [ -n "$archive_note" ] && echo "$archive_note"
    return 0
  fi
  echo "Board schema $from → $to · $pending document(s) to rewrite${GROUP:+ in section $GROUP}."
  [ -n "$archive_note" ] && echo "$archive_note"

  if [ "$dry" = 1 ]; then
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      [ "$(doc_schema "$f")" -lt "$to" ] && echo "  would migrate $(basename "$f" .md) (schema $(doc_schema "$f"))"
    done < <(each_doc)
    echo "(dry run — nothing was written)"
    return 0
  fi

  # GATE 1 — version control. Without it there is no undo for a whole-board rewrite, and one of the
  # boards this decision came from held 193 irreplaceable documents with no history at all.
  board_git rev-parse --show-toplevel > /dev/null 2>&1 \
    || die "this board is not under version control, so a whole-board rewrite has no undo.
       git init it first (or re-run setup-handoff --board-only on it), then migrate."

  # GATE 2 — no live lease in THIS section. Migrating a doc somebody is holding rewrites the file
  # under them. A lease in another section is somebody else's business and does not block this.
  local held
  held="$(held_leases_in_section)"
  [ -n "$held" ] && die "live lease(s) in this section — migrating would rewrite documents somebody is holding: $held
       Wait for them to release, or take over an expired lease first."

  # GATE 3 — start from what everyone else can see. A rewrite computed against a stale local copy
  # produces a diff nobody else can fast-forward.
  if leases_shared; then
    board_git diff --quiet && board_git diff --cached --quiet \
      || die "the board has uncommitted changes. A migration is one commit touching every document;
       mixing it with unrelated edits makes it impossible to revert cleanly. Commit or stash first."
    board_sync_or_die
  fi

  # NEVER SILENT. An interactive caller is asked; a hook is told and does nothing; --yes is the
  # explicit consent CI and local boards use.
  if [ "$yes" != 1 ]; then
    if migrate_can_prompt; then
      printf 'Rewrite %s document(s) and push? [y/N] ' "$pending"
      local reply=""
      read -r reply < /dev/tty || reply=""
      case "$reply" in y | Y | yes | YES) ;; *) die "migration declined — nothing was written." ;; esac
    else
      echo "Not migrating: this is a non-interactive invocation and --yes was not passed."
      echo "Run './handoff migrate --yes' yourself, from a session where you can see the result."
      return 0
    fi
  fi

  local migrated=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ "$(doc_schema "$f")" -lt "$to" ] || continue
    # Steps run in order, each from the schema the previous one left, so a schema-0 doc takes the
    # same path to the current schema as a doc that was migrated one release at a time.
    if [ "$(doc_schema "$f")" -lt 1 ]; then
      if migrate_doc_0_to_1 "$f"; then
        echo "  migrated $(basename "$f" .md) (0 → 1)"
      else
        # Already structurally current; it only lacked the stamp. Still logged, so the activity
        # trail matches the commit.
        echo "  stamped $(basename "$f" .md) (already structurally current)"
      fi
    fi
    if [ "$(doc_schema "$f")" -lt 2 ]; then
      migrate_doc_1_to_2 "$f"
      echo "  migrated $(basename "$f" .md) (1 → 2)"
    fi
    if [ "$(doc_schema "$f")" -lt 3 ]; then
      migrate_doc_2_to_3 "$f"
      echo "  migrated $(basename "$f" .md) (2 → 3)"
    fi
    if [ "$(doc_schema "$f")" -lt 4 ]; then
      if migrate_doc_3_to_4 "$f"; then
        echo "  migrated $(basename "$f" .md) (3 → 4)"
      else
        echo "  migrated $(basename "$f" .md) (3 → 4) — no home could be resolved; it stays unmirrored until one is set"
      fi
    fi
    migrated=$((migrated + 1))
  done < <(each_doc)

  board_write_schema "$to"
  cmd_index

  # GATE 4 — one commit, pushed as a compare-and-swap. A rejected push means somebody else moved
  # the board while this ran; the migration is undone rather than left half-applied.
  if leases_shared; then
    board_git add --all -- "$DIR"
    if ! board_git commit --quiet -m "handoff: migrate board schema $from → $to ($migrated docs)"; then
      die "could not commit the migration (is git identity configured?). Nothing was pushed."
    fi
    if ! board_git push --quiet "$(board_remote)" HEAD; then
      # Undo the migration commit and restore the working tree to the shared state. This is the one
      # place a hard reset is correct: the commit being discarded is the one just created here, its
      # entire content is reproducible by re-running, and gate 3 already refused to start from a
      # dirty tree — so there is nothing of anybody's to lose.
      board_git reset --hard --quiet HEAD~1 \
        || echo "⚠️  could not roll back automatically — inspect $DIR before retrying." >&2
      die "the push was rejected: somebody else moved the board while this migration ran.
       The migration was rolled back rather than left half-applied. Re-run './handoff migrate --yes'."
    fi
    echo "✅ Migrated $migrated document(s) to schema $to and pushed."
  else
    board_git add --all -- "$DIR" 2> /dev/null
    board_git commit --quiet -m "handoff: migrate board schema $from → $to ($migrated docs)" 2> /dev/null \
      && echo "✅ Migrated $migrated document(s) to schema $to (committed locally)." \
      || echo "✅ Migrated $migrated document(s) to schema $to. Commit $DIR when you are ready."
  fi
}

# The board's own stamp. Written through the same merge the installer uses so a hand-set ttlHours
# beside it survives.
board_write_schema() { # n
  command -v python3 > /dev/null 2>&1 || return 0
  python3 - "$DIR/handoff.json" "$1" << 'PY'
import json, os, sys
path, n = sys.argv[1], int(sys.argv[2])
try:
    with open(path) as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        data = {}
except (OSError, ValueError):
    data = {}
data["schema"] = n
tmp = path + ".tmp"
with open(tmp, "w") as fh:
    json.dump(data, fh, indent=2, sort_keys=True)
    fh.write("\n")
os.replace(tmp, path)
PY
}

cmd_reap() { # show (and with --force, clear) expired leases
  local force="${1:-}"
  local found=0
  for d in "$LOCKS"/*/; do
    [ -d "$d" ] || continue
    local id
    id="$(basename "$d")"
    local kind owner exp
    IFS='|' read -r kind owner exp <<< "$(lock_state "$id")"
    [ "$kind" = "expired" ] || continue
    found=1
    echo "⚠️  $id — held by $owner, expired $(human "$exp")"
    if [ "$force" = "--force" ]; then
      clear_lock "$id"
      echo "   cleared."
    fi
  done
  [ "$found" = 0 ] && echo "No expired leases."
  # A reap on a shared board deletes TRACKED files. Left uncommitted, those deletions are exactly
  # the local modification that makes the next claim's fast-forward refuse — so the board's own
  # self-healing would take the claim path down. Optimistic like a release: this records a lease
  # that had already lapsed, so a failed push is a warning, not a reason to keep the lease.
  [ "$force" = "--force" ] && release_commit_push "handoff: reap expired leases"
  return 0
}

# Write ONE section's sub-index. Operates on the caller's current GROUP/LOCKS; on a flat board this is
# $DIR/INDEX.md and the output is byte-identical to before groups existed. Doc links stay `./$base.md`
# because a sub-index always sits in the same directory as its docs (the group subdir for subfolder,
# $DIR for prefix/flat), and archive links `./archive/$base.md` for the same reason.
# A `spec:` value resolved for display. Order is path, then URL, then board id — the same order
# the field is documented in, and the reason it is an order rather than three fields is that all
# three are the same question ("what says what this should do") answered by whatever the team keeps
# it in. Unresolvable renders as plain text: a dead link is worse than no link.
spec_link() { # doc-path -> " · [spec](target)" or ""
  local f="$1" sp
  sp="$(meta "$f" spec)"
  [ -n "$sp" ] || return 0
  case "$sp" in
    http://* | https://*) printf ' · [spec](%s)' "$sp" ;;
    *)
      if [ -e "$DIR/$sp" ] || [ -e "$sp" ]; then
        printf ' · [spec](%s)' "$sp"
      elif [ -f "$(doc_file "$(norm_id "$sp" 2> /dev/null)")" ]; then
        printf ' · [spec](./%s.md)' "$(norm_id "$sp")"
      else
        printf ' · spec %s' "$sp"
      fi
      ;;
  esac
}

# ADVISORY backlinks. Documents name each other in prose constantly — one on a live board named 22
# siblings in body text while declaring no structured relationship at all — so the graph the humans
# see is invisible to the tool. This surfaces those references without promoting them: a mention is
# not a dependency, and manufacturing edges nobody asserted would be worse than showing none. Marked
# generated, and never written into the docs themselves.
backlink_block() {
  local f base target tbase hits
  local -a docs=()
  while IFS= read -r f; do [ -n "$f" ] && docs+=("$f"); done < <(each_doc)
  [ "${#docs[@]}" -gt 1 ] || return 0
  local any=0 body=""
  for target in "${docs[@]}"; do
    tbase="$(basename "$target" .md)"
    hits=""
    for f in "${docs[@]}"; do
      [ "$f" = "$target" ] && continue
      # Body only: the frontmatter's own depends_on/blocked_on are real edges and are already
      # rendered as such. Counting them here would report every declared edge twice, once as
      # structure and once as gossip.
      # Process substitution, NOT a pipe. `grep -q` exits on its first match; with a pipe, sed is
      # still writing any doc larger than the 64KB pipe buffer and dies of SIGPIPE (141), which
      # `set -uo pipefail` (top of file) then reports as the PIPELINE's status — so `|| continue`
      # discarded references grep had actually found. It silently dropped every backlink out of the
      # board's three largest docs and made INDEX.md's table differ on every regeneration.
      grep -qF "$tbase" < <(sed -n '/^---$/,/^---$/!p' "$f") 2> /dev/null || continue
      base="$(basename "$f" .md)"
      hits="$hits [$base](./$base.md)"
    done
    [ -n "$hits" ] || continue
    any=1
    body="$body| [$tbase](./$tbase.md) |$hits |
"
  done
  [ "$any" = 1 ] || return 0
  echo "## Referenced by (advisory)"
  echo
  echo "Generated from ids named in document BODIES. These are mentions, not declared edges — a"
  echo "reference is not a dependency. If one of them is, put it in that doc's \`depends_on\`."
  echo
  echo "| Handoff | Mentioned in |"
  echo "| --- | --- |"
  printf '%s' "$body"
  echo
}

write_section_index() {
  # `f` is local because it is a LOOP variable here and a doc path in every caller. Without this
  # declaration, cmd_index quietly overwrites its caller's `$f` with whichever doc happened to be
  # iterated last — which is exactly what made the claim path commit its lease without the doc.
  local out f
  out="$(sec_index)"
  mkdir -p "$(dirname "$out")"
  {
    echo "<!-- GENERATED by ./handoff index — do not edit by hand. -->"
    if grouped; then
      echo "# Handoff Index — $GROUP"
      echo
      echo "Section \`$GROUP\` of the shared board${REPO_NAME:+ (viewed as $REPO_NAME)}. Generated $(date '+%Y-%m-%d %H:%M')."
    else
      echo "# Handoff Index"
      echo
      if [ "$TOPOLOGY" = "cross-repo" ]; then
        echo "Shared coordination board${REPO_NAME:+ (viewed as $REPO_NAME)}. Generated $(date '+%Y-%m-%d %H:%M')."
      else
        echo "Coordination board for ${REPO_NAME:-this repo}. Generated $(date '+%Y-%m-%d %H:%M')."
      fi
    fi
    echo "Claim before you work: \`./handoff claim <id>\`. Protocol: [README.md](./README.md)."
    echo
    echo "## Open"
    echo
    echo "| Handoff | Status | Acts next | Env | Severity | Updated | Blocked on | Lease |"
    echo "| --- | --- | --- | --- | --- | --- | --- | --- |"
    # Ordered by the board's environment ladder, lowest stage first, then by filename. Sorting by
    # how close work is to production is meaningful; sorting `dev, prod, staging` alphabetically is
    # noise. env_rank puts anything the board does not name after the ladder rather than dropping it.
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      local base
      base="$(basename "$f" .md)"
      case "$base" in INDEX | README | handoff-doc-template | handoff-standalone-template | handoff-orchestrator-template) continue ;; esac
      # Neither standalone docs nor orchestrators are claimable work — an orchestrator listed here
      # reads as an unclaimed open task, which is the opposite of what the type means.
      is_standalone "$f" && continue
      is_orchestrator "$f" && continue
      local kind owner exp
      IFS='|' read -r kind owner exp <<< "$(lock_state "$base")"
      local lease="—"
      [ "$kind" = "held" ] && lease="🔒 $owner"
      [ "$kind" = "expired" ] && lease="⚠️ stale ($owner)"
      local bo
      bo="$(meta "$f" blocked_on)"
      [ -n "$bo" ] && is_archived "${bo%% *}" && bo="$bo ✅ resolved"
      local env_c spec_c
      env_c="$(doc_env "$f")"
      # `spec:` is resolved by the READER, in order: a path (relative to the board), then a URL,
      # then a board id. Nothing is validated at write time — a handoff is routinely filed before
      # its spec is written — so an unresolvable value renders as plain text rather than a dead link.
      spec_c="$(spec_link "$f")"
      echo "| [$(meta "$f" title)](./$base.md)${spec_c} | \`$(meta "$f" status)\` | $(meta "$f" audience) | $env_c | $(meta "$f" severity) | $(meta "$f" updated) | ${bo:-—} | $lease |"
    done < <(each_doc | while IFS= read -r one; do [ -n "$one" ] && printf '%s\t%s\n' "$(env_rank "$(doc_env "$one")")" "$one"; done | sort -k1,1n -k2,2 | cut -f2-)
    echo
    # Orchestrators: bundle indexes. Progress is derived from the children on every regeneration,
    # exactly as `handoff list` does it, so the index cannot drift from the children's real state.
    local has_orch=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      local base
      base="$(basename "$f" .md)"
      case "$base" in INDEX | README | handoff-doc-template | handoff-standalone-template | handoff-orchestrator-template) continue ;; esac
      is_orchestrator "$f" || continue
      if [ "$has_orch" = 0 ]; then
        has_orch=1
        echo "## Orchestrators (bundles — no claim needed)"
        echo
        echo "| Bundle | Progress | Outstanding |"
        echo "| --- | --- | --- |"
      fi
      local prog pdone ptotal pout
      prog="$(child_progress "$f")"
      pdone="${prog%%|*}"
      ptotal="$(printf '%s' "$prog" | cut -d'|' -f2)"
      pout="${prog#*|*|}"
      echo "| [$(meta "$f" title)](./$base.md) | $pdone/$ptotal done | ${pout:-— all children done} |"
    done < <(each_doc)
    [ "$has_orch" = 1 ] && echo
    # Standalone / reference docs: self-contained, gate-exempt, no lease. Listed apart so they
    # are not mistaken for claimable work.
    local has_standalone=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      local base
      base="$(basename "$f" .md)"
      case "$base" in INDEX | README | handoff-doc-template | handoff-standalone-template | handoff-orchestrator-template) continue ;; esac
      is_standalone "$f" || continue
      if [ "$has_standalone" = 0 ]; then
        has_standalone=1
        echo "## Standalone / reference (no claim needed)"
        echo
        echo "| Handoff | Status | Updated |"
        echo "| --- | --- | --- |"
      fi
      echo "| [$(meta "$f" title)](./$base.md) | \`$(meta "$f" status)\` | $(meta "$f" updated) |"
    done < <(each_doc)
    [ "$has_standalone" = 1 ] && echo
    # Advisory, and placed after the claimable tables on purpose: it is context, not work.
    backlink_block
    echo "## Archive (done / superseded)"
    echo
    echo "| Handoff | Status | Verified |"
    echo "| --- | --- | --- |"
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      local base
      base="$(basename "$f" .md)"
      echo "| [$(meta "$f" title)](./archive/$base.md) | \`$(meta "$f" status)\` | $(meta "$f" verified_at) |"
    done < <(each_archive)
  } > "$out"
}

# The groups the roll-up covers: the board's declared GROUPS plus the caller's own, order-preserving,
# de-duplicated. Defensive union in case a repo's section is not yet listed in the shared config.
groups_for_rollup() {
  {
    each_group
    [ -n "$GROUP" ] && printf '%s\n' "$GROUP"
  } | awk 'NF && !seen[$0]++'
}

# Board-relative "./path" link from the roll-up (which lives at $DIR/INDEX.md) to any board file.
rel_link() { printf './%s' "${1#"$DIR"/}"; }

# Regenerate the board-root roll-up: one section per hosted group, each linking to its sub-index and
# listing its open items. Read-only across sections (each group's docs are maintained by its own repo).
rollup_index() {
  local out="$DIR/INDEX.md" g
  {
    echo "<!-- GENERATED by ./handoff index — do not edit by hand. -->"
    echo "# Handoff Index — all groups"
    echo
    echo "Shared board, one sub-indexed section per group. Generated $(date '+%Y-%m-%d %H:%M')."
    echo "Work in your own group's section; claim before you work: \`./handoff claim <id>\`. Protocol: [README.md](./README.md)."
    echo
    while IFS= read -r g; do
      [ -n "$g" ] || continue
      echo "## $g"
      echo
      echo "Sub-index: [$(rel_link "$(sec_index "$g")")]($(rel_link "$(sec_index "$g")"))"
      echo
      echo "| Handoff | Status | Acts next | Severity | Updated | Lease |"
      echo "| --- | --- | --- | --- | --- | --- |"
      local glocks
      glocks="$(sec_dir "$g")/.locks"
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        local base
        base="$(basename "$f" .md)"
        is_standalone "$f" && continue
        is_orchestrator "$f" && continue
        local kind owner exp
        IFS='|' read -r kind owner exp <<< "$(lock_state "$base" "$glocks")"
        local lease="—"
        [ "$kind" = "held" ] && lease="🔒 $owner"
        [ "$kind" = "expired" ] && lease="⚠️ stale ($owner)"
        echo "| [$(meta "$f" title)]($(rel_link "$f")) | \`$(meta "$f" status)\` | $(meta "$f" audience) | $(meta "$f" severity) | $(meta "$f" updated) | $lease |"
      done < <(each_doc "$g")
      echo
    done < <(groups_for_rollup)
  } > "$out"
}

# Grow, prune, or just read a bundle's roster.
#
# Until this existed the only way to change `children:` was to hand-edit the frontmatter — a key
# `import --result` explicitly refuses to let an external result touch, and one `release --status
# done` told you to edit by hand in its own error text. A hand-edit also skipped children_csv, so a
# child written under a spelling that named no file reported MISSING for the bundle's whole life.
#
# `add`/`rm` are reserved in the first position; `handoff children <parent>` with no verb prints the
# same table the doc carries, without writing anything.
cmd_children() {
  local usage="usage: handoff children <parent> | handoff children add [--stub] <parent> <child> [child...] | handoff children rm <parent> <child> [child...]"
  local action="${1:?$usage}"
  local parent stub=0
  case "$action" in
    add | rm)
      shift
      # `--stub` FILES each named child as a real (empty, open) doc instead of leaving the roster
      # pointing at nothing. Declaring a roster before authoring its docs is legitimate planning —
      # the bug is never being told the gap exists, and then having no cheap way to close it. One
      # live board carries a bundle of 100 children of which 97 were never filed: it can never
      # close, and nothing ever said so.
      if [ "${1:-}" = "--stub" ]; then
        stub=1
        shift
      fi
      parent="${1:?usage: handoff children $action <parent> <child> [child...]}"
      shift
      [ "${1:-}" = "--stub" ] && {
        stub=1
        shift
      }
      [ $# -gt 0 ] || die "usage: handoff children $action <parent> <child> [child...]"
      [ "$stub" = 1 ] && [ "$action" = "rm" ] && die "--stub only applies to 'children add'"
      ;;
    *)
      parent="$action"
      action="show"
      shift
      [ $# -eq 0 ] || die "$usage"
      ;;
  esac

  local raw="$parent" f
  parent="$(resolve_id "$parent")" || die "unusable id: '$raw' (needs at least one letter or digit)"
  f="$(doc_of "$parent")" || no_such "$parent"
  is_orchestrator "$f" || die "$parent is not an orchestrator — only a bundle has children. Create one with: handoff new <id> --orchestrator --children a,b,c"
  [ "$action" = "show" ] || require_writable "$f" "$parent"

  if [ "$action" = "show" ]; then
    children_table "$f"
    return
  fi

  # The roster is re-read from the doc rather than taken from anything the caller holds: another
  # session may have added a child since, and a read-modify-write over a stale copy drops it.
  local cur want raw_want changed=0
  cur="$(children_of "$f")"
  for raw_want in "$@"; do
    want="$(resolve_id "$raw_want")" || die "unusable child id: '$raw_want' (needs at least one letter or digit)"
    [ "$want" = "$parent" ] && die "a bundle cannot be its own child"
    if [ "$action" = "add" ]; then
      # Filing the doc happens BEFORE the roster check, because the case `--stub` exists for is a
      # child that is ALREADY on the roster and was never filed — a bundle declaring 100 children
      # with 97 missing is the reason this flag exists, and every one of those is already listed.
      # Treating "already a child" as nothing to do would make --stub a no-op exactly when it is
      # needed.
      local have=0
      { [ -f "$(doc_file "$want")" ] || [ -f "$(arch_file "$want")" ]; } && have=1
      if [ "$have" = 0 ] && [ "$stub" = 1 ]; then
        # Filed through cmd_new so a stub is a real doc — same template, same frontmatter, same
        # lease gate — and not a second, thinner notion of "handoff" that later has to be
        # special-cased everywhere.
        if cmd_new "$want" --title "$want" ${GROUP:+--group "$GROUP"} \
          --note "stub filed by 'children add --stub' for $parent" > /dev/null 2>&1; then
          echo "  + filed stub $want"
          have=1
          changed=1
        else
          echo "  (could not file a stub for $want — file it by hand)"
        fi
      fi
      if grep -qxF "$want" <<< "$cur"; then
        [ "$have" = 1 ] || echo "= $want is already a child of $parent"
        continue
      fi
      # A child that does not exist yet is allowed, exactly as `new --children` allows it: bundles
      # are routinely planned before they are filed, and the table reports the gap as MISSING.
      [ "$have" = 1 ] \
        || echo "  (note: $want is not on the board yet — it will read MISSING until you file it, or re-run with --stub)"
      cur="${cur:+$cur$'\n'}$want"
      echo "+ $want"
    else
      grep -qxF "$want" <<< "$cur" || die "$want is not a child of $parent"
      # `|| true`: grep -v exits non-zero when it removes the only line, and an empty roster is a
      # legitimate result here (the bundle is being emptied, not failing).
      cur="$(printf '%s\n' "$cur" | grep -vxF "$want" || true)"
      echo "- $want"
    fi
    changed=$((changed + 1))
  done
  [ "$changed" -gt 0 ] || {
    echo "No change to $parent."
    return
  }

  local clist="" c
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    clist="${clist:+$clist, }$c"
  done <<< "$cur"
  set_field "$f" children "[$clist]"
  set_field "$f" updated "$(today)"
  log_activity "$f" "bundle roster updated by $(whoami_id) — now [${clist:-empty}]"
  cmd_index
  echo "Bundle $parent now covers ${clist:-no children}."
}

cmd_index() {
  # A board-level invocation on a grouped board (no HANDOFF_GROUP in scope) owns only the roll-up —
  # writing a section index would clobber $DIR/INDEX.md with a flat listing of nothing.
  if board_is_grouped && [ -z "$GROUP" ]; then
    rollup_index
    echo "Wrote $DIR/INDEX.md"
    return
  fi
  # Bundle children tables are generated board state too, and they read the same derivation the
  # sub-index does — so they are refreshed here, in the one pass every mutating command already
  # triggers, rather than from each of those commands.
  refresh_children_blocks
  write_section_index
  # A grouped board also gets a board-root roll-up across every section; a flat board's sub-index IS
  # the board root, so there is nothing extra to write.
  grouped && rollup_index
  echo "Wrote $(sec_index)"
}

cmd_show() { # <id> [--section NAME] [--path]
  # Find a doc by id, never by path (ADR 0012): a path goes stale when the doc is archived or moved
  # between boards, an id does not. Read-only and offline — no lease, no sync, no index, no
  # migration offer — so a hook can call it on any board. doc_of searches the caller's section,
  # active then archive, which is what makes it group-aware.
  local usage="usage: handoff show <id> [--section NAME] [--path]"
  local raw="" section="" want_path=0 id f
  while [ $# -gt 0 ]; do
    case "$1" in
      --section)
        require_value --section "$#" "${2:-}"
        section="$2"
        shift
        ;;
      --path) want_path=1 ;;
      --*) reject_unknown_flag "$1" ;;
      *)
        [ -z "$raw" ] || die "$usage"
        raw="$1"
        ;;
    esac
    shift
  done
  [ -n "$raw" ] || die "$usage"
  [ -n "$section" ] && [ "$want_path" = 1 ] && die "--section and --path are separate reads — pick one"
  id="$(resolve_id "$raw")" || die "unusable id: '$raw' (needs at least one letter or digit)"
  f="$(doc_of "$id")" || no_such "$id"
  warn_schema_forward "$f" # read forward (ADR 0003): a newer doc is shown, with one warning

  # --path output is for a caller to consume, so the banner goes to stderr and stdout stays one line.
  if [ "$want_path" = 1 ]; then
    if is_restricted "$f"; then restricted_banner "$id" >&2; fi
    printf '%s\n' "$f"
    return 0
  fi
  if is_restricted "$f"; then restricted_banner "$id"; fi
  if [ -n "$section" ]; then
    doc_section "$f" "$section" # an absent section prints nothing and still exits 0
  else
    cat "$f"
  fi
}

cmd_which() {
  # The one command that answers "why is this thing acting on THAT board with THAT binary". Both
  # halves are resolved independently and both can surprise you — a stale user-level CLI, an
  # exported HANDOFF_BOARD_PATH left over from another repo — so both print their source, not just
  # their path. Reads nothing and writes nothing; safe on a board you do not hold a lease on.
  local src="${HANDOFF_CLI_SOURCE:-}" path="${HANDOFF_CLI_PATH:-}"
  if [ -z "$src" ]; then
    # Not launched through a board dispatcher, so this file IS the CLI that answered.
    src="direct"
    path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  fi
  printf 'CLI      %s\n         (resolved from %s)\n' "$path" "$src"
  printf 'board    %s\n         (resolved from %s)\n' "$DIR" "${BOARD_SOURCE:-unknown}"
  if [ -n "${HANDOFF_GROUP:-$GROUP}" ]; then
    printf 'section  %s (%s layout)\n' "${HANDOFF_GROUP:-$GROUP}" "${LAYOUT:-flat}"
  fi
}

# Sourcing this file (the self-test does) must not execute a subcommand. Any other entry point is
# unaffected: HANDOFF_NO_MAIN is set by nothing but the self-test.
if [ -z "${HANDOFF_NO_MAIN:-}" ]; then
  case "${1:-list}" in
    list)
      # `shift || true` because `${1:-list}` above means this branch is also reached with NO
      # arguments at all, where a bare `shift` fails under a strict shell.
      shift || true
      cmd_list "$@" # --verbose restores an unbounded bundle roster
      ;;
    migrate)
      shift
      cmd_migrate "$@"
      ;;
    new)
      shift
      cmd_new "$@"
      ;;
    import)
      shift
      cmd_import "$@"
      ;;
    export)
      shift
      cmd_export "$@"
      ;;
    claim)
      shift
      cmd_claim "$@"
      ;;
    touch)
      shift
      cmd_touch "$@"
      ;;
    checkpoint)
      shift
      cmd_checkpoint "$@"
      ;;
    move)
      shift
      cmd_move "$@"
      ;;
    mirror)
      shift
      cmd_mirror "$@"
      ;;
    release)
      shift
      cmd_release "$@"
      ;;
    reap)
      shift
      cmd_reap "$@"
      ;;
    children)
      shift
      cmd_children "$@"
      ;;
    show)
      shift
      cmd_show "$@"
      ;;
    index) cmd_index ;;
    --which | which) cmd_which ;;
    locations)
      shift
      cmd_locations "$@"
      ;;
    *) die "usage: handoff [list | new <id> [--type coordination|standalone|--standalone] [--sensitivity normal|restricted] [opts] | import <file> [--id ID] [--title T] [--type ...] | export <id> [--to WHO] [--out DIR] [--branch NAME] [--no-claim] | show <id> [--section NAME] [--path] | claim <id> [note] | touch <id> | move <id> --to <board> [--to-remote host/owner] | mirror [--dry-run] | export <id> --to-issue | import --result --from-issue <id> | checkpoint <id> [\"current state\"] | release <id> --status open|blocked|done [--verified-by ...] [--blocked-on ...] [--run-verify] | children <parent> | children add [--stub]|rm <parent> <child> | migrate [--yes] [--dry-run] | reap [--force] | index | locations [--move] | --which]" ;;
  esac
fi
