#!/usr/bin/env python3
"""secret-scan -- answer whether content holds a credential. Never print the value.

The detection half of the engine; `redact-view` is the redaction half. Two verbs because they
answer different questions: the viewer is asked "show me this file, redacted", the scanner is
asked "may this be written, sent, or dispatched". Callers of the second do not want the
redacted text -- they want a yes/no and a reason they can put in a refusal.

    secret-scan FILE [FILE...]      # scan files
    ... | secret-scan -             # scan stdin
    secret-scan --quiet FILE        # exit code only

Exit codes, chosen so `if secret-scan ...; then refuse; fi` reads correctly in shell:

    0   a credential was detected      -> the caller should refuse
    1   clean
    2   usage error, or nothing readable

Findings go to stdout, one per line, as `RULE<TAB>WHERE`. The rule name is the whole point:
a refusal that echoes what it matched has put that credential into a terminal, a scrollback
and probably an agent transcript, which is the harm this exists to prevent. This file never
prints a matched value, and neither may anything built on it.
"""
import os
import sys


# The library sits beside this file in the payload, and one directory over once installed
# (bin/ next to scripts/). Resolve rather than hardcode, so the same file works in the skill,
# in a project-level install, and in the home layer of the cascade.
def _lib_dir():
    here = os.path.dirname(os.path.abspath(os.path.realpath(__file__)))
    for cand in (here, os.path.join(here, os.pardir, "scripts"),
                 os.environ.get("SECRET_GUARD_HOME", "")):
        if cand and os.path.isfile(os.path.join(cand, "secret_redact.py")):
            return os.path.abspath(cand)
    return here


sys.path.insert(0, _lib_dir())

from secret_redact import (  # noqa: E402
    MAX_BYTES,
    PEM_RE,
    is_secret_name,
    text_contains_secrets,
)


def classify(text, name):
    """Name the rule that fired, without quoting what it matched."""
    if name and is_secret_name(name):
        return "credential-path"
    if PEM_RE.search(text):
        return "private-key-block"
    return "credential-shaped-value"


def scan_text(text, where, name_hint):
    if not text_contains_secrets(text, name_hint):
        return None
    return "%s\t%s" % (classify(text, name_hint), where)


def main(argv):
    args = [a for a in argv[1:] if a != "--quiet"]
    quiet = "--quiet" in argv[1:]
    if not args:
        sys.stderr.write(__doc__.strip() + "\n")
        return 2

    findings = []
    readable = 0
    for path in args:
        if path == "-":
            text = sys.stdin.buffer.read(MAX_BYTES).decode("utf-8", "replace")
            readable += 1
            hit = scan_text(text, "<stdin>", "")
        else:
            # A credential-shaped NAME is a finding on its own -- the file need not be
            # readable, and refusing to open it is not a reason to report clean.
            if is_secret_name(path):
                findings.append("credential-path\t%s" % path)
                readable += 1
                continue
            try:
                with open(path, "rb") as fh:
                    text = fh.read(MAX_BYTES).decode("utf-8", "replace")
            except OSError as exc:
                sys.stderr.write("# cannot read %s: %s\n" % (path, exc))
                continue
            readable += 1
            hit = scan_text(text, path, path)
        if hit:
            findings.append(hit)

    if not readable:
        return 2
    if not findings:
        return 1
    if not quiet:
        sys.stdout.write("\n".join(findings) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
