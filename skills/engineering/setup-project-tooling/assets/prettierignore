# Prettier 3 reads .gitignore by default (--ignore-path defaults to [.gitignore,
# .prettierignore]), so anything git ignores is already skipped. The dependency and
# build entries below are kept as a safety net for repos whose .gitignore is thinner
# than this skill's base.

# dependencies + build output
node_modules
dist
build
coverage
.venv
__pycache__

# committed, but generated or must not be reformatted
package-lock.json
pnpm-lock.yaml
yarn.lock
CHANGELOG.md
.code-review-graphignore
# handoff board docs, if setup-handoff is installed. The `handoff` CLI owns their layout: it
# regenerates INDEX.md on every claim/release (reformatting it churns the file on every command), and
# prettier wraps a long `children:` roster onto several lines. `**` reaches archive/ and section
# subfolders, which a plain `*.md` misses.
.agents/handoff/**/*.md

